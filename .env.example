# ============================================================
# HIMS Application - Environment Variables Template
# Copy this file to .env and fill in real values.
# !! NEVER put real secrets in this file !!
# ============================================================

# ----- SonarQube -----
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=

# ----- JWT / Bearer Auth -----
JWT_SECRET=

# ----- Auto-Login -----
AUTO_LOG_SECRET=
ACCEPT_AUTO_LOGIN_KEY=

# ----- E-Invoice API -----
EINVOICE_CLIENT_ID=
EINVOICE_CLIENT_SECRET=

# ----- Email (Fallback) -----
MAIL_USER=
MAIL_PASSWORD=
