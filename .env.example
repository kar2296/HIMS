# ============================================================
# HIMS Application - Environment Variables Template
# Copy this file to .env and fill in real values.
# !! NEVER put real secrets in this file !!
# ============================================================

# ----- SonarQube -----
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=

# ----- JWT / Bearer Auth -----
JWT_SECRET=

# ----- AES Password Decryption -----
AES_PASSWORD_KEY=

# ----- Auto-Login -----
AUTO_LOG_SECRET=
ACCEPT_AUTO_LOGIN_KEY=

# ----- E-Invoice API -----
EINVOICE_CLIENT_ID=
EINVOICE_CLIENT_SECRET=

# ----- Email (Fallback) -----
MAIL_USER=
MAIL_PASSWORD=

# ----- WhatsApp Provider Tokens -----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_CAUVERY_TOKEN=
WHATSAPP_INFOBIP_TOKEN=
WHATSAPP_DHEE_API_SECRET=
WHATSAPP_DHEE_API_KEY=
WHATSAPP_JSS_USER=
WHATSAPP_JSS_PASS=

# ----- MomentPay POS -----
MOMENTPAY_MID=
MOMENTPAY_AUTH_USER=
MOMENTPAY_AUTH_KEY=
