# HIMS API Server — Environment Configuration Template
# Copy this file to .env and configure values for your environment.

NODE_ENV=development

# Application Config
APP_DEFAULT_PAGE_SIZE=50
CLIENT_CODE=SDH

# Web Server & UI Config
WEB_PORT=2012
WEB_UI_PATH=/../../../dist
WEB_UPLOAD_FILE_PATH=./attachments/uploads/
WEB_UPLOAD_EXTERNAL_FILE_PATH=./attachments/uploads/ERP/
WEB_Facility_Logo_UPLOAD_FILE_PATH=./attachments/FacilityLogo/
WEB_EXTERNAL_MRD_UPLOAD_FILE_PATH=./attachments/ExternalMRD/

# SSL Configuration (Leave empty if running behind reverse proxy or HTTP in local dev)
WEB_SSL_CERTIFICATE_PATH=
WEB_SSL_KEY_PATH=

# CORS Security (Comma-separated list of allowed origins, e.g. http://localhost:5173,http://192.168.31.221:2012)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.31.221:2012

# Database Connection
DATABASE_DIALECT=mysql
DATABASE_HOST_NAME=localhost
DATABASE_PORT=3306
DATABASE_NAME=hims_db
DATABASE_USER_NAME=root
DATABASE_PASSWORD=your_secure_password_here
DATABASE_TIME_ZONE=+05:30
DATABASE_LOGGING=1

# Redis Cache & Session Store
REDIS_HOST_NAME=localhost
REDIS_PORT=6379

# Session Security (30 minutes in milliseconds = 1800000)
SESSION_MAX_AGE=1800000
SESSION_SECRET=your_session_secret_key_here

# Telehealth & External Services (Optional)
BASE_URI=http://localhost:3000/
MEET_BASE_URI=https://meeting.accessworld.net/bigbluebutton/api/

# QZ Tray direct printing (Optional) - see api/src/Server/Modules/General/Router/QzPrintRoute.ts
# Without these, QZ Tray asks once per computer to allow the site.
# QZ_CERTIFICATE_PATH=secrets/qz/digital-certificate.txt
# QZ_PRIVATE_KEY_PATH=secrets/qz/private-key.pem
