"{{data.Localization.screenkey}}": {
    "pagetitle": {"lbl": "{{data.Title}}", "title": "{{data.Title}}"},
    "parentpagetitle": {"lbl": "{{data.ParentScreen.label}}", "title": "{{data.ParentScreen.label}}"},
{{#each data.Panels}}
    "pnl{{name}}": {"lbl": "{{display}}", "title": "{{display}}"},
    {{#each layouts}}
        {{#each controls}}
    "{{name}}": {"lbl": "{{label}}", "title": "{{label}}"},
        {{/each}}
    {{/each}}
{{/each}}
}
