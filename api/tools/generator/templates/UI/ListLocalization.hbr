"{{data.Localization.screenkey}}": {
    "pagetitle": {"lbl": "{{data.Title}}", "title": "{{data.Title}}"},
    "addnew-tooltip": {"lbl": "add new", "title": "add new"},
{{#each data.FilterConfig}}
{{#each controls}}
    "{{name}}": {"lbl": "{{label}}","title": "{{label}}"},
{{/each}}
{{/each}}
{{#each data.GridConfig}}
{{#each columnDefs}}
    "{{name}}": {"lbl": "{{displayName}}","title": "{{displayName}}"},
{{/each}}
{{/each}}
}
