<h4 class="page-header mt0" translate="{{data.Localization.localizationmodule}}.{{data.Localization.screenkey}}.pagetitle.lbl"></h4>

  <div class="row filter-area">
    <div class="col-sm-12">
        {{#each data.FilterConfig}}
        {{#each controls}}
        {{#if text}}
        <div class="col-sm-2">
            <label class="col-sm-4 control-label filter-lbl"  translate="{{../localizationpath}}.{{name}}.lbl"></label>
            <div class="col-sm-8">
                <input type="text" class="form-control" name="{{name}}" on-enter="getList()" ng-model="{{model}}" 
                            translate translate-attr-placeholder="{{../localizationpath}}.{{name}}.lbl">
            </div>
        </div>
        {{/if}}
        {{#if date}}
        <div class="col-sm-2">
            <label class="col-sm-4 control-label filter-lbl" translate="{{../localizationpath}}.{{name}}.lbl"></label>
            <div class="col-sm-8">
                <input type="text" class="form-control" name="{{name}}" ng-date-object 
                        uib-datepicker-popup="\{{datePickerOptions.dateFormat}}" 
                        placeholder="\{{datePickerOptions.placeholder}}" 
                        ng-click="{{name}}Popup = { opened: true }" 
                        is-open="{{name}}Popup.opened" ng-model="{{model}}" >
            </div>
        </div>
        {{/if}}
        {{#if checkbox}}
        <div class="col-sm-2">
            <label class="col-sm-4 control-label filter-lbl" translate="{{../localizationpath}}.{{name}}.lbl"></label>
            <div class="col-sm-8">
                <input type="checkbox" name="{{name}}" class="custom-checkbox"
                    ng-model="{{model}}">
            </div>
        </div>
        {{/if}}
        {{#if combo}}
        <div class="col-sm-2">
            <label class="col-sm-4 control-label filter-lbl" translate="{{../localizationpath}}.{{name}}.lbl"></label>
            <div class="col-sm-8">
                <ui-select ng-model="{{model}}" ng-change="getList()" class="filter-combo">
                    <ui-select-match>
                        \{{$select.selected.{{displayfield}} | limitTo : 8 : 0}}
                        <span ng-if="$select.selected.{{displayfield}}.length>8">...</span>
                    </ui-select-match>
                    <ui-select-choices repeat="lookupitem.{{valuefield}} as lookupitem in {{collection}} | filter: { {{displayfield}}: $select.search }">
                        <div ng-bind-html="lookupitem.{{displayfield}} | highlight: $select.search"></div>
                    </ui-select-choices>
                </ui-select>
            </div>
        </div>
        {{/if}}
        {{/each}}
        {{/each}}
        <div class="col-sm-2"></div>
        <div class="col-sm-2">
            <button class="btn btn-default btn-sm pull-right" ng-click="addNew()"
                        uib-tooltip="\{{ '{{data.Localization.localizationmodule}}.{{data.Localization.screenkey}}.addnew-tooltip.lbl' | translate }}" tooltip-placement="left">
                <i class="fa fa-plus" aria-hidden="true"></i>
            </button>
            <button class="btn btn-default btn-sm pull-right btn-filter">
                <i class="fa fa-filter" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</div>

<div class="container-fluid">    
    <div ui-grid="vm.gridConfig" class="table-uigrid" set-grid-height></div>
    <ul uib-pagination total-items="vm.gridConfig.pagerObj.totalItems" items-per-page="vm.gridConfig.pagerObj.pageSize" start-index="vm.gridConfig.pagerObj.startIndex"
                ng-model="vm.gridConfig.pagerObj.currentPage" ng-change="getList()"></ul>
</div>