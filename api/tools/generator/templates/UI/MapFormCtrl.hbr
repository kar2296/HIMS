(function() {
    'use strict';

    angular
        .module('app.pages')
        .controller('{{data.ControllerName}}Controller', {{data.ControllerName}}Controller);

function {{data.ControllerName}}Controller($scope, $stateParams, $state, $translate) {
    $scope.currentcontext =  {};
    $scope.currentcontext.id = parseInt($stateParams.id); 

    $scope.item = { };
    
    $scope.getItemCallback = function (scope, data, options, hasError) {
        $scope.item.map = data;
    };

    $scope.getItem = function (pageNo) {
	    if ( $scope.currentcontext.id && $scope.currentcontext.id > 0) {
            var inputData = {
                Params:[
                    { Key: 0 , Value:$scope.currentcontext.id }]
            };

            var options = {
                action: '{{data.FetchAction.url}}',
                data: inputData,
                type: 'post',
                onComplete: $scope.getItemCallback
            };
            $scope.$doAction(options);
        }
    };

    $scope.backToList = function () {
       $state.go('{{data.ParentScreen.state}}');
    }

    $scope.saveItemCallback = function (scope, data, options, hasError) {
        $scope.showSuccessMsg($translate.instant('common.successmsg.lbl'));
        $scope.backToList();
    };

    $scope.saveItem = function () {
        
        // if(!$scope.item_form.isValid()) {
        //    $scope.showErrorMsg($translate.instant('common.validationmsg.lbl'));
        //    return;
        // }
            
        var actionName = '{{data.MapAction.url}}';
    
        var options = {
            action: actionName,
            data: {Data : $scope.item.map },
            type: 'post',
            onComplete: $scope.saveItemCallback
        };
        $scope.$doAction(options);
    };

    {{#if data.InitAction}}
    $scope.lookupCallback = function (scope, data, options, hasError) {
        $scope.lookup = hasError ? {} : data;
        $scope.getItem();
    }
    
    $scope.initLookup = function () {
        var inputData = [
                            { "Key": "{{data.InitAction.maplookupkey}}" }
                        ];

        var options = {
            action: '{{data.InitAction.url}}',
            data: inputData,
            type: 'post',
            onComplete: $scope.lookupCallback
        };
        $scope.$doAction(options);
    }
    {{else}}
    $scope.initLookup = function () {
        $scope.lookup = {};
        $scope.getItem();
    }
    {{/if}}
    
    $scope.initLookup();
}

{{data.ControllerName}}Controller.$inject = ['$scope', '$stateParams', '$state', '$translate'];

})();