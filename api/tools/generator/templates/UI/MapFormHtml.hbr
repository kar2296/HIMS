<ul class="breadcrumb">
    <li><a ui-sref="{{data.ParentScreen.state}}" translate="{{data.Localization.localizationpath}}.parentpagetitle.lbl"></a></li>
    <li class="active" translate="{{data.Localization.localizationpath}}.pagetitle.lbl"></li>
</ul>	

<div class="row">
    <div class="col-sm-12">
        <form id="item_form" name="item_form" class="form-horizontal" role="form">	
            <div class="formRoot">
                <div class="panel panel-default">
                    <div class="panel-heading"><h3 class="panel-title" translate="{{data.Localization.localizationpath}}.pnl{{data.MapControl.panelname}}.lbl"></h3></div>
                    <div class="panel-body form-panel">	
                        <div class="col-sm-12">		
                            <!-- leftpanel -->	
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label" translate="{{data.Localization.localizationpath}}.{{data.MapControl.name}}.lbl"></label>
                                    <div class="col-sm-8">
                                         <ui-select multiple ng-model="item.map" class="ui-select-multiple"
                                            ng-map-control pivot-prop="{{data.MapControl.pivotprop}}" map-prop="{{data.MapControl.mapprop}}" 
                                            pivot-prop-val="\{{currentcontext.id}}">
                                            <ui-select-match>\{{$item.{{data.MapControl.displayfield}} }}</ui-select-match>
                                            <ui-select-choices repeat="lookupitem.{{data.MapControl.valuefield}} as lookupitem in {{data.MapControl.collection}} | filter: { {{data.MapControl.displayfield}}: $select.search }">
                                                <div ng-bind-html="lookupitem.{{data.MapControl.displayfield}} | highlight: $select.search"></div>
                                            </ui-select-choices>
                                        </ui-select>
                                    </div>
                                </div>
                            </div>

                            <!-- rightpanel -->
                            <div class="col-sm-6">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="panel-footer formactionbar">
                <div class="pull-right">
                    <button type="submit" class="btn btn-primary btn-sm" ng-click="saveItem()" translate="common.saveaction.lbl"></button>
                    <button id="btnCancelForm" type="button" class="btn btn-danger btn-sm" ng-click="backToList()" translate="common.cancelaction.lbl"></button>						
                </div>
            </div>
        </form>		
    </div>
</div>
