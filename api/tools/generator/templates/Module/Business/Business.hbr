    }

    public async Update{{data.Name}}(req: BaseRequest): Promise<boolean> {
        let result = await this.Update(req.Data);
        return result;
    }

    public async Get{{data.Name}}ById(req: BaseRequest): Promise<{{data.Name}}Attributes> {
        let result = await this.GetById(req.Id);
        return this.GetAttribute(result);
