        return await this.MarkAsDelete(req.Id);
    }

    public GetModel(): SStatic.Model<{{data.Name}}Instance, {{data.Name}}Attributes> {
        return this.Models.{{data.Name}};
    }

{{#if data.Options}}
    public async GetOptions(key: string, apiReq?: ApiRequest<ISearchEnums>): Promise<any> {
        apiReq.Attributes = apiReq.Attributes || ['Id'];
        let val = await this.Get{{data.Name}}s(apiReq);
        return { [key]: val.Data };
