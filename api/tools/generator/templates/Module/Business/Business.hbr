import { {{data.EntityName}}Filters } from '../Common/Filters.e';

export class {{data.Name}}Bo extends BaseBo<{{data.EntityName}}Instance, {{data.EntityName}}Attributes> {{#if data.Options}}implements IOptionProvider{{/if}} {
    public async Add{{data.Name}}(req: BaseRequest): Promise<number> {
        let result = await this.Save(req.Data);
