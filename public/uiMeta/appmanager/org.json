{
    "Title" : "Manage Org",
    "ControllerName" : "orgForm",
    "InitAction" : {
        "url" : "SystemSettingsorganization/GetOrgLookups",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "SystemSettingsorganization/GetOrganizationById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "SystemSettingsorganization/AddOrganization",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "SystemSettingsorganization/UpdateOrganization",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.orgs", "label" : "Orgs" },
    "Localization" : { "localizationmodule" : "appmanager", "screenkey" : "org" },
	"Panels" : 
    [
        {
            "name" : "organization",			
            "display" : "Organization",
            "localizationpath" : "appmanager.org",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Code", "name" : "code", "model" : "item.OrgCode", "placeholder" : "" },
                        { "text" : true, "label" : "Organization Name", "name" : "organizationname", "model" : "item.OrgName", "placeholder" : "" },
                        { "text" : true, "label" : "Address 1", "name" : "address1", "model" : "item.AddressLine1", "placeholder" : "" },
                        { "text" : true, "label" : "Address 2", "name" : "address2", "model" : "item.AddressLine2", "placeholder" : "" },
                        { "text" : true, "label" : "Pin Code", "name" : "pincode", "model" : "item.PinCode", "placeholder" : "" },
                        { "text" : true, "label" : "Area/Location", "name" : "arealocation", "model" : "item.Area", "placeholder" : "" },
                        { "text" : true, "label" : "City", "name" : "city", "model" : "item.City", "placeholder" : "" },
                        { "text" : true, "label" : "State", "name" : "state", "model" : "item.State", "placeholder" : "" },
                        { "text" : true, "label" : "Country", "name" : "country", "model" : "item.Country", "placeholder" : "" }                        
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "checkbox" : true, "label" : "Beds", "name" : "beds", "model" : "item.IsBeds", "placeholder" : "", "truevalue": 1, "falsevalue" : 0 },
                        { "checkbox" : true, "label" : "Doctors", "name" : "doctors", "model" : "item.IsDoctors", "placeholder" : "", "truevalue": 1, "falsevalue" : 0 },
                        { "checkbox" : true, "label" : "Facility", "name" : "facility", "model" : "item.IsFacility", "placeholder" : "", "truevalue": 1, "falsevalue" : 0 },
                        { "text" : true, "label" : "No of Doctors", "name" : "noofdoctors", "model" : "item.DoctorsCount", "placeholder" : "" },
                        { "text" : true, "label" : "No of Facility", "name" : "nooffacility", "model" : "item.FacilityCount", "placeholder" : "" },
                        { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.LicenseActiveFrom", "placeholder" : "" },
                        { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.LicenseActiveTo", "placeholder" : "" }
                    ] 
                }
            ]
        }
	]
}