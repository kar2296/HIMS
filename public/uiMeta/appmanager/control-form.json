{
    "Title" : "Control",
    "ControllerName" : "controlForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "SystemSettingsControl/GetControlById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "SystemSettingsControl/AddControl",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "SystemSettingsControl/UpdateControl",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.controls", "label" : "Controls" },
