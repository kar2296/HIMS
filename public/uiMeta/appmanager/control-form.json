                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Display", "name" : "display", "model" : "item.Display", "placeholder" : "", "validations":{"required" : true } },
                        { "combo" : true, "label" : "Parent Control", "name" : "parentcontrol", "model" : "item.ParentControlId", "placeholder" : "", "collection" : "lookup.ParentControl", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Type", "name" : "type", "model" : "item.ControlType", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Position", "name" : "position", "model" : "item.ControlPosition", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "SRef", "name" : "sref", "model" : "item.SRef", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "TranslateRef", "name" : "translateref", "model" : "item.TranslateRef", "placeholder" : "", "validations":{"required" : true } }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [] 
                }
            ]
        }
	]
}