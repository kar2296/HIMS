{
    "Title" : "Menu Setting",
    "ControllerName" : "moduleForm",
    "InitAction" : {
        "url" : "SystemSettingsmodule/GetModuleLookups",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "SystemSettingsmodule/GetModules",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "SystemSettingsmodule/AddModule",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "SystemSettingsmodule/UpdateModule",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "base.modules", "label" : "Menu Setting" },
    "Localization" : { "localizationmodule" : "i18n.appmanager", "screenkey" : "module" },
	"Panels" : 
    [
        {
            "name" : "uimodule",			
            "display" : "UIModule",
            "localizationpath" : "i18n.appmanager.module",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "UI Code", "name" : "uicode", "model" : "item.ModuleCode", "placeholder" : "" },
                        { "text" : true, "label" : "Module Name", "name" : "modulename", "model" : "item.ModuleName", "placeholder" : "" },
                        { "text" : true, "label" : "URL", "name" : "url", "model" : "item.URL", "placeholder" : "" },
                        { "text" : true, "label" : "Display Order", "name" : "displayorder", "model" : "item.DisplayOrder", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Enable", "name" : "isenabled", "model" : "item.IsEnabled", "placeholder" : "", "truevalue": 1, "falsevalue" : 0 }                                                
                    ]
                },
                { "name" : "rightpanel", "controls" :[] }
            ]
        }
	]
}