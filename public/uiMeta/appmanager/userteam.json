        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "SystemSettingsuserteam/GetUserTeamById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "SystemSettingsuserteam/AddUserTeam",
        "behaviour" : "default"
    },
    "UpdateAction" : {
