{
    "Title" : "Add / Edit Speciality",
    "ControllerName" : "specialityForm",
    "InitAction" : {
        "url" : "SystemSettingsspeciality/GetSpecialityLookups",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "SystemSettingsspeciality/GetSpecialitys",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "SystemSettingsspeciality/AddSpeciality",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "SystemSettingsspeciality/UpdateSpeciality",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "base.specialitys", "label" : "Specialitys" },
    "Localization" : { "localizationmodule" : "i18n.appmanager", "screenkey" : "speciality" },
	"Panels" : [
		{
            "name" : "general",			
            "display" : "General",
            "localizationpath" : "i18n.appmanager.speciality",
            "layouts" : [
                                { "name" : "leftpanel", "controls" :
                                        [
                                            {
                                                "text" : true,
                                                "label" : "Code",
                                                "name" : "code",
                                                "model" : "item.SpecialityCode",
                                                "placeholder" : ""
                                            },
                                            {
                                                "text" : true,
                                                "label" : "Name",
                                                "name" : "name",
                                                "model" : "item.SpecialityName",
                                                "placeholder" : ""
                                            },
                                            {
                                                "text" : true,
                                                "label" : "Description",
                                                "name" : "description",
                                                "model" : "item.Description",
                                                "placeholder" : ""
                                            },
                                            {
                                                "combo" : true,
                                                "label" : "Parent Speciality",
                                                "name" : "parentspeciality",
                                                "model" : "item.ParentSpecialityId",
                                                "placeholder" : "",
                                                "collection" : "lookup.speciality",
                                                "valuefield" : "Id",
                                                "displayfield" : "Text"
                                            },
                                            {
                                                "combo" : true,
                                                "label" : "Type",
                                                "name" : "type",
                                                "model" : "item.SpecialityTypeId",
                                                "placeholder" : "",
                                                "collection" : "lookup.speciality",
                                                "valuefield" : "Id",
                                                "displayfield" : "Text"
                                            },
                                            {
                                                "combo" : true,
                                                "label" : "Facility Name",
                                                "name" : "facilityname",
                                                "model" : "item.FacilityId",
                                                "placeholder" : "",
                                                "collection" : "lookup.speciality",
                                                "valuefield" : "Id",
                                                "displayfield" : "Text"
                                            },
                                            {
                                                "checkbox" : true,
                                                "label" : "Active",
                                                "name" : "active",
                                                "model" : "item.IsActive",
                                                "placeholder" : "",
                                                "truevalue": 1,
                                                "falsevalue" : 0
                                            }
                                        ]
                                },
                                { "name" : "rightpanel", "controls" :[] }
                            ]
                }			
	]
}