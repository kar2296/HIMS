{
    "Title" : "Menu Setting",
    "ControllerName" : "screenForm",
    "InitAction" : {
        "url" : "SystemSettingsscreen/GetScreenLookups",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "SystemSettingsscreen/GetScreens",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "SystemSettingsscreen/AddScreen",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "SystemSettingsscreen/UpdateScreen",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "base.modules", "label" : "Menu Setting" },
    "Localization" : { "localizationmodule" : "i18n.appmanager", "screenkey" : "screen" },
	"Panels" : 
    [
        {
            "name" : "uimodule",			
            "display" : "UIModule",
            "localizationpath" : "i18n.appmanager.screen",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Code", "name" : "code", "model" : "item.ScreenCode", "placeholder" : "" },
                        { "text" : true, "label" : "View Name", "name" : "viewname", "model" : "item.ScreenName", "placeholder" : "" },
                        { "text" : true, "label" : "Group Name", "name" : "groupname", "model" : "item.GroupName", "placeholder" : "" },
                        { "text" : true, "label" : "URL", "name" : "url", "model" : "item.URL", "placeholder" : "" },
                        { "text" : true, "label" : "Display Order", "name" : "displayorder", "model" : "item.DisplayOrder", "placeholder" : "" },
                        { "text" : true, "label" : "Parameter", "name" : "parameter", "model" : "item.Parameter", "placeholder" : "" },
                        { "text" : true, "label" : "Image Path", "name" : "imagepath", "model" : "item.ImagePath", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Enable", "name" : "isenabled", "model" : "item.IsEnabled", "placeholder" : "", "truevalue": 1, "falsevalue" : 0 }                                                
                    ]
                },
                { "name" : "rightpanel", "controls" :[] }
            ]
        }
	]
}