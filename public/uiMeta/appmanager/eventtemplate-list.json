{
    "Title" : "EventTemplates",
    "ControllerName" : "eventTemplateList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "ConditionType"}, { "name": "EventType"} ]
    },
    "FilterConfig" :[ {
        "localizationpath" : "appmanager.eventtemplate-list",
        "controls" :[
            { "combo" : true, "label" : "Facility", "name" : "filter_facility", "model" : "currentfilter.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
            { "combo" : true, "label" : "Event Type", "name" : "filter_eventtype", "model" : "currentfilter.EventTypeId", "placeholder" : "", "collection" : "lookup.EventType", "valuefield" : "Id", "displayfield" : "Text" }
         ]        
        }
    ],
    "FetchAction" : {
        "url" : "SystemSettingsEventTemplate/GetEventTemplates",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.eventtemplate",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.eventtemplate",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "SystemSettingsEventTemplate/DeleteEventTemplate",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "appmanager", "screenkey" : "eventtemplate-list" },
    "GridConfig" :[ {
        "localizationpath" : "appmanager.eventtemplate-list",
        "columnDefs": [ { "field": "Facility.FaciltyName", "displayName": "Facility", "name" : "facility" } ,
                        { "field": "EventType.Description", "displayName": "Event Type", "name" : "eventtype" },
                        { "field": "SmsTrigger", "displayName": "SMS Trigger", "name" : "controlposition" },
                        { "field": "ActiveStatus.Description", "displayName": "Status", "name" : "status" }
                    ]
        }
    ]
}