                        { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.ActiveTo", "placeholder" : "" },
                        { "combo" : true, "label" : "Language", "name" : "language", "model" : "item.LanguageId", "placeholder" : "", "collection" : "lookup.language", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Numeric Value", "name" : "numericvalue", "model" : "item.NumericValue", "placeholder" : "" }                        
