{
    "Title" : "Role Creation",
    "ControllerName" : "roleForm",
    "InitAction" : {
        "url" : "SystemSettingsrole/GetRoleLookups",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "SystemSettingsrole/GetRoles",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "SystemSettingsrole/AddRole",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "SystemSettingsrole/UpdateRole",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "base.roles", "label" : "Role" },
