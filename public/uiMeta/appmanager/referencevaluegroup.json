                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" },                        
                        { "checkbox" : true, "label" : "Sort by Description", "name" : "sortbydescription", "model" : "item.IsSortByDescription", "placeholder" : "", "truevalue": 1, "falsevalue" : 0 }
