{
    "Title" : "Group Creation",
    "ControllerName" : "groupForm",
    "InitAction" : {
        "url" : "SystemSettingsgroup/GetGroupLookups",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "SystemSettingsgroup/GetGroups",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "SystemSettingsgroup/AddGroup",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "SystemSettingsgroup/UpdateGroup",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "base.groups", "label" : "Group" },
    "Localization" : { "localizationmodule" : "i18n.appmanager", "screenkey" : "group" },
	"Panels" : 
    [
        {
            "name" : "general",			
            "display" : "General",
            "localizationpath" : "i18n.appmanager.group",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [                        
                        { "text" : true, "label" : "Group Name", "name" : "groupname", "model" : "item.GroupName", "placeholder" : "" },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Active", "name" : "active", "model" : "item.IsActive", "placeholder" : "", "truevalue": 1, "falsevalue" : 0 },
                        { "combo" : true, "label" : "Default General Context Widget", "name" : "generalcontext", "model" : "item.GeneralContext", "placeholder" : "", "collection" : "lookup.generalcontext", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Default Patient Context Widget", "name" : "patientcontext", "model" : "item.PatientContext", "placeholder" : "", "collection" : "lookup.patientcontext", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Default In Patient Context Widget", "name" : "inpatientcontext", "model" : "item.InPatientContext", "placeholder" : "", "collection" : "lookup.generaalcontext", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Default Emergency Context Widget", "name" : "emergencycontext", "model" : "item.EmergencyContext", "placeholder" : "", "collection" : "lookup.inpatientcontext", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Default Tablet Context Widget", "name" : "tabletcontext", "model" : "item.TabletContext", "placeholder" : "", "collection" : "lookup.emergencycontext", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Default Mobile Context Widget", "name" : "mobilecontext", "model" : "item.MobileContext", "placeholder" : "", "collection" : "lookup.mobilecontext", "valuefield" : "Id", "displayfield" : "Text" }                        
                    ]
                },
                { "name" : "rightpanel", "controls" :[] }
            ]
        }
	]
}