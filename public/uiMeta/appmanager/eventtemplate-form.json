{
    "Title" : "Event Template",
    "ControllerName" : "eventTemplateForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
         "optionkeys" : [ {"name" : "Facility"},{"name" : "EventType"}, {"name" : "User"}, {"name":"Group"}]
    },
    "FetchAction" : {
        "url" : "SystemSettingsEventTemplate/GetEventTemplateById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "SystemSettingsEventTemplate/AddEventTemplate",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "SystemSettingsEventTemplate/UpdateEventTemplate",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.eventtemplates", "label" : "Event Templates" },
    "Localization" : { "localizationmodule" : "appmanager", "screenkey" : "eventtemplate-form" },
	"Panels" : 
    [
        {
            "name" : "details",			
            "display" : "Details",
            "localizationpath" : "appmanager.eventtemplate-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Module Name", "name" : "modulename", "model" : "item.ModuleName", "placeholder" : "" },
                        { "combo" : true, "label" : "Facility", "name" : "facility", "model" : "item.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text", "validations":{"required" : true } },
                        { "combo" : true, "label" : "Event Type", "name" : "eventtype", "model" : "item.EventTypeId", "placeholder" : "", "collection" : "lookup.EventType", "valuefield" : "Id", "displayfield" : "Text", "validations":{"required" : true } },
                        { "text" : true, "label" : "SMS Trigger", "name" : "smstrigger", "model" : "item.SmsTrigger", "placeholder" : "" },
                        { "text" : true, "label" : "Template", "name" : "template", "model" : "item.TemplateContent", "placeholder" : "", "validations":{"required" : true }},
                        { "text" : true, "label" : "Sample Message", "name" : "samplemessage", "model" : "item.SampleMessage", "placeholder" : "", "validations":{"required" : true }}
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "text" : true, "label" : "Schedule Time", "name" : "scheduletime", "model" : "item.ScheduleTime", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Repeat", "name" : "isrepeat", "model" : "item.IsRepeat", "placeholder" : ""},
                        { "text" : true, "label" : "Repeat Duration", "name" : "repeatduration", "model" : "item.RepeatDuration", "placeholder" : "" },
                        { "combo" : true, "label" : "Sent to Whom", "name" : "senttowhom", "model" : "item.SentToPersonId", "placeholder" : "", "collection" : "lookup.User", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Sent to Group", "name" : "senttogroup", "model" : "item.SentToGroupId", "placeholder" : "", "collection" : "lookup.Group", "valuefield" : "Id", "displayfield" : "Text" },
                        { "checkbox" : true, "label" : "Is Active", "name" : "isactive", "model" : "item.IsActive", "placeholder" : ""}                        
                    ] 
                }
            ]
        }
	]
}