        "columnDefs": [ { "field": "ModuleCode", "displayName": "Code", "name" : "code" } ,
                        { "field": "ModuleName", "displayName": "Module Name", "name" : "modulename" },
                        { "field": "ClassType", "displayName": "Class Type", "name" : "classtype" },
                        { "field": "DisplayOrder", "displayName": "Display Order", "name" : "displayorder" },
                        { "field": "Status", "displayName": "Status", "name" : "status" },
                        { "field": "URL", "displayName": "URL", "name" : "url" },
                        { "field": "ViewName", "displayName": "View Name", "name" : "viewname" }
                    ]
        }
    ]
}