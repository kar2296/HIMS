{
    "Title" : "Menu Setting",
    "ControllerName" : "menuList",
    "InitAction" : {},
    "FetchAction" : {
        "url" : "SystemSettingsmodule/GetModules",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "base.module",
                "params": ["id:row.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "base.module",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "SystemSettingsmodule/DeleteModule",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "i18n.appmanager", "screenkey" : "modules" },
