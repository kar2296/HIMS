{
    "Title" : "Manage Department(s)",
    "ControllerName" : "deptForm",
    "InitAction" : {
        "url" : "SystemSettingsdepartment/GetDeptLookups",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "SystemSettingsdepartment/GetDepartments",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "SystemSettingsdepartment/AddDepartment",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "SystemSettingsdepartment/UpdateDepartment",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "base.depts", "label" : "Departments" },
    "Localization" : { "localizationmodule" : "i18n.appmanager", "screenkey" : "dept" },
	"Panels" : 
    [
        {
            "name" : "details",			
            "display" : "Details",
            "localizationpath" : "i18n.appmanager.dept",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Code", "name" : "code", "model" : "item.DepartmentCode", "placeholder" : "" },
                        { "text" : true, "label" : "Department Name", "name" : "departmentname", "model" : "item.DepartmentName", "placeholder" : "" },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" },
                        { "combo" : true, "label" : "Type", "name" : "type", "model" : "item.DepartmentTypeId", "placeholder" : "", "collection" : "lookup.department", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Speciality", "name" : "speciality", "model" : "item.SpecialityId", "placeholder" : "" },
                        { "text" : true, "label" : "Phone No", "name" : "phoneno", "model" : "item.PhoneNo", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Emergency", "name" : "isemergency", "model" : "item.IsEmergency", "placeholder" : "", "truevalue": 1, "falsevalue" : 0 },
                        { "checkbox" : true, "label" : "Is Admitting Dept.", "name" : "isadmittingdept", "model" : "item.IsAdmittingDept", "placeholder" : "", "truevalue": 1, "falsevalue" : 0 },
                        { "checkbox" : true, "label" : "Include MRD Req.", "name" : "includemrdreq", "model" : "item.IncludeMRDRequired", "placeholder" : "", "truevalue": 1, "falsevalue" : 0 },
                        { "checkbox" : true, "label" : "Patient Flow Mandatory", "name" : "patientflowmandatory", "model" : "item.IsPatientFlowMandatory", "placeholder" : "", "truevalue": 1, "falsevalue" : 0 },
                        { "checkbox" : true, "label" : "Is Processing Center", "name" : "isprocessingcenter", "model" : "item.IsProcessingCenter", "placeholder" : "", "truevalue": 1, "falsevalue" : 0 }                        
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "text" : true, "label" : "Cost Center", "name" : "costcenter", "model" : "item.CostCenterId", "placeholder" : "" },
                        { "text" : true, "label" : "URL", "name" : "url", "model" : "item.URL", "placeholder" : "" },
                        { "text" : true, "label" : "Threshold Duration", "name" : "thresholdduration", "model" : "item.ThresholdDuration", "placeholder" : "" },                        
                        { "text" : true, "label" : "Followup Days", "name" : "followupdays", "model" : "item.FollowupDays", "placeholder" : "" },
                        { "text" : true, "label" : "Night Start Time", "name" : "nightstarttime", "model" : "item.NightStartTime", "placeholder" : "" },
                        { "text" : true, "label" : "Night End Time", "name" : "nightendtime", "model" : "item.NightEndTime", "placeholder" : "" },
                        { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.ActiveFrom", "placeholder" : "" },
                        { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.ActiveTo", "placeholder" : "" }
                    ] 
                }
            ]
        }
	]
}