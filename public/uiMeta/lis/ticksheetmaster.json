{
    "Title" : "Manage Ticket Sheet Master(s)",
    "ControllerName" : "ticksheetmasterForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "lis/ticksheetmaster/GetTicksheetmasterById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "lis/ticksheetmaster/AddTicksheetmaster",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "lis/ticksheetmaster/UpdateTicksheetmaster",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.ticksheetmasters", "label" : "ticksheetmasters" },
    "Localization" : { "localizationmodule" : "lis", "screenkey" : "ticksheetmaster" },
	"Panels" : 
    [
        {
            "name" : "ticksheetmaster",			
            "display" : "ticksheetmaster",
            "localizationpath" : "lis.ticksheetmaster",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true,"label" : "Ticketsheet Type", "name" : "ticksheettypeid", "model" : "item.TicksheetTypeId","placeholder" : "", "collection" : "lookup.TICKSHEETTYP", "valuefield" : "Id", "displayfield" : "Text" },                        
                        { "combo" : true,"label" : "Department Name", "name" : "departmentid", "model" : "item.DepartmentId","placeholder" : "", "collection" : "lookup.DepartmentId", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true,"label" : "Sub Department Name", "name" : "subdepartmentid", "model" : "item.SubDepartmentId","placeholder" : "", "collection" : "lookup.SubDepartmentId", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true,"label" : "Test Name Test DID Profile", "name" : "testname", "model" : "item.TestmasterId","placeholder" : "", "collection" : "lookup.TestmasterId", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Test Name", "name" : "testname", "model" : "item.TestName", "placeholder" : "Test Name" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.ActiveFrom", "placeholder" : "" },
                        { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.ActiveTo", "placeholder" : "" }
                    ] 
                }
            ]
        }
	]
}