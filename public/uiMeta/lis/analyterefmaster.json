                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "text" : true, "label" : "Refvalue", "name" : "refvalue", "model" : "item.Refvalue", "placeholder" : "Refvalue" },
                        { "combo" : true,"label" : "Active state", "name" : "activestate_e", "model" : "item.Activestate_e","placeholder" : "", "collection" : "lookup.STATUS", "valuefield" : "Id", "displayfield" : "Text" },
                        { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.Activefrom", "placeholder" : "" },
                        { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.Activeto", "placeholder" : "" }
                    ] 
                }
