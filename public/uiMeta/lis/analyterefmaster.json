                        { "numeric" : true, "label" : "Age from", "name" : "agefrom", "model" : "item.Agefrom", "placeholder" : "0" },
                        { "numeric" : true, "label" : "Age to", "name" : "ageto", "model" : "item.Ageto", "placeholder" : "0" },
                        { "combo" : true,"label" : "Exclude from print", "name" : "excludefromprint", "model" : "item.Excludefromprint","placeholder" : "", "collection" : "lookup.EXCLUDFRMPRT", "valuefield" : "Id", "displayfield" : "Text" }
