{
    "Title" : "Manage External Provider(s)",
    "ControllerName" : "externalprovidersform",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "lis/externalproviders/GetExternalprovidersById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "lis/externalproviders/AddExternalproviders",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "lis/externalproviders/UpdateExternalproviders",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.externalproviderslist", "label" : "externalproviders" },
    "Localization" : { "localizationmodule" : "lis", "screenkey" : "externalprovider" },
	"Panels" : 
    [
        {
            "name" : "externalprovider",			
            "display" : "External Provider",
            "localizationpath" : "lis.externalprovider",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true,"label" : "Organization Name", "name" : "organizationId", "model" : "item.OrganizationId","placeholder" : "Organization Name", "collection" : "lookup.Organization", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true,"label" : "Facility Name", "name" : "facilityId", "model" : "item.FacilityId","placeholder" : "Facility Name", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true,"label" : "Test Name", "name" : "testname", "model" : "item.TestmasterId","placeholder" : "Type", "collection" : "lookup.TestMaster", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true,"label" : "External Providers", "name" : "externalprovidersid", "model" : "item.ExternalprovidersId","placeholder" : "", "collection" : "lookup.DepartmentId", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Alias Code", "name" : "aliascode", "model" : "item.AliasCode", "placeholder" : "Alias Code" },
                        { "text" : true, "label" : "Alias Name", "name" : "aliasname", "model" : "item.AliasName", "placeholder" : "Alias Name" },
                        { "text" : true, "label" : "UCP", "name" : "ucp", "model" : "item.UCP", "placeholder" : "UCP" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "date" : true, "label" : "Result Release Date", "name" : "resrelsdt", "model" : "item.ResultReleaseDate", "placeholder" : "" },                        
                        { "checkbox" : true, "label" : "Is Attachement Required", "name" : "isattachementrequired", "model" : "item.IsAttachementRequired", "placeholder" : "" },
                        { "text" : true, "label" : "Comments", "name" : "comments", "model" : "item.Comments", "placeholder" : "" },
                        { "text" : true, "label" : "OtherCost", "name" : "othercost", "model" : "item.OtherCost", "placeholder" : "" },
                        { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.Activefrom", "placeholder" : "" },
                        { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.Activeto", "placeholder" : "" }
                    ] 
                }
            ]
        }
	]
}    