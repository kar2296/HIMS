{
    "Title" : "Manage Session",
    "ControllerName" : "appointmentSessionForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "AppointmentSessionType"},{"name" : "Facility"}, {"name" : "Clinic"},{"name" : "Speciality"},
                        {"name" : "Doctor"},{"name" : "AppointmentSlotType"}]
    },
    "FetchAction" : {
        "url" : "appointment/AppointmentSession/GetAppointmentSessionById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "appointment/AppointmentSession/AddAppointmentSession",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "appointment/AppointmentSession/UpdateAppointmentSession",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.appointmentsessions", "label" : "Appointment Sessions" },
    "Localization" : { "localizationmodule" : "appointment", "screenkey" : "appointmentsession-form" },
	"Panels" : 
    [
        {
            "name" : "appointmentsession",			
            "display" : "Manage Session",
            "localizationpath" : "appointment.appointmentsession-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Facility", "name" : "facility", "model" : "item.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Type", "name" : "appointmentsessiontype", "model" : "item.AppointmentSessionTypeId", "placeholder" : "", "collection" : "lookup.AppointmentSessionType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Clinics/Schedule", "name" : "clinics", "model" : "item.ClinicId", "placeholder" : "", "collection" : "lookup.Clinic", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Speciality", "name" : "speciality", "model" : "item.SpecialityId", "placeholder" : "", "collection" : "lookup.Speciality", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Doctor", "name" : "doctor", "model" : "item.DoctorId", "placeholder" : "", "collection" : "lookup.Doctor", "valuefield" : "Id", "displayfield" : "Text" },
                        { "checkbox" : true, "label" : "Is Order Mandatory", "name" : "isordermandatory", "model" : "item.IsOrderMandatory", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Allow Force Booking", "name" : "allowforcebooking", "model" : "item.IsAllowForceBooking", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "date" : true, "label" : "Start Date", "name" : "startdate", "model" : "item.StartDate", "placeholder" : "" },
                        { "date" : true, "label" : "End Date", "name" : "enddate", "model" : "item.EndDate", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Monday", "name" : "monday", "model" : "item.IsMonday", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Tuesday", "name" : "tuesday", "model" : "item.IsTuesday", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Wednesday", "name" : "wednesday", "model" : "item.IsWednesday", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Thursday", "name" : "thursday", "model" : "item.IsThursday", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Friday", "name" : "friday", "model" : "item.IsFriday", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Saturday", "name" : "saturday", "model" : "item.IsSaturday", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Sunday", "name" : "sunday", "model" : "item.IsSunday", "placeholder" : "" },
                        { "checkbox" : true, "label" : "All", "name" : "all", "model" : "item.IsAll", "placeholder" : "" },
                        { "combo" : true, "label" : "Slot Type", "name" : "slottype", "model" : "item.AppointmentSlotTypeId", "placeholder" : "", "collection" : "lookup.AppointmentSlotType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Duration", "name" : "duration", "model" : "item.SlotDuration", "placeholder" : "" } ,                       
                        { "time" : true, "label" : "Start Time", "name" : "starttime", "model" : "item.StartTime", "placeholder" : "" },
                        { "time" : true, "label" : "End Time", "name" : "endtime", "model" : "item.EndTime", "placeholder" : "" },
                        { "time" : true, "label" : "Break From", "name" : "breakfrom", "model" : "item.BreakFrom", "placeholder" : "" },
                        { "time" : true, "label" : "Break To", "name" : "breakto", "model" : "item.BreakTo", "placeholder" : "" },
                        { "text" : true, "label" : "Max. Slot Per Day", "name" : "maxslotperday", "model" : "item.MaxSlotPerDay", "placeholder" : "" },                       
                        { "date" : true, "label" : "Holiday From", "name" : "holidayfrom", "model" : "item.HolidayFrom", "placeholder" : "" },
                        { "date" : true, "label" : "Holiday To", "name" : "holidayto", "model" : "item.HolidayTo", "placeholder" : "" }

                    ] 
                }
            ]
        }
	]
}