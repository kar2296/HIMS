{
    "Title" : "Manage Appointments",
    "ControllerName" : "appointmentForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "AppointmentType"},{"name" : "AppointmentStatus"}, {"name" : "AppointmentCategory"},{"name" : "Patient"},
                        {"name" : "Facility"},{"name" : "Department"},{"name" : "Doctor"},{"name" : "Resource"},{"name" : "Referral"},
                        {"name" : "Priority"},{"name" : "Remark"},{"name" : "VisitType"},{"name" : "Gender"},{"name" : "Title"}]
    },
    "FetchAction" : {
        "url" : "appointment/Appointment/GetAppointmentById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "appointment/Appointment/AddAppointment",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "appointment/Appointment/UpdateAppointment",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.appointments", "label" : "Appointments" },
    "Localization" : { "localizationmodule" : "appointment", "screenkey" : "appointment-form" },
	"Panels" : 
    [
        {
            "name" : "patientinfo",			
            "display" : "Patient Information",
            "localizationpath" : "appointment.appointment-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Category", "name" : "category", "model" : "item.AppointmentCategoryId", "placeholder" : "", "collection" : "lookup.AppointmentCategory", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Search Patient", "name" : "patient", "model" : "item.PatientId", "placeholder" : "", "collection" : "lookup.Patient", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "MRN", "name" : "mrn", "model" : "selectedPatient.MRN", "placeholder" : "" },
                        { "text" : true, "label" : "Mobile No", "name" : "patientmobileno", "model" : "selectedPatient.Mobile", "placeholder" : "" },
                        { "text" : true, "label" : "Gurantor", "name" : "gurantor", "model" : "selectedPatient.Gurantor", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Title", "name" : "patienttitle", "model" : "selectedPatient.TitleId", "placeholder" : "", "collection" : "lookup.Title", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Name", "name" : "patientname", "model" : "selectedPatient.FirstName", "placeholder" : "" },
                        { "combo" : true, "label" : "Gender", "name" : "patientgender", "model" : "selectedPatient.GenderId", "placeholder" : "", "collection" : "lookup.Gender", "valuefield" : "Id", "displayfield" : "Text" },
                        { "date" : true, "label" : "DOB", "name" : "patientdob", "model" : "selectedPatient.DOB", "placeholder" : "" },
                        { "text" : true, "label" : "Age", "name" : "patientage", "model" : "selectedPatient.Age", "placeholder" : "" }
                    ] 
                }
            ]
        },
        {
            "name" : "appointmentinfo",			
            "display" : "Appointment Information",
            "localizationpath" : "appointment.appointment-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Type", "name" : "appointmenttype", "model" : "item.AppointmentTypeId", "placeholder" : "", "collection" : "lookup.AppointmentType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Status", "name" : "appointmentstatus", "model" : "item.AppointmentStatusId", "placeholder" : "", "collection" : "lookup.AppointmentStatus", "valuefield" : "Id", "displayfield" : "Text" },
                        { "date" : true, "label" : "Date", "name" : "appointmentdate", "model" : "item.AppointmentDate", "placeholder" : "" },
                        { "combo" : true, "label" : "Facility", "name" : "facility", "model" : "item.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Department", "name" : "department", "model" : "item.DepartmentId", "placeholder" : "", "collection" : "lookup.Department", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Consultant", "name" : "consultant", "model" : "item.DoctorId", "placeholder" : "", "collection" : "lookup.Doctor", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Resource", "name" : "resource", "model" : "item.ResourceId", "placeholder" : "", "collection" : "lookup.Resource", "valuefield" : "Id", "displayfield" : "Text" },
                        { "checkbox" : true, "label" : "Force Booking", "name" : "forcebooking", "model" : "item.IsForceBooking", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "time" : true, "label" : "Start Time", "name" : "starttime", "model" : "item.StartTime", "placeholder" : "" },
                        { "time" : true, "label" : "End Time", "name" : "endtime", "model" : "item.EndTime", "placeholder" : "" },
                        { "combo" : true, "label" : "Referral", "name" : "referral", "model" : "item.ReferralId", "placeholder" : "", "collection" : "lookup.Referral", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Priority", "name" : "priority", "model" : "item.PriorityId", "placeholder" : "", "collection" : "lookup.Priority", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Visit Type", "name" : "visittype", "model" : "item.VisitTypeId", "placeholder" : "", "collection" : "lookup.VisitType", "valuefield" : "Id", "displayfield" : "Text" }
                    ] 
                }
            ]
        },
        {
            "name" : "appointmentdetails",			
            "display" : "Appointment Details",
            "localizationpath" : "appointment.appointment-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Remarks", "name" : "remarks", "model" : "item.RemarkId", "placeholder" : "", "collection" : "lookup.Remark", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Comments", "name" : "comments", "model" : "item.Comments", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" :[]
                }
            ]
        }
	]
}