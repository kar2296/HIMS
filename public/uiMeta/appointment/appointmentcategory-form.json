{
    "Title" : "Appointment Category Form",
    "ControllerName" : "appointmentCategoryForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "appointment/AppointmentCategory/GetAppointmentCategoryById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "appointment/AppointmentCategory/AddAppointmentCategory",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "appointment/AppointmentCategory/UpdateAppointmentCategory",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.appointmentcategories", "label" : "Appointment Categories" },
    "Localization" : { "localizationmodule" : "appointment", "screenkey" : "appointmentcategory-form" },
	"Panels" : 
    [
        {
            "name" : "appointmentcategory",			
            "display" : "Appointment Category",
            "localizationpath" : "appointment.appointmentcategory-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Facility", "name" : "facility", "model" : "item.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Type", "name" : "appointmentcategorytype", "model" : "item.AppointmentCategoryTypeId", "placeholder" : "", "collection" : "lookup.AppointmentCategoryType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Name", "name" : "name", "model" : "item.Name", "placeholder" : "" },
                        { "colorpicker" : true, "label" : "Color", "name" : "color", "model" : "item.Color", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Active", "name" : "isactive", "model" : "item.IsActive", "placeholder" : "" },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" }                        
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [] 
                }
            ]
        }
	]
}