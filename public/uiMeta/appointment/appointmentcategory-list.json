{
    "Title" : "Appointment Category List",
    "ControllerName" : "appointmentCategoryList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FilterConfig" :[ {
        "localizationpath" : "appointment.appointmentcategory-list",
        "controls" :[
               { "combo" : true, "label" : "Facility", "name" : "filter_facility", "model" : "currentfilter.FacilityId", "placeholder" : "", "collection" : "lookup.FacilityId", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Type", "name" : "filter_appointmentcategorytype", "model" : "currentfilter.AppointmentCategoryTypeId", "placeholder" : "", "collection" : "lookup.AppointmentCategoryTypeId", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Status", "name" : "filter_status", "model" : "currentfilter.StatusId", "placeholder" : "", "collection" : "lookup.Status", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
        "url" : "appointment/AppointmentCategory/GetAppointmentCategorys",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.appointmentcategory",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.appointmentcategory",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "appointment/AppointmentCategory/DeleteAppointmentCategory",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "appointment", "screenkey" : "appointmentcategory-list" },
    "GridConfig" :[ {
        "localizationpath" : "appointment.appointmentcategory-list",
        "columnDefs": [ { "field": "Name", "displayName": "Name", "name" : "name" } ,
                        { "field": "Color", "displayName": "Color", "name" : "color" } ,
                        { "field": "AppointmentCategoryType.Description", "displayName": "Type", "name" : "appointmentcategorytype" },
                        { "field": "StatusTODO", "displayName": "Status", "name" : "status" },
                        { "field": "Description", "displayName": "Description", "name" : "description" },
                        { "field": "Facility", "displayName": "Facility", "name" : "facility" }
                        
                    ]
        }
    ]
}