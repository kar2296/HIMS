{
    "Title" : "Appointments",
    "ControllerName" : "appointmentList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "Facility"},{"name" : "Department"},{"name" : "AppointmentType"},
                            {"name" : "Doctor"}, {"name" : "Resource"},{"name" : "AppointmentStatus"} ]
    },
    "FilterConfig" :[ {
        "localizationpath" : "appointment.appointment-list",
        "controls" :[
               { "combo" : true, "label" : "Facility", "name" : "filter_facility", "model" : "currentfilter.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Department", "name" : "filter_department", "model" : "currentfilter.DepartmentId", "placeholder" : "", "collection" : "lookup.Department", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Type", "name" : "filter_type", "model" : "currentfilter.AppointmentTypeId", "placeholder" : "", "collection" : "lookup.AppointmentType", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Doctor", "name" : "filter_doctor", "model" : "currentfilter.DoctorId", "placeholder" : "", "collection" : "lookup.Doctor", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Resource", "name" : "filter_resource", "model" : "currentfilter.ResourceId", "placeholder" : "", "collection" : "lookup.Resource", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Status", "name" : "filter_appointmentstatus", "model" : "currentfilter.AppointmentStatusId", "placeholder" : "", "collection" : "lookup.AppointmentStatus", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
        "url" : "appointment/Appointment/GetAppointments",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.appointmenttab.details",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.appointmenttab.details",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "appointment/Appointment/DeleteAppointment",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "appointment", "screenkey" : "appointment-list" },
    "GridConfig" :[ {
        "localizationpath" : "appointment.appointment-list",
        "columnDefs": [ { "field": "AppointmentDate", "displayName": "Appointment Time", "name" : "appointmenttime" } ,
                        { "field": "Patient.FirstName", "displayName": "Patient Name", "name" : "patientname" },
                        { "field": "AppointmentCategory.Name", "displayName": "Category", "name" : "category" },
                        { "field": "User.FirstName", "displayName": "Doctor/Resource", "name" : "doctor" },
                        { "field": "Remark.Remarks", "displayName": "Reason", "name" : "reason" },
                        { "field": "AppointmentStatus.Description", "displayName": "Status", "name" : "status" }
                    ]
        }
    ]
}