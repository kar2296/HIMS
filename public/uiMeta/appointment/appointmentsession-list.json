{
    "Title" : "Appointment Sessions",
    "ControllerName" : "appointmentSessionList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "AppointmentSessionType"},{"name" : "Facility"} ]
    },
    "FilterConfig" :[ {
        "localizationpath" : "appointment.appointmentsession-list",
        "controls" :[
               { "combo" : true, "label" : "Facility", "name" : "filter_facility", "model" : "currentfilter.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Type", "name" : "filter_appointmentsessiontype", "model" : "currentfilter.AppointmentSessionTypeId", "placeholder" : "", "collection" : "lookup.AppointmentSessionType", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Status", "name" : "filter_status", "model" : "currentfilter.StatusId", "placeholder" : "", "collection" : "lookup.Status", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
        "url" : "appointment/AppointmentSession/GetAppointmentSessions",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.appointmentsession",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.appointmentsession",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "appointment/AppointmentSession/DeleteAppointmentSession",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "appointment", "screenkey" : "appointmentsession-list" },
    "GridConfig" :[ {
        "localizationpath" : "appointment.appointmentsession-list",
        "columnDefs": [ { "field": "Facility.FacilityName", "displayName": "Facility Name", "name" : "facilityname" } ,
                        { "field": "AppointmentSessionType.Description", "displayName": "Session Type", "name" : "appointmentsessiontype" },
                        { "field": "User.FirstName", "displayName": "Doctor", "name" : "doctor" },
                        { "field": "StatusTODO", "displayName": "Status", "name" : "status" }
                    ]
        }
    ]
}