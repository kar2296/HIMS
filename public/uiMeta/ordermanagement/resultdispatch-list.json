{
    "Title" : "Lab Result Dispatch List",
    "ControllerName" : "dispatchResultList",
    "InitAction" : {
    },
    "FetchAction" : {
        "url" : "lis/patientworkorder/GetPatientWorkorders",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "ordermanagement", "screenkey" : "resultdispatch-list" },
    "GridConfig" :[ {
