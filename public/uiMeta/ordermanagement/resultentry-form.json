{
    "Title" : "Result Entry",
    "ControllerName" : "resultEntryForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [{"name" : "User"} ]
    },
    "FetchAction" : {
        "url" : "lis/patientworkorder/GetPatientWorkorder",
        "behaviour" : "default"
    },
    "AddAction" : {},
    "UpdateAction" : {},
    "ParentScreen" : { "state" : "app.orderprocesstab.processmyorders", "label" : "Order Process" },
    "Localization" : { "localizationmodule" : "ordermanagement", "screenkey" : "resultentry-form" },
	"Panels" : 
    [
        {
            "name" : "resultentry",			
            "display" : "Result Entry",
            "localizationpath" : "ordermanagement.resultentry-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Order #", "name" : "orderno", "model" : "item.PatientOrder.OrderNumber", "placeholder" : "" },
                        { "text" : true, "label" : "Ordered By", "name" : "orderedby", "model" : "item.PatientOrder.User.Description", "placeholder" : "" },
                        { "text" : true, "label" : "Reference #", "name" : "referenceno", "model" : "item.DepartmentrefNo", "placeholder" : "" },
                        { "text" : true, "label" : "Department", "name" : "department", "model" : "item.Department.Description", "placeholder" : "" },
                        { "combo" : true, "label" : "Tech Validation By", "name" : "techvalidationby", "model" : "item.TechValidationById", "placeholder" : "", "collection" : "lookup.User", "valuefield" : "Id", "displayfield" : "Text" },
                        { "date" : true, "label" : "Ordered On", "name" : "orderedon", "model" : "item.Ordereddate", "placeholder" : "" },
                        { "date" : true, "label" : "Specimen Received On", "name" : "specimenreceivedon", "model" : "item.Ordereddate", "placeholder" : "" },
                        { "date" : true, "label" : "Tech Validation On", "name" : "techvalidationon", "model" : "item.TechValidationdate", "placeholder" : "" },
                        { "date" : true, "label" : "Approved On", "name" : "approvedon", "model" : "item.ApprovalSubmisdate", "placeholder" : "" },
                        { "combo" : true, "label" : "Approved By", "name" : "approvedby", "model" : "item.Approvedbyid", "placeholder" : "", "collection" : "lookup.User", "valuefield" : "Id", "displayfield" : "Text" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [  ]
                }
            ]
        }
	]
}
