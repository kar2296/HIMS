               { "text" : true, "label" : "Patient", "name" : "filter_patient", "model" : "currentfilter.PatientMRN", "placeholder" : "" },               
               { "combo" : true, "label" : "Priority", "name" : "filter_priority", "model" : "currentfilter.OrderPriorityId", "placeholder" : "", "collection" : "lookup.PriorityStatus", "valuefield" : "Id", "displayfield" : "Text" },
               { "date" : true, "label" : "From Date", "name" : "filter_fromdate", "model" : "currentfilter.OrderRequestDate", "placeholder" : "" },
               { "combo" : true, "label" : "Status", "name" : "filter_status", "model" : "currentfilter.OrderStatusId", "placeholder" : "", "collection" : "lookup.OrderStatus", "valuefield" : "Id", "displayfield" : "Text" }
            ]
