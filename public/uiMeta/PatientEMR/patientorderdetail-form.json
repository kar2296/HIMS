{
    "Title" : "More Info",
    "ControllerName" : "patientOrderDetailForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "OrderPriority"}, {"name" : "Speciman"}, {"name" : "Diagnosis"}, {"name" : "BodySite"},
                         {"name" : "Guarantor"}, {"name" : "OrderStatus"}]
    },
    "FetchAction" : {
        "url" : "",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.patientorder", "label" : "Patient Order" },
    "Localization" : { "localizationmodule" : "patientemr", "screenkey" : "patientorderdetail-form" },
	"Panels" : 
    [
        {
            "name" : "details",			
            "display" : "Details",
            "localizationpath" : "patientemr.patientorderdetail-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Test Name", "name" : "testname", "model" : "item.TestName", "placeholder" : ""},
                        { "date" : true, "label" : "Request Date", "name" : "requestdate", "model" : "item.RequestDate", "placeholder" : "" },
                        { "combo" : true, "label" : "Priority", "name" : "priority", "model" : "item.OrderPriorityId", "placeholder" : "", "collection" : "lookup.OrderPriority", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Speciman", "name" : "speciman", "model" : "item.SpecimanId", "placeholder" : "", "collection" : "lookup.Speciman", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Body Site", "name" : "bodysite", "model" : "item.BodySiteId", "placeholder" : "", "collection" : "lookup.BodySite", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Guarantor", "name" : "guarantor", "model" : "item.GuarantorId", "placeholder" : "", "collection" : "lookup.Guarantor", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Unit Price", "name" : "unitprice", "model" : "item.TestPrice", "placeholder" : "" },
                        { "text" : true, "label" : "Comments", "name" : "comments", "model" : "item.Comments", "placeholder" : ""}
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                         { "date" : true, "label" : "Result Estimated Date", "name" : "resultestimateddate", "model" : "item.ResultEstimatedDate", "placeholder" : "" },
                         { "date" : true, "label" : "Schedule Date", "name" : "scheduledate", "model" : "item.ScheduleDate", "placeholder" : "" },
                         { "checkbox" : true, "label" : "Use Previous Sample", "name" : "useprevioussample", "model" : "item.IsUsePreviousSample", "placeholder" : "" },
                         { "combo" : true, "label" : "Diagnosis", "name" : "diagnosis", "model" : "item.DiagnosisId", "placeholder" : "", "collection" : "lookup.Diagnosis", "valuefield" : "Id", "displayfield" : "Text" },
                         { "text" : true, "label" : "Quantity", "name" : "quantity", "model" : "item.Quantity", "placeholder" : ""},
                         { "combo" : true, "label" : "Status", "name" : "status", "model" : "item.OrderStatusId", "placeholder" : "", "collection" : "lookup.OrderStatus", "valuefield" : "Id", "displayfield" : "Text" }
                    ] 
                }
            ]
        }
	]
}