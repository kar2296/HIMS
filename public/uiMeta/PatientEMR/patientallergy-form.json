{
    "Title" : "Manage Allergies",
    "ControllerName" : "patientallergyForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "patientemr/patientallergy/GetPatientAllergyById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "patientemr/patientallergy/AddPatientAllergy",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "patientemr/patientallergy/UpdatePatientAllergy",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "patientemr.patientallergies", "label" : "Allergies" },
    "Localization" : { "localizationmodule" : "patientemr", "screenkey" : "patientallergy-form" },
	"Panels" : 
    [
        {
            "name" : "patientallergy",			
            "display" : "Manage Allergies",
            "localizationpath" : "patientemr.patientallergy-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Allergy", "name" : "allergy", "model" : "item.AllergyId", "placeholder" : "", "collection" : "lookup.Allergy", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Type", "name" : "type", "model" : "item.AllergyTypeId", "placeholder" : "", "collection" : "lookup.AllergyType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Name", "name" : "allergyname", "model" : "item.AllergyName", "placeholder" : "" },
                        { "date" : true, "label" : "StartDate", "name" : "startdate", "model" : "item.StartDate", "placeholder" : "" },
                        { "date" : true, "label" : "EndDate", "name" : "enddate", "model" : "item.EndDate", "placeholder" : "" },
                        { "text" : true, "label" : "Source", "name" : "source", "model" : "item.AllergySource", "placeholder" : "" },
                        { "text" : true, "label" : "Comments", "name" : "comments", "model" : "item.Comments", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" : 
                    [
                        { "text" : true, "label" : "Symptom", "name" : "symptom", "model" : "item.Symptom", "placeholder" : "" },
                        { "text" : true, "label" : "ADR Status", "name" : "adrstatus", "model" : "item.ADRStatus", "placeholder" : "" },
                        { "combo" : true, "label" : "ADR Score", "name" : "adrscore", "model" : "item.ADRScoreId", "placeholder" : "", "collection" : "lookup.ADRScore", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Severity", "name" : "severity", "model" : "item.AllergySeverityId", "placeholder" : "", "collection" : "lookup.AllergySeverity", "valuefield" : "Id", "displayfield" : "Text" },
                        { "checkbox" : true, "label" : "Status", "name" : "status", "model" : "item.Status", "placeholder" : "" }
                    ] 
                }
            ]
        }
	]
}