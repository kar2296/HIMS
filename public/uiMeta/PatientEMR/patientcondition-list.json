{
    "Title" : "Condition",
    "ControllerName" : "patientConditionList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "ConditionType"} ]
    },
    "FilterConfig" :[ {
        "localizationpath" : "patientemr.patientcondition-list",
        "controls" :[
               { "combo" : true, "label" : "Type", "name" : "filter_conditiontype", "model" : "currentfilter.ConditionTypeId", "placeholder" : "", "collection" : "lookup.ConditionType", "valuefield" : "Id", "displayfield" : "Text" },
               { "text" : true, "label" : "Name", "name" : "conditionname", "model" : "item.ConditionName", "placeholder" : "" }
            ]
        }
    ],
    "FetchAction" : {
        "url" : "patientemr/patientcondition/GetPatientConditions",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "patientemr.patientcondition",
                "params": ["id:row.entity.Id", "pid: $scope.currentcontext.pid"]
                },
    "AddAction" : {
        "url": "",
        "state": "patientemr.patientcondition",
        "params": ["id:0", "pid: $scope.currentcontext.pid"]
        },
    "DeleteAction" : {
        "url": "patientemr/patientcondition/DeletePatientCondition",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "patientemr", "screenkey" : "patientcondition-list" },
    "GridConfig" :[ {
        "localizationpath" : "patientemr.patientcondition-list",
        "columnDefs": [ { "field": "ConditionType.Description", "displayName": "Type", "name" : "conditiontype" } ,
                        { "field": "DiagnosisName", "displayName": "Name", "name" : "diagnosisname" } , 
                        { "field": "ConditionStatus.Description", "displayName": "Status", "name" : "conditionstatus" },
                        { "field": "ConditionDate", "displayName": "Condition Date", "name" : "conditiondate" }
                    ]
        }
    ]
}