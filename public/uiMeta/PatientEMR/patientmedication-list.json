{
    "Title" : "Medications",
    "ControllerName" : "patientMedicationList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FilterConfig" :[ {
        "localizationpath" : "patientemr.patientmedication-list",
        "controls" :[
               { "combo" : true, "label" : "Drug", "name" : "filter_drug", "model" : "currentfilter.DrugId", "placeholder" : "", "collection" : "lookup.Drug", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
