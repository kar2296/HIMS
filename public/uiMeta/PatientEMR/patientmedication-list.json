                        { "field": "DrugFrequency.Description", "displayName": "Frequency", "name" : "frequency" },
                        { "field": "StartDate", "displayName": "Start Date", "name" : "startdate" },                        
                        { "field": "EndDate", "displayName": "End Date", "name" : "enddate" },
                        { "field": "StatusTODO", "displayName": "Status", "name" : "status" }
                    ]
