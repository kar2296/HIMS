{
    "Title" : "Manage Documents",
    "ControllerName" : "patientDocumentForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "DocumentType"}, {"name" : "ReleaseToPatient"} ]
    },
    "FetchAction" : {
        "url" : "patientemr/patientdocument/GetPatientDocumentById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "patientemr/patientdocument/AddPatientDocument",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "patientemr/patientdocument/UpdatePatientDocument",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "patientemr.patientdocuments", "label" : "Documents" },
    "Localization" : { "localizationmodule" : "patientemr", "screenkey" : "patientdocument-form" },
	"Panels" : 
    [
        {
            "name" : "patientdocument",			
            "display" : "Manage Documents",
            "localizationpath" : "patientemr.patientdocument-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "date" : true, "label" : "Date", "name" : "createddate", "model" : "item.CreatedDate", "placeholder" : "" },
                        { "combo" : true, "label" : "Type", "name" : "documenttype", "model" : "item.DocumentTypeId", "placeholder" : "", "collection" : "lookup.DocumentType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Document", "name" : "document", "model" : "item.Document", "placeholder" : "" },
                        { "text" : true, "label" : "Release To Patient", "name" : "releasetopatient", "model" : "item.ReleaseToPatient", "placeholder" : "" },                                                
                        { "text" : true, "label" : "Comments", "name" : "comments", "model" : "item.Comments", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" : [] }
            ]
        }
	]
}