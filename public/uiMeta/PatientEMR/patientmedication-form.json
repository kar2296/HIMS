{
    "Title" : "Manage Medication",
    "ControllerName" : "patientMedicationForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "patientemr/patientmedication/GetPatientMedicationById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "patientemr/patientmedication/AddPatientMedication",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "patientemr/patientmedication/UpdatePatientMedication",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "patientemr.patientmedications", "label" : "Medications" },
    "Localization" : { "localizationmodule" : "patientemr", "screenkey" : "patientmedication-form" },
	"Panels" : 
    [
        {
            "name" : "patientmedication",			
            "display" : "Manage Medication",
            "localizationpath" : "patientemr.patientmedication-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Drug", "name" : "drug", "model" : "item.DrugId", "placeholder" : "", "collection" : "lookup.Drug", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Dosage", "name" : "dosage", "model" : "item.Dosage", "placeholder" : "" },
                        { "combo" : true, "label" : "Route", "name" : "route", "model" : "item.DrugRouteId", "placeholder" : "", "collection" : "lookup.DrugRoute", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Frequency", "name" : "frequency", "model" : "item.DrugFrequencyId", "placeholder" : "", "collection" : "lookup.DrugFrequency", "valuefield" : "Id", "displayfield" : "Text" },                        
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" },                        
                        { "date" : true, "label" : "Start Date", "name" : "startdate", "model" : "item.StartDate", "placeholder" : "" },
                        { "date" : true, "label" : "End Date", "name" : "enddate", "model" : "item.EndDate", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Generic", "name" : "generic", "model" : "item.IsGeneric", "placeholder" : "" },                        
                        { "text" : true, "label" : "Comments", "name" : "comments", "model" : "item.Comments", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" : [] }
            ]
        }
	]
}