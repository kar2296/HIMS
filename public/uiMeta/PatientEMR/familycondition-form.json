{
    "Title" : "Manage Family Condition",
    "ControllerName" : "familyConditionForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "Diagnosis"}, {"name" : "ConditionType"}, {"name" : "ConditionStatus"} ]
    },
    "FetchAction" : {
        "url" : "patientemr/familycondition/GetFamilyConditionById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "patientemr/familycondition/AddFamilyCondition",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "patientemr/familycondition/UpdateFamilyCondition",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "patientemr.familyconditions", "label" : "Family Condition" },
    "Localization" : { "localizationmodule" : "patientemr", "screenkey" : "familycondition-form" },
	"Panels" : 
    [
        {
            "name" : "familycondition",			
            "display" : "Manage Family Condition",
            "localizationpath" : "patientemr.familycondition-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Type", "name" : "conditiontype", "model" : "item.ConditionTypeId", "placeholder" : "", "collection" : "lookup.ConditionType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Condition", "name" : "condition", "model" : "item.DiagnosisId", "placeholder" : "", "collection" : "lookup.Diagnosis", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Code", "name" : "code", "model" : "item.Code", "placeholder" : "" },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" },
                        { "combo" : true, "label" : "Relationship", "name" : "relationship", "model" : "item.RelationshipId", "placeholder" : "", "collection" : "lookup.Relationship", "valuefield" : "Id", "displayfield" : "Text" },
                        { "date" : true, "label" : "Date", "name" : "conditiondate", "model" : "item.ConditionDate", "placeholder" : "" },
                        { "combo" : true, "label" : "Status", "name" : "conditionstatus", "model" : "item.ConditionStatusId", "placeholder" : "", "collection" : "lookup.ConditionStatus", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Comments", "name" : "comments", "model" : "item.Comments", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [  ]
                }
            ]
        }
	]
}
