{
    "Title" : "Patient Orders",
    "ControllerName" : "patientOrderForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "Doctor"}, {"name" : "OrderPriority"},{"name" : "Department"}, {"name":"OrderStatus"} ]
    },
    "FetchAction" : {
        "url" : "patientemr/patientorders/GetPatientOrderById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "patientemr/patientorders/AddPatientOrders",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "patientemr/patientorders/UpdatePatientOrders",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "patientemr.patientorders", "label" : "Patient Orders" },
    "Localization" : { "localizationmodule" : "patientemr", "screenkey" : "patientorder-form" },
	"Panels" : 
    [
        {
            "name" : "patientorder",			
            "display" : "Patient Orders",
            "localizationpath" : "patientemr.patientorder-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Ordered By", "name" : "orderedby", "model" : "item.OrderedById", "placeholder" : "", "collection" : "lookup.Doctor", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Priority", "name" : "priority", "model" : "item.PriorityId", "placeholder" : "", "collection" : "lookup.OrderPriority", "valuefield" : "Id", "displayfield" : "Text" },
                        { "date" : true, "label" : "Order Date & Time", "name" : "orderdateandtime", "model" : "item.OrderRequestDate", "placeholder" : "" },
                        { "date" : true, "label" : "Schedule Date & Time", "name" : "scheduledateandtime", "model" : "item.OrderScheduleDate", "placeholder" : "" },
                        { "combo" : true, "label" : "Order From", "name" : "orderfrom", "model" : "item.OrderFromId", "placeholder" : "", "collection" : "lookup.Department", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Order To", "name" : "orderto", "model" : "item.OrderToId", "placeholder" : "", "collection" : "lookup.Department", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Status", "name" : "status", "model" : "item.StatusId", "placeholder" : "", "collection" : "lookup.OrderStatus", "valuefield" : "Id", "displayfield" : "Text" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [  ]
                }
            ]
        }
	]
}
