{
    "Title" : "Annotations",
    "ControllerName" : "patientAnnotationList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FilterConfig" :[ {
        "localizationpath" : "patientemr.patientannotation-list",
        "controls" :[
               { "combo" : true, "label" : "Type", "name" : "filter_annotationtype", "model" : "currentfilter.AnnotationTypeId", "placeholder" : "", "collection" : "lookup.AnnotationType", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Clinician", "name" : "filter_clinician", "model" : "currentfilter.PerformedBy", "placeholder" : "", "collection" : "lookup.AnnotationStatus", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Status", "name" : "filter_status", "model" : "currentfilter.AnnotationStatusId", "placeholder" : "", "collection" : "lookup.AnnotationStatus", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
        "url" : "patientemr/patientannotation/GetPatientAnnotations",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "patientemr.patientannotation",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "patientemr.patientannotation",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "patientemr/patientannotation/DeletePatientAnnotation",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "patientemr", "screenkey" : "patientannotation-list" },
    "GridConfig" :[ {
        "localizationpath" : "patientemr.patientannotation-list",
        "columnDefs": [ 
                        { "field": "PerformedDate", "displayName": "Date", "name" : "date" },
                        { "field": "AnnotationType.Description", "displayName": "Type", "name" : "type" },
                        { "field": "PerformedBy", "displayName": "Captured By", "name" : "capturedby" },
                        { "field": "AnnotationStatus.Description", "displayName": "Status", "name" : "status" },
                        { "field": "IsPHR", "displayName": "PHR", "name" : "phr" }
                    ]
        }
    ]
}