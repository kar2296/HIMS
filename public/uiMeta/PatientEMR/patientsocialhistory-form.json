{
    "Title" : "Manage Social History",
    "ControllerName" : "patientSocialHistoryForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "patientemr/patientsocialhistory/GetPatientSocialHistoryById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "patientemr/patientsocialhistory/AddPatientSocialHistory",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "patientemr/patientsocialhistory/UpdatePatientSocialHistory",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "patientemr.patientsocialhistorys", "label" : "Social History" },
    "Localization" : { "localizationmodule" : "patientemr", "screenkey" : "patientsocialhistory-form" },
	"Panels" : 
    [
        {
            "name" : "patientsocialhistory",			
            "display" : "Manage Social History",
            "localizationpath" : "patientemr.patientsocialhistory-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Social Type", "name" : "socialtype", "model" : "item.SocialTypeId", "placeholder" : "", "collection" : "lookup.SocialType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Frequency", "name" : "frequency", "model" : "item.SocialFrequencyId", "placeholder" : "", "collection" : "lookup.SocialFrequency", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Severity", "name" : "severity", "model" : "item.SocialSeverity", "placeholder" : "" },                        
                        { "date" : true, "label" : "Review Date", "name" : "reviewdate", "model" : "item.ReviewDate", "placeholder" : "" },                        
                        { "text" : true, "label" : "Comments", "name" : "comments", "model" : "item.Comments", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" : [] }
            ]
        }
	]
}