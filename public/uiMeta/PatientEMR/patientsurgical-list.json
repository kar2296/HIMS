               { "combo" : true, "label" : "Type", "name" : "filter_proceduretype", "model" : "currentfilter.ProcedureTypeId", "placeholder" : "", "collection" : "lookup.ProcedureType", "valuefield" : "Id", "displayfield" : "Text" }
