{
    "Title" : "Intake & Outputs",
    "ControllerName" : "patientIntakeOutputList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "patientemr/patientintakeoutput/GetPatientIntakeOutputs",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "patientemr.patientintakeoutput",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "patientemr.patientintakeoutput",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "patientemr/patientintakeoutput/DeletePatientIntakeOutput",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "patientemr", "screenkey" : "patientintakeoutput-list" },
    "GridConfig" :[ {
        "localizationpath" : "patientemr.patientintakeoutput-list",
        "columnDefs": [ 
                        { "field": "IntakeOutputTime", "displayName": "Date & Time", "name" : "datetime" },
                        { "field": "IntakeOutputTypeId.Description", "displayName": "Type", "name" : "type" },
                        { "field": "IntakeTypeId.Description", "displayName": "Intake Description", "name" : "intaketype" },
                        { "field": "IntakeVolume", "displayName": "Intake Volume", "name" : "intakevolume" },
                        { "field": "OutputTypeId.Description", "displayName": "Output Description", "name" : "outputtype" },
                        { "field": "OutputVolume", "displayName": "Output Volume", "name" : "outputvolume" },
                        { "field": "UpdatedBy", "displayName": "Updated By", "name" : "updatedby" },
                        { "field": "Comments", "displayName": "Comments", "name" : "comments" },
                        { "field": "StatusTODO", "displayName": "Status", "name" : "status" }
                    ]
        }
    ]
}