{
    "Title" : "Manage Vitals",
    "ControllerName" : "patientVitalForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "patientemr/patientvital/GetPatientVitalById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "patientemr/patientvital/AddPatientVital",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "patientemr/patientvital/UpdatePatientVital",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "patientemr.patientvitals", "label" : "Vitals" },
    "Localization" : { "localizationmodule" : "patientemr", "screenkey" : "patientvital-form" },
	"Panels" : 
    [
        {
            "name" : "patientvital",			
            "display" : "Manage Vitals",
            "localizationpath" : "patientemr.patientvital-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Vital Name", "name" : "vitalname", "model" : "item.VitalId", "placeholder" : "", "collection" : "lookup.Vital", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Vital Value", "name" : "vitalvalue", "model" : "item.VitalValue", "placeholder" : "" },
                        { "text" : true, "label" : "UOM", "name" : "uom", "model" : "item.UOM", "placeholder" : "" },                                                
                        { "date" : true, "label" : "Capture Date", "name" : "capturedate", "model" : "item.PerformedDate", "placeholder" : "" },
                        { "combo" : true, "label" : "Captured by", "name" : "capturedby", "model" : "item.PerformedBy", "placeholder" : "", "collection" : "lookup.User", "valuefield" : "Id", "displayfield" : "Text" },                                                
                        { "text" : true, "label" : "Comments", "name" : "comments", "model" : "item.Comments", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" : [] }
            ]
        }
	]
}