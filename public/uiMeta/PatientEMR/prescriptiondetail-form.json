{
    "Title" : "Manage Prescription",
    "ControllerName" : "prescriptionDetailForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "patientemr/prescriptiondetail/GetPrescriptionDetailById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "patientemr/prescriptiondetail/AddPrescriptionDetail",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "patientemr/prescriptiondetail/UpdatePrescriptionDetail",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "patientemr.prescriptions", "label" : "Prescriptions" },
    "Localization" : { "localizationmodule" : "patientemr", "screenkey" : "full_prescription-form" },
	"Panels" : 
    [
        {
            "name" : "",			
            "display" : "",
            "localizationpath" : "patientemr.full_prescription-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Rx Name", "name" : "rxname", "model" : "item.DisplayId", "placeholder" : "", "validations":{"required" : true } },
                        { "checkbox" : true, "label" : "Is Generic", "name" : "generic", "model" : "item.IsGeneric", "placeholder" : "" },
                        { "text" : true, "label" : "Molecular Name", "name" : "molecularname", "model" : "item.DisplayId", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Dosage", "name" : "dosage", "model" : "item.AllergyName", "placeholder" : "", "validations":{"required" : true } },
                        { "combo" : true, "label" : "Frequency", "name" : "frequency", "model" : "item.AllergyTypeId", "placeholder" : "", "collection" : "lookup.AllergyType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Quantity", "name" : "quantity", "model" : "item.DisplayId", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Admin Instructions", "name" : "admininstruction", "model" : "item.DisplayId", "placeholder" : "", "validations":{"required" : true } },
                        { "combo" : true, "label" : "Pharmacy", "name" : "pharmacy", "model" : "item.AllergyEventTypeId", "placeholder" : "", "collection" : "lookup.EventType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Start Date", "name" : "startdate", "model" : "item.ReferrenceLink", "placeholder" : "" },
                        { "text" : true, "label" : "Diagnosis", "name" : "diagnosis", "model" : "item.Description", "placeholder" : "" },
                        { "text" : true, "label" : "Price", "name" : "price", "model" : "item.Description", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Special Approval", "name" : "generic", "model" : "item.IsGeneric", "placeholder" : "" },
                        { "text" : true, "label" : "Comments", "name" : "comments", "model" : "item.Description", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "text" : true, "label" : "Alias Name", "name" : "aliasname", "model" : "item.DisplayId", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Form/Strength", "name" : "form_strength", "model" : "item.AllergyName", "placeholder" : "", "validations":{"required" : true } },
                        { "combo" : true, "label" : "Route", "name" : "route", "model" : "item.AllergyTypeId", "placeholder" : "", "collection" : "lookup.AllergyType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Duration", "name" : "duration", "model" : "item.DisplayId", "placeholder" : "", "validations":{"required" : true } },
                        { "combo" : true, "label" : "Duration", "name" : "duration_cmb", "model" : "item.AllergyEventTypeId", "placeholder" : "", "collection" : "lookup.EventType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "No Of Refills", "name" : "no_of_refills", "model" : "item.ReferrenceLink", "placeholder" : "" },
                        { "combo" : true, "label" : "Priority", "name" : "priority", "model" : "item.AllergyEventTypeId", "placeholder" : "", "collection" : "lookup.EventType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Guarantor Name", "name" : "guarantorname", "model" : "item.AllergyEventTypeId", "placeholder" : "", "collection" : "lookup.EventType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "End Date", "name" : "enddate", "model" : "item.Description", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Substitution Allowed", "name" : "substitutionallowed", "model" : "item.IsGeneric", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Tapering Order", "name" : "taperingorder", "model" : "item.IsGeneric", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Refuse to Buy", "name" : "refusetobuy", "model" : "item.RefusetoBuyId", "placeholder" : "" }
                    ] 
                }
            ]
        }
	]
}