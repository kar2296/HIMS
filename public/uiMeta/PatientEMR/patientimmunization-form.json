{
    "Title" : "Manage Immunizations",
    "ControllerName" : "patientImmunizationForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "Immunization"}, {"name" : "ImmunizationType"}, {"name" : "ImmunizationStatus"},{"name" : "AdministrationType"},{"name" : "AdministeredBy"} ]
    },
    "FetchAction" : {
        "url" : "patientemr/patientimmunization/GetPatientImmunizationById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "patientemr/patientimmunization/AddPatientImmunization",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "patientemr/patientimmunization/UpdatePatientImmunization",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "patientemr.patientimmunizations", "label" : "Immunization" },
    "Localization" : { "localizationmodule" : "patientemr", "screenkey" : "patientimmunization-form" },
	"Panels" : 
    [
        {
            "name" : "vaccinedetails",			
            "display" : "Vaccine details",
            "localizationpath" : "patientemr.patientimmunization-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Immunization", "name" : "immunization", "model" : "item.ImmunizationId", "placeholder" : "", "collection" : "lookup.Immunization", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Immunization Type", "name" : "immunizationtype", "model" : "item.ImmunizationTypeId", "placeholder" : "", "collection" : "lookup.ImmunizationType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "CVX Code", "name" : "cvxcode", "model" : "item.CVXCode", "placeholder" : "" },
                        { "text" : true, "label" : "Age From", "name" : "agefrom", "model" : "item.AgeFrom", "placeholder" : "" },
                        { "text" : true, "label" : "Total DosageCount", "name" : "totaldosagecount", "model" : "item.TotalDosageCount", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "text" : true, "label" : "Immunization Name", "name" : "immunizationname", "model" : "item.ImmunizationName", "placeholder" : "" },
                        { "text" : true, "label" : "Age UOM", "name" : "uom", "model" : "item.UOM", "placeholder" : "" },
                        { "text" : true, "label" : "Age To", "name" : "ageto", "model" : "item.AgeTo", "placeholder" : "" },
                        { "combo" : true, "label" : "Status", "name" : "immunizationstatus", "model" : "item.ImmunizationStatusId", "placeholder" : "", "collection" : "lookup.ImmunizationStatus", "valuefield" : "Id", "displayfield" : "Text" }
                    ]
                }
            ]
        },
        {
            "name" : "administration",			
            "display" : "Administration",
            "localizationpath" : "patientemr.patientimmunization-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Type", "name" : "administrationtype", "model" : "item.AdministrationTypeId", "placeholder" : "", "collection" : "lookup.AdministrationType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Site/Route", "name" : "siteorroute", "model" : "item.SiteOrRoute", "placeholder" : "" },
                        { "text" : true, "label" : "Location", "name" : "location", "model" : "item.Location", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Administrated By", "name" : "administratedby", "model" : "item.AdministeredById", "placeholder" : "", "collection" : "lookup.AdministeredBy", "valuefield" : "Id", "displayfield" : "Text" },
                        { "date" : true, "label" : "Date", "name" : "performeddate", "model" : "item.PerformedDate", "placeholder" : "" }
                    ]
                }
            ]
        },
        {
            "name" : "manufacturerdetails",			
            "display" : "Manufacturer Details",
            "localizationpath" : "patientemr.patientimmunization-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Manufacturer", "name" : "manufacturer", "model" : "item.Manufacturer", "placeholder" : "" },
                        { "date" : true, "label" : "Expiry Date", "name" : "expirydate", "model" : "item.ExpiryDate", "placeholder" : "" },
                        { "text" : true, "label" : "Note", "name" : "comments", "model" : "item.Comments", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "text" : true, "label" : "Lot Number", "name" : "lotnumber", "model" : "item.LotNumber", "placeholder" : "" }
                    ]
                }
