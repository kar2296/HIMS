{
    "Title" : "Manage Intake & Output",
    "ControllerName" : "patientIntakeOutoutForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "patientemr/patientintakeoutput/GetPatientIntakeOutputById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "patientemr/patientintakeoutput/AddPatientIntakeOutput",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "patientemr/patientintakeoutput/UpdatePatientIntakeOutput",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "patientemr.patientintakeoutputs", "label" : "Intake & Output" },
