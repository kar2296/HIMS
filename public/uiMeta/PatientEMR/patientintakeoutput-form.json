	"Panels" : 
    [
        {
            "name" : "patientintakeoutput",			
            "display" : "Manage Intake & Output",
            "localizationpath" : "patientemr.patientintakeoutput-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "date" : true, "label" : "Date & Time", "name" : "intakeoutputdate", "model" : "item.IntakeOutputTime", "placeholder" : "" },
                        { "combo" : true, "label" : "Type", "name" : "type", "model" : "item.IntakeOutputTypeId", "placeholder" : "", "collection" : "lookup.IntakeOutputType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Intake Description", "name" : "intaketype", "model" : "item.IntakeTypeId", "placeholder" : "", "collection" : "lookup.IntakeType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Intake Volume", "name" : "intakevolume", "model" : "item.IntakeVolume", "placeholder" : "" },
                        { "text" : true, "label" : "Output Description", "name" : "outputtype", "model" : "item.OutputTypeId", "placeholder" : "" },
                        { "text" : true, "label" : "Output Volume", "name" : "outputvolume", "model" : "item.OutputVolume", "placeholder" : "" },
                        { "text" : true, "label" : "Signatory", "name" : "signatory", "model" : "item.Signatory", "placeholder" : "" },
                        { "combo" : true, "label" : "Captured By", "name" : "capturedby", "model" : "item.CapturedBy", "placeholder" : "", "collection" : "lookup.User", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Comments", "name" : "comments", "model" : "item.Comments", "placeholder" : "" }
                    ]
                },
                {  }
            ]
        }
	]
