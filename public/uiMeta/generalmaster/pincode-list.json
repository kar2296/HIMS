{
    "Title" : "Pincode Mapping",
    "ControllerName" : "pincodeList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FilterConfig" :[ {
        "localizationpath" : "generalmaster.pincode-list",
        "controls" :[
               { "combo" : true, "label" : "Country", "name" : "filter_country", "model" : "currentfilter.CountryId", "placeholder" : "", "collection" : "lookup.Country", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "State", "name" : "filter_state", "model" : "currentfilter.StateId", "placeholder" : "", "collection" : "lookup.State", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "City", "name" : "filter_city", "model" : "currentfilter.CityName", "placeholder" : "", "collection" : "lookup.City", "valuefield" : "Id", "displayfield" : "Text" },
               { "text" : true, "label" : "Pincode", "name" : "filter_pincode", "model" : "currentfilter.Pincode", "placeholder" : "" },
               { "combo" : true, "label" : "Status", "name" : "filter_status", "model" : "currentfilter.StatusId", "placeholder" : "", "collection" : "lookup.Status", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
        "url" : "generalmaster/PincodeMaster/GetPincodeMasters",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.pincode",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.pincode",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "generalmaster/PincodeMaster/DeletePincodeMaster",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "generalmaster", "screenkey" : "pincode-list" },
    "GridConfig" :[ {
        "localizationpath" : "generalmaster.pincode-list",
        "columnDefs": [ { "field": "Pincode", "displayName": "Pincode", "name" : "pincode" } ,
                        { "field": "Area", "displayName": "Area", "name" : "area" },
                        { "field": "City.DistrictName", "displayName": "City", "name" : "city" },
                        { "field": "DistrictMaster.DistrictName", "displayName": "District", "name" : "district" },
                        { "field": "StateMaster.StateName", "displayName": "State", "name" : "state" },
                        { "field": "CountryMaster.CountryName", "displayName": "Country", "name" : "country" },                                        
                        { "field": "StatusTODO", "displayName": "Status", "name" : "status" }
                    ]
        }
    ]
}