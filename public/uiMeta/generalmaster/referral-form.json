{
    "Title" : "Referral Form",
    "ControllerName" : "referralForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "generalmaster/referral/GetReferralById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "generalmaster/referral/AddReferral",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "generalmaster/referral/UpdateReferral",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.referral", "label" : "Referral" },
    "Localization" : { "localizationmodule" : "generalmaster", "screenkey" : "referral-form" },
	"Panels" : 
    [
        {
            "name" : "referral",			
            "display" : "Referral",
            "localizationpath" : "generalmaster.referral-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Facility", "name" : "facility", "model" : "item.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Referral Type", "name" : "referraltype", "model" : "item.ReferralTypeId", "placeholder" : "", "collection" : "lookup.ReferralType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Code", "name" : "code", "model" : "item.ReferralCode", "placeholder" : "" },
                        { "text" : true, "label" : "Referral Name", "name" : "referralname", "model" : "item.ReferralName", "placeholder" : "" },
                        { "combo" : true, "label" : "Marketting Person", "name" : "markettingperson", "model" : "item.MarketingPersonId", "placeholder" : "", "collection" : "lookup.MarketingPerson", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Contact Person", "name" : "contactperson", "model" : "item.ContactPerson", "placeholder" : "" },
                        { "text" : true, "label" : "Phone No", "name" : "phoneno", "model" : "item.PhoneNo", "placeholder" : "" },
                        { "text" : true, "label" : "Fax No", "name" : "faxno", "model" : "item.FaxNo", "placeholder" : "" },
                        { "text" : true, "label" : "Email ID", "name" : "emailid", "model" : "item.Email", "placeholder" : "" },
                        { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.ActiveFrom", "placeholder" : "" },
                        { "date" : true, "label" : "Active From", "name" : "activeto", "model" : "item.ActiveTo", "placeholder" : "" }                                                
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "text" : true, "label" : "Address 1", "name" : "address1", "model" : "item.AddressLine1", "placeholder" : "" },
                        { "text" : true, "label" : "Address 2", "name" : "address2", "model" : "item.AddressLine2", "placeholder" : "" },
                        { "combo" : true, "label" : "Pincode", "name" : "pincode", "model" : "item.PinCodeId", "placeholder" : "", "collection" : "lookup.Pincode", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Area", "name" : "area", "model" : "item.Area", "placeholder" : "" },
                        { "combo" : true, "label" : "City", "name" : "city", "model" : "item.CityId", "placeholder" : "", "collection" : "lookup.City", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "District", "name" : "district", "model" : "item.DistrictId", "placeholder" : "", "collection" : "lookup.District", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "State", "name" : "state", "model" : "item.StateId", "placeholder" : "", "collection" : "lookup.State", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Country", "name" : "country", "model" : "item.CountryId", "placeholder" : "", "collection" : "lookup.Country", "valuefield" : "Id", "displayfield" : "Text" },
                        { "date" : true, "label" : "Birth Date", "name" : "birthdate", "model" : "item.BirthDate", "placeholder" : "" },
                        { "date" : true, "label" : "Anniversary From", "name" : "anniversarydate", "model" : "item.AnniversaryDate", "placeholder" : "" }                        
                    ] 
                }
            ]
        }
	]
}