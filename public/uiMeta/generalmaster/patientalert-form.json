{
    "Title" : "Patient Alert",
    "ControllerName" : "patientAlertForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "generalmaster/PatientAlert/GetPatientAlertById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "generalmaster/PatientAlert/AddPatientAlert",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "generalmaster/PatientAlert/UpdatePatientAlert",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "patientemr.patientalerts", "label" : "Patient Alerts" },
    "Localization" : { "localizationmodule" : "generalmaster", "screenkey" : "patientalert-form" },
	"Panels" : 
    [
        {
            "name" : "patientinfo",			
            "display" : "Patient Information",
            "localizationpath" : "generalmaster.patientalert-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Search Patient ", "name" : "searchpatient", "model" : "item.PatientId", "placeholder" : "", "collection" : "lookup.Patient", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "MRN", "name" : "mrn", "model" : "selectedPatient.MRN", "placeholder" : "" },
                        { "text" : true, "label" : "Name", "name" : "name", "model" : "selectedPatient.FirstName", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "text" : true, "label" : "Gender", "name" : "gender", "model" : "selectedPatient.Gender", "placeholder" : "" },
                        { "text" : true, "label" : "DOB", "name" : "dob", "model" : "selectedPatient.DOB", "placeholder" : "" },
                        { "text" : true, "label" : "Age", "name" : "age", "model" : "selectedPatient.Age", "placeholder" : "" },
                        { "text" : true, "label" : "Mobile No", "name" : "mobileno", "model" : "selectedPatient.Mobile", "placeholder" : "" }                        
                    ] 
                }
            ]
        },
        {
            "name" : "appointmentinfo",			
            "display" : "Appointment Information",
            "localizationpath" : "generalmaster.patientalert-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Alert Type ", "name" : "alerttype", "model" : "item.AlertTypeId", "placeholder" : "", "collection" : "lookup.AlertType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Severity", "name" : "severity", "model" : "item.SeverityId", "placeholder" : "", "collection" : "lookup.Severity", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Priority", "name" : "priority", "model" : "item.PriorityId", "placeholder" : "", "collection" : "lookup.Priority", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Department", "name" : "department", "model" : "item.DepartmentId", "placeholder" : "", "collection" : "lookup.Department", "valuefield" : "Id", "displayfield" : "Text" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "date" : true, "label" : "Onset Date", "name" : "onsetdate", "model" : "item.OnsetDate", "placeholder" : "" },
                        { "date" : true, "label" : "Closure Date", "name" : "closuredate", "model" : "item.ClosureDate", "placeholder" : "" },
                        { "text" : true, "label" : "Alert Description", "name" : "alertdesc", "model" : "item.AlertDescription", "placeholder" : "" }                        
                    ] 
                }
            ]
        }
	]
}