{
    "Title" : "Manage Research Projects",
    "ControllerName" : "researchProjectForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "generalmaster/ResearchProject/GetResearchProjectById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "generalmaster/ResearchProject/AddResearchProject",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "generalmaster/ResearchProject/UpdateResearchProject",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.researchprojects", "label" : "Manage Projects" },
    "Localization" : { "localizationmodule" : "generalmaster", "screenkey" : "researchproject-form" },
	"Panels" : 
    [
        {
            "name" : "researchproject",			
            "display" : "Manage Research Projects",
            "localizationpath" : "generalmaster.researchproject-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Facility", "name" : "facility", "model" : "item.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Type", "name" : "type", "model" : "item.ProjectTypeId", "placeholder" : "", "collection" : "lookup.ProjectType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Code", "name" : "projectcode", "model" : "item.ProjectCode", "placeholder" : "" },
                        { "text" : true, "label" : "Project Name", "name" : "projectname", "model" : "item.ProjectName", "placeholder" : "" }
                        ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "date" : true, "label" : "Start Date", "name" : "startdate", "model" : "item.StartDate", "placeholder" : "" },
                        { "date" : true, "label" : "End Date", "name" : "enddate", "model" : "item.EndDate", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Active", "name" : "isactive", "model" : "item.IsActive", "placeholder" : "", "truevalue": 1, "falsevalue" : 0 }, 
                        { "text" : true, "label" : "Comments", "name" : "comments", "model" : "item.Comments", "placeholder" : "" }                      
                    
                    ] 
                }
            ]
        }
	]
}