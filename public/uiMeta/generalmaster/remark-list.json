{
    "Title" : "Remarks List",
    "ControllerName" : "remarkList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FilterConfig" :[ {
        "localizationpath" : "generalmaster.remark-list",
        "controls" :[
               { "combo" : true, "label" : "Facility", "name" : "filter_facility", "model" : "currentfilter.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Type", "name" : "filter_remarktype", "model" : "currentfilter.RemarkTypeId", "placeholder" : "", "collection" : "lookup.RemarkType", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Screen", "name" : "filter_screen", "model" : "currentfilter.ScreenId", "placeholder" : "", "collection" : "lookup.Screen", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Status", "name" : "filter_status", "model" : "currentfilter.StatusId", "placeholder" : "", "collection" : "lookup.Status", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
        "url" : "generalmaster/remark/GetRemarks",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.remark",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.remark",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "generalmaster/remark/DeleteRemark",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "generalmaster", "screenkey" : "remark-list" },
    "GridConfig" :[ {
        "localizationpath" : "generalmaster.remark-list",
        "columnDefs": [ { "field": "Facility.FacilityName", "displayName": "Facility", "name" : "facility" } ,
                        { "field": "RemarkType.Description", "displayName": "Type", "name" : "type" },
                        { "field": "Code", "displayName": "Code", "name" : "code" },
                        { "field": "Screen.ScreenName", "displayName": "Screen Name", "name" : "screenname" },
                        { "field": "Remarks", "displayName": "Remarks", "name" : "remarks" },                                        
                        { "field": "StatusTODO", "displayName": "Status", "name" : "status" }
                    ]
        }
    ]
}