{
    "Title" : "Manage Resources",
    "ControllerName" : "resourceList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FilterConfig" :[ {
        "localizationpath" : "generalmaster.resource-list",
        "controls" :[
               { "combo" : true, "label" : "Facility", "name" : "filter_facility", "model" : "currentfilter.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Type", "name" : "filter_resourcetype", "model" : "currentfilter.ResourceTypeId", "placeholder" : "", "collection" : "lookup.ResourceType", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Department", "name" : "filter_department", "model" : "currentfilter.DepartmentId", "placeholder" : "", "collection" : "lookup.Department", "valuefield" : "Id", "displayfield" : "Text" },
               { "text" : true, "label" : "Resource/Code", "name" : "filter_resourcename", "model" : "currentfilter.ResourceName", "placeholder" : "" },
               { "combo" : true, "label" : "Status", "name" : "filter_status", "model" : "currentfilter.StatusId", "placeholder" : "", "collection" : "lookup.Status", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
        "url" : "generalmaster/ResourceMaster/GetResourceMasters",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.resource",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.resource",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "generalmaster/ResourceMaster/DeleteResourceMaster",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "generalmaster", "screenkey" : "resource-list" },
    "GridConfig" :[ {
        "localizationpath" : "generalmaster.resource-list",
        "columnDefs": [ { "field": "Facility.FacilityName", "displayName": "Facility", "name" : "facility" } ,
                        { "field": "ResourceType.Description", "displayName": "Type", "name" : "type" },
                        { "field": "ResourceCode", "displayName": "Code", "name" : "code" },
                        { "field": "Department.DepartmentName", "displayName": "Department", "name" : "department" },
                        { "field": "ResourceName", "displayName": "Resource Name", "name" : "resourcename" },                                        
                        { "field": "StatusTODO", "displayName": "Status", "name" : "status" }
                    ]
        }
    ]
}