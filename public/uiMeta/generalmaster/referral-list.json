{
    "Title" : "Referral List",
    "ControllerName" : "referralList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FilterConfig" :[ {
        "localizationpath" : "generalmaster.referral-list",
        "controls" :[
               { "combo" : true, "label" : "Facility", "name" : "filter_facility", "model" : "currentfilter.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Type", "name" : "filter_referraltype", "model" : "currentfilter.ReferralTypeId", "placeholder" : "", "collection" : "lookup.ReferralType", "valuefield" : "Id", "displayfield" : "Text" },
               { "text" : true, "label" : "Referral Name", "name" : "filter_referralname", "model" : "currentfilter.ReferralName", "placeholder" : "" },
               { "combo" : true, "label" : "Marketting Person", "name" : "filter_markettingperson", "model" : "currentfilter.MarketingPersonId", "placeholder" : "", "collection" : "lookup.MarketingPerson", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Status", "name" : "filter_status", "model" : "currentfilter.StatusId", "placeholder" : "", "collection" : "lookup.Status", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
        "url" : "generalmaster/referral/GetReferrals",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.referral",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.referral",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "generalmaster/referral/DeleteReferral",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "generalmaster", "screenkey" : "referral-list" },
    "GridConfig" :[ {
        "localizationpath" : "generalmaster.referral-list",
        "columnDefs": [ { "field": "Facility.FacilityName", "displayName": "Facility", "name" : "facility" } ,
                        { "field": "ReferralType.Description", "displayName": "Referral Type", "name" : "refrerraltype" },
                        { "field": "ReferralCode", "displayName": "Code", "name" : "code" },
                        { "field": "ReferralName", "displayName": "Referral Name", "name" : "referralname" },
                        { "field": "MarketingPerson.Description", "displayName": "Marketting Person", "name" : "markettingperson" },                        
                        { "field": "LoginId", "displayName": "Login ID", "name" : "loginid" },                                                              
                        { "field": "StatusTODO", "displayName": "Status", "name" : "status" }
                    ]
        }
    ]
}