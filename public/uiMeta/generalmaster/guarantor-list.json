{
    "Title" : "Guarantor List",
    "ControllerName" : "guarantorList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FilterConfig" :[ {
        "localizationpath" : "generalmaster.guarantor-list",
        "controls" :[
               { "combo" : true, "label" : "Type", "name" : "filter_guarantortype", "model" : "currentfilter.GuarantorTypeId", "placeholder" : "", "collection" : "lookup.GuarantorType", "valuefield" : "Id", "displayfield" : "Text" },
               { "text" : true, "label" : "Guarantor Code/Name", "name" : "filter_guarantorcodename", "model" : "currentfilter.GuarantorName", "placeholder" : "" },
               { "combo" : true, "label" : "TPA Name", "name" : "filter_tpaname", "model" : "currentfilter.TPAId", "placeholder" : "", "collection" : "lookup.TPA", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Status", "name" : "filter_status", "model" : "currentfilter.StatusId", "placeholder" : "", "collection" : "lookup.Status", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
        "url" : "generalmaster/guarantor/GetGuarantors",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.guarantor",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.guarantor",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "generalmaster/guarantor/DeleteGuarantor",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "generalmaster", "screenkey" : "guarantor-list" },
    "GridConfig" :[ {
        "localizationpath" : "generalmaster.guarantor-list",
        "columnDefs": [ { "field": "Code", "displayName": "Code", "name" : "code" } ,
                        { "field": "GuarantorName", "displayName": "Guarantor Name", "name" : "guarantorname" },
                        { "field": "GuarantorType.Description", "displayName": "Type", "name" : "type" },
                        { "field": "ContractDate", "displayName": "Contract Date", "name" : "contractdate" },
                        { "field": "ContractExpiryDate", "displayName": "Expiry Date", "name" : "expirydate" },
                        { "field": "CreditLimit", "displayName": "Credit Limit", "name" : "creditlimit" },
                        { "field": "AvailableLimit", "displayName": "Available Limit", "name" : "availablelimit" },                                        
                        { "field": "StatusTODO", "displayName": "Status", "name" : "status" }
                    ]
        }
    ]
}