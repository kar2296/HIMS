{
    "Title" : "Manage Projects",
    "ControllerName" : "researchProjectList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FilterConfig" :[ {
        "localizationpath" : "generalmaster.researchproject-list",
        "controls" :[
               { "combo" : true, "label" : "Facility", "name" : "filter_facility", "model" : "currentfilter.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Type", "name" : "filter_projecttype", "model" : "currentfilter.ProjectTypeId", "placeholder" : "", "collection" : "lookup.ProjectType", "valuefield" : "Id", "displayfield" : "Text" },
               { "text" : true, "label" : "Project Name", "name" : "filter_projectname", "model" : "currentfilter.ProjectName", "placeholder" : "" },
               { "combo" : true, "label" : "Status", "name" : "filter_status", "model" : "currentfilter.StatusId", "placeholder" : "", "collection" : "lookup.Status", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
        "url" : "generalmaster/ResearchProject/GetResearchProjects",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.researchproject",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.researchproject",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "generalmaster/ResearchProject/DeleteResearchProject",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "generalmaster", "screenkey" : "researchproject-list" },
    "GridConfig" :[ {
        "localizationpath" : "generalmaster.researchproject-list",
        "columnDefs": [ { "field": "Facility.FacilityName", "displayName": "Facility", "name" : "facility" } ,
                        { "field": "ProjectType.Description", "displayName": "Type", "name" : "type" },
                        { "field": "ProjectCode", "displayName": "Code", "name" : "code" },
                        { "field": "ProjectName", "displayName": "Project Name  ", "name" : "projectname" },
                        { "field": "StartDate", "displayName": "State Date", "name" : "startdate" }, 
                        { "field": "EndDate", "displayName": "End Date", "name" : "enddate" },                                        
                        { "field": "StatusTODO", "displayName": "Status", "name" : "status" }
                    ]
        }
    ]
}