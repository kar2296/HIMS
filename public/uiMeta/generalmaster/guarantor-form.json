{
    "Title" : "Guarantor Form",
    "ControllerName" : "guarantorForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "generalmaster/guarantor/GetGuarantorById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "generalmaster/guarantor/AddGuarantor",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "generalmaster/guarantor/UpdateGuarantor",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.guarantors", "label" : "Guarantors" },
    "Localization" : { "localizationmodule" : "generalmaster", "screenkey" : "guarantor-form" },
	"Panels" : 
    [
        {
            "name" : "guarantor",			
            "display" : "Guarantor",
            "localizationpath" : "generalmaster.guarantor-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Code", "name" : "code", "model" : "item.Code", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Guarantor Name", "name" : "guarantorname", "model" : "item.GuarantorName", "placeholder" : "", "validations":{"required" : true } },
                        { "combo" : true, "label" : "Guarantor Type", "name" : "guarantortype", "model" : "item.GuarantorTypeId", "placeholder" : "", "collection" : "lookup.GuarantorType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Credit Limit", "name" : "creditlimit", "model" : "item.CreditLimit", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Available Limit", "name" : "availablelimit", "model" : "item.AvailableLimit", "placeholder" : "" },
                        { "date" : true, "label" : "Contract Date", "name" : "contractdate", "model" : "item.ContractDate", "placeholder" : "", "validations":{"required" : true } },
                        { "date" : true, "label" : "Contract Expiry Date", "name" : "contractexpirydate", "model" : "item.ContractExpiryDate", "placeholder" : "", "validations":{"required" : true } },                        
                        { "combo" : true, "label" : "TPA Name", "name" : "tpaname", "model" : "item.TPAId", "placeholder" : "", "collection" : "lookup.TPA", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Service Rate Category", "name" : "serviceratecategory", "model" : "item.ServiceRateCategoryId", "placeholder" : "", "collection" : "lookup.ServiceRateCategory", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Client Type", "name" : "clienttype", "model" : "item.GuarantorClientTypeId", "placeholder" : "", "collection" : "lookup.GuarantorClientType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "checkbox" : true, "label" : "Active", "name" : "isactive", "model" : "item.IsActive", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "text" : true, "label" : "Address 1", "name" : "address1", "model" : "item.AddressLine1", "placeholder" : "" },
                        { "text" : true, "label" : "Address 2", "name" : "address2", "model" : "item.AddressLine2", "placeholder" : "" },
                        { "combo" : true, "label" : "Pincode", "name" : "pincode", "model" : "item.PinCodeId", "placeholder" : "", "collection" : "lookup.Pincode", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Area", "name" : "area", "model" : "item.Area", "placeholder" : "" },
                        { "combo" : true, "label" : "City", "name" : "city", "model" : "item.CityId", "placeholder" : "", "collection" : "lookup.City", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "District", "name" : "district", "model" : "item.DistrictId", "placeholder" : "", "collection" : "lookup.District", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "State", "name" : "state", "model" : "item.StateId", "placeholder" : "", "collection" : "lookup.State", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Country", "name" : "country", "model" : "item.CountryId", "placeholder" : "", "collection" : "lookup.Country", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Phone", "name" : "phone", "model" : "item.Phone", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Email", "name" : "email", "model" : "item.Email", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Business Development Manager", "name" : "businessdevelopmentmanager", "model" : "item.BusinessDevelopmentManager", "placeholder" : "" },
                        { "text" : true, "label" : "Credit Account No", "name" : "creditaccountno", "model" : "item.CreditAccountNo", "placeholder" : "" },
                        { "text" : true, "label" : "Debit Account No", "name" : "debitaccountno", "model" : "item.DebitAccountNo", "placeholder" : "" }                                                
                    ] 
                }
            ]
        }
	]
}