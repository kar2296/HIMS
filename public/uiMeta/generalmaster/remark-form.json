{
    "Title" : "Remark Form",
    "ControllerName" : "remarkForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "generalmaster/remark/GetRemarkById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "generalmaster/remark/AddRemark",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "generalmaster/remark/UpdateRemark",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.remarks", "label" : "Remarks" },
    "Localization" : { "localizationmodule" : "generalmaster", "screenkey" : "remark-form" },
	"Panels" : 
    [
        {
            "name" : "remark",			
            "display" : "Remark",
            "localizationpath" : "generalmaster.remark-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Facility", "name" : "facility", "model" : "item.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Type", "name" : "type", "model" : "item.RemarkTypeId", "placeholder" : "", "collection" : "lookup.RemarkType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Screen", "name" : "screen", "model" : "item.ScreenId", "placeholder" : "", "collection" : "lookup.Screen", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Code", "name" : "code", "model" : "item.Code", "placeholder" : "" },
                        { "text" : true, "label" : "Remarks", "name" : "remarks", "model" : "item.Remarks", "placeholder" : "", "validations":{"required" : true } },
                        { "checkbox" : true, "label" : "Active", "name" : "isactive", "model" : "item.IsActive", "placeholder" : "", "truevalue": 1, "falsevalue" : 0 }                        
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [] 
                }
            ]
        }
	]
}