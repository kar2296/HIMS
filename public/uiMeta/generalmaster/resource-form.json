{
    "Title" : "Resource",
    "ControllerName" : "resourceForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "generalmaster/ResourceMaster/GetResourceMasterById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "generalmaster/ResourceMaster/AddResourceMaster",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "generalmaster/ResourceMaster/UpdateResourceMaster",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.resources", "label" : "Resources" },
    "Localization" : { "localizationmodule" : "generalmaster", "screenkey" : "resource-form" },
	"Panels" : 
    [
        {
            "name" : "resource",			
            "display" : "Resource",
            "localizationpath" : "generalmaster.resource-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Facility", "name" : "facility", "model" : "item.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Type", "name" : "type", "model" : "item.ResourceTypeId", "placeholder" : "", "collection" : "lookup.ResourceType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Department", "name" : "department", "model" : "item.DepartmentId", "placeholder" : "", "collection" : "lookup.Department", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Code", "name" : "resourcecode", "model" : "item.ResourceCode", "placeholder" : "" },
                        { "text" : true, "label" : "Resource Name", "name" : "resourcename", "model" : "item.ResourceName", "placeholder" : "" },
                        { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.ActiveFrom", "placeholder" : "" },
                        { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.ActiveTo", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Active", "name" : "isactive", "model" : "item.IsActive", "placeholder" : "", "truevalue": 1, "falsevalue" : 0 }, 
                        { "text" : true, "label" : "Comments", "name" : "comments", "model" : "item.Comments", "placeholder" : "" }                      
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [] 
                }
            ]
        }
	]
}