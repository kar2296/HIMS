{
    "Title" : "Manage Generic Master(s)",
    "ControllerName" : "genericMasterForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "pharmacy/genericmaster/GetGenericMasterById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "pharmacy/genericmaster/AddGenericMaster",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "pharmacy/genericmaster/UpdateGenericMaster",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.genericmasters", "label" : "genericmasters" },
    "Localization" : { "localizationmodule" : "inventory", "screenkey" : "genericmaster" },
	"Panels" : 
    [
        {
            "name" : "genericmaster",			
            "display" : "Generic Master",
            "localizationpath" : "inventory.genericmaster",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true,"label" : "Facility Name", "name" : "facilityId", "model" : "item.FacilityId","placeholder" : "Facility Name", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Generic Code", "name" : "code", "model" : "item.GenericCode", "placeholder" : "Generic Code" },
                        { "text" : true, "label" : "Generic Name", "name" : "name", "model" : "item.GenericName", "placeholder" : "Generic Name" },
                        { "text" : true, "label" : "Generic Description", "name" : "description", "model" : "item.GenericDescription", "placeholder" : "Generic Description" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.ActiveFrom", "placeholder" : "" },
                        { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.ActiveTo", "placeholder" : "" }
                    ] 
                }
            ]
        }
	]
}    