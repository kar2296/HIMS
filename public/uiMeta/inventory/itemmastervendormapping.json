{
    "Title" : "Manage Item Vendor Mapping(s)",
    "ControllerName" : "itemmasterVendorMapForm",
    "InitAction" : {
        "url" : "pharmacy/vendormaster/GetVendorMasters",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "pharmacy/itemmaster/GetItemVendormapById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "pharmacy/itemmaster/AddItemVendorMap",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "pharmacy/itemmaster/UpdateItemVendorMap",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.itemmastertab.itemmastervendormappings", "label" : "itemmastervendormappings" },
    "Localization" : { "localizationmodule" : "inventory", "screenkey" : "itemmastervendormapping" },
	"Panels" : 
    [
        {
            "name" : "itemmastervendormapping",			
            "display" : "itemmastervendormapping",
            "localizationpath" : "inventory.itemmastervendormapping",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true,"label" : "Vendor Name", "name" : "vendorId", "model" : "item.VendorId","placeholder" : "Type", "collection" : "lookup.VendorMaster", "valuefield" : "Id", "displayfield" : "VendorName" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.ActiveFrom", "placeholder" : "" },
                        { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.ActiveTo", "placeholder" : "" }
                    ]
                }
            ]
        }
	]
} 
 