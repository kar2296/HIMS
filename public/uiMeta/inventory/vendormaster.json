{
    "Title" : "Manage Vendor Master(s)",
    "ControllerName" : "vendorMasterForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "pharmacy/vendormaster/GetVendorMasterById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "pharmacy/vendormaster/AddVendorMaster",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "pharmacy/vendormaster/UpdateVendorMaster",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.vendormasters", "label" : "vendormasters" },
    "Localization" : { "localizationmodule" : "inventory", "screenkey" : "vendormaster" },
	"Panels" : 
    [
        {
            "name" : "vendormaster",			
            "display" : "Vendor Master",
            "localizationpath" : "inventory.vendormaster",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true,"label" : "Facility Name", "name" : "facilityId", "model" : "item.FacilityId","placeholder" : "Facility Name", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Vendor Code", "name" : "code", "model" : "item.VendorCode", "placeholder" : "Vendor Code" },
                        { "text" : true, "label" : "Vendor Name", "name" : "name", "model" : "item.VendorName", "placeholder" : "Vendor Name" },
                        { "text" : true, "label" : "Vendor Description", "name" : "description", "model" : "item.VendorDescription", "placeholder" : "Vendor Description" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.ActiveFrom", "placeholder" : "" },
                        { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.ActiveTo", "placeholder" : "" }
                    ] 
                }
            ]
        }
	]
}    