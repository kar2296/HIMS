{
    "Title" : "Manage Product Sub Type(s)",
    "ControllerName" : "productSubTypeForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "pharmacy/productsubtype/GetProductSubTypeById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "pharmacy/productsubtype/AddProductSubType",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "pharmacy/productsubtype/UpdateProductSubType",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.productsubtypes", "label" : "productsubtypes" },
    "Localization" : { "localizationmodule" : "inventory", "screenkey" : "productsubtype" },
	"Panels" : 
    [
        {
            "name" : "productsubtype",			
            "display" : "Product Sub Type",
            "localizationpath" : "inventory.productsubtype",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true,"label" : "Facility Name", "name" : "facilityId", "model" : "item.FacilityId","placeholder" : "Facility Name", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true,"label" : "Product Type Name", "name" : "producttypeId", "model" : "item.ProductTypeId","placeholder" : "Product Type Name", "collection" : "lookup.ProductType", "valuefield" : "Id", "displayfield" : "Name" },
                        { "text" : true, "label" : "Sub Product Type Code", "name" : "code", "model" : "item.SubProductTypeCode", "placeholder" : "Sub Product Type Code" },
                        { "text" : true, "label" : "Sub Product Type Name", "name" : "name", "model" : "item.SubProductTypeName", "placeholder" : "Sub Product Type Name" },
                        { "text" : true, "label" : "Sub Product Type Description", "name" : "description", "model" : "item.SubProductTypeDescription", "placeholder" : "Sub Product Type Description" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.ActiveFrom", "placeholder" : "" },
                        { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.ActiveTo", "placeholder" : "" }
                    ] 
                }
            ]
        }
	]
}