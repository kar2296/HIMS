{
    "Title" : "Manage Item Master(s)",
    "ControllerName" : "itemMasterForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "pharmacy/itemmaster/GetItemMasterById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "pharmacy/itemmaster/AddItemMaster",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "pharmacy/itemmaster/UpdateItemMaster",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.itemmasters", "label" : "itemmasters" },
    "Localization" : { "localizationmodule" : "inventory", "screenkey" : "itemmaster" },
	"Panels" : 
    [
        {
            "name" : "itemmaster",			
            "display" : "Item Master",
            "localizationpath" : "inventory.itemmaster",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true,"label" : "Facility Name", "name" : "facilityId", "model" : "item.FacilityId","placeholder" : "Facility Name", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Item Code", "name" : "code", "model" : "item.ItemCode", "placeholder" : "Item Code" },
                        { "text" : true, "label" : "Item Name", "name" : "name", "model" : "item.ItemName", "placeholder" : "Item Name" },
                        { "text" : true, "label" : "Item Description", "name" : "description", "model" : "item.ItemDescription", "placeholder" : "Item Description" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.ActiveFrom", "placeholder" : "" },
                        { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.ActiveTo", "placeholder" : "" }
                    ] 
                }
            ]
        }
	]
}    