{
    "Title" : "Manage GST Master(s)",
    "ControllerName" : "gstMasterForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "pharmacy/gstmaster/GetGstMasterById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "pharmacy/gstmaster/AddGstMaster",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "pharmacy/gstmaster/UpdateGstMaster",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.gstmasters", "label" : "gstmasters" },
    "Localization" : { "localizationmodule" : "inventory", "screenkey" : "gstmaster" },
	"Panels" : 
    [
        {
            "name" : "gstmaster",			
            "display" : "GST Master",
            "localizationpath" : "inventory.gstmaster",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true,"label" : "Facility Name", "name" : "facilityId", "model" : "item.FacilityId","placeholder" : "Facility Name", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "GST Code", "name" : "code", "model" : "item.GstCode", "placeholder" : "GST Code" },
                        { "text" : true, "label" : "GST Name", "name" : "name", "model" : "item.GstName", "placeholder" : "GST Name" },
                        { "text" : true, "label" : "GST Description", "name" : "description", "model" : "item.GstDescription", "placeholder" : "GST Description" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.ActiveFrom", "placeholder" : "" },
                        { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.ActiveTo", "placeholder" : "" }
                    ] 
                }
            ]
        }
	]
}    