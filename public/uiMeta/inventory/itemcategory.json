{
    "Title" : "Manage Item Category(s)",
    "ControllerName" : "itemCategoryForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "pharmacy/itemcategory/GetItemCategoryById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "pharmacy/itemcategory/AddItemCategory",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "pharmacy/itemcategory/UpdateItemCategory",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.itemcategorys", "label" : "itemcategorys" },
    "Localization" : { "localizationmodule" : "inventory", "screenkey" : "itemcategory" },
	"Panels" : 
    [
        {
            "name" : "itemcategory",			
            "display" : "Item Category",
            "localizationpath" : "inventory.itemcategory",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true,"label" : "Facility Name", "name" : "facilityId", "model" : "item.FacilityId","placeholder" : "Facility Name", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Category Code", "name" : "code", "model" : "item.CategoryCode", "placeholder" : "Category Code" },
                        { "text" : true, "label" : "Category Name", "name" : "name", "model" : "item.CategoryName", "placeholder" : "Category Name" },
                        { "text" : true, "label" : "Category Description", "name" : "description", "model" : "item.CategoryDescription", "placeholder" : "Category Description" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.ActiveFrom", "placeholder" : "" },
                        { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.ActiveTo", "placeholder" : "" }
                    ] 
                }
            ]
        }
	]
}    