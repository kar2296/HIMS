{
    "Title" : "Manage Store Master(s)",
    "ControllerName" : "storeMasterForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "pharmacy/storemaster/GetStoreMasterById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "pharmacy/storemaster/AddStoreMaster",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "pharmacy/storemaster/UpdateStoreMaster",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.storemasters", "label" : "storemasters" },
    "Localization" : { "localizationmodule" : "inventory", "screenkey" : "storemaster" },
	"Panels" : 
    [
        {
            "name" : "storemaster",			
            "display" : "Store Master",
            "localizationpath" : "inventory.storemaster",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true,"label" : "Facility Name", "name" : "facilityId", "model" : "item.FacilityId","placeholder" : "Facility Name", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Store Code", "name" : "code", "model" : "item.StoreCode", "placeholder" : "Store Code" },
                        { "text" : true, "label" : "Store Name", "name" : "name", "model" : "item.StoreName", "placeholder" : "Store Name" },
                        { "text" : true, "label" : "Store Description", "name" : "description", "model" : "item.StoreDescription", "placeholder" : "Store Description" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.ActiveFrom", "placeholder" : "" },
                        { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.ActiveTo", "placeholder" : "" }
                    ] 
                }
            ]
        }
	]
}    