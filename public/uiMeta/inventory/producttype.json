{
    "Title" : "Manage Product Type(s)",
    "ControllerName" : "productTypeForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "pharmacy/producttype/GetProductTypeById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "pharmacy/producttype/AddProductType",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "pharmacy/producttype/UpdateProductType",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.producttypes", "label" : "producttypes" },
    "Localization" : { "localizationmodule" : "inventory", "screenkey" : "producttype" },
	"Panels" : 
    [
        {
            "name" : "producttype",			
            "display" : "Product Type",
            "localizationpath" : "inventory.producttype",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true,"label" : "Facility Name", "name" : "facilityId", "model" : "item.FacilityId","placeholder" : "Facility Name", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Product Type Code", "name" : "code", "model" : "item.ProductTypeCode", "placeholder" : "Product Type Code" },
                        { "text" : true, "label" : "Product Type Name", "name" : "name", "model" : "item.ProductTypeName", "placeholder" : "Product Type Name" },
                        { "text" : true, "label" : "Product Type Description", "name" : "description", "model" : "item.ProductTypeDescription", "placeholder" : "Product Type Description" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.ActiveFrom", "placeholder" : "" },
                        { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.ActiveTo", "placeholder" : "" }
                    ] 
                }
            ]
        }
	]
}    