{
    "Title" : "Manage UOM Master(s)",
    "ControllerName" : "uomMasterForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "pharmacy/uommaster/GetUomMasterById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "pharmacy/uommaster/AddUomMaster",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "pharmacy/uommaster/UpdateUomMaster",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.uommasters", "label" : "uommasters" },
    "Localization" : { "localizationmodule" : "inventory", "screenkey" : "uommaster" },
	"Panels" : 
    [
        {
            "name" : "uommaster",			
            "display" : "UOM Master",
            "localizationpath" : "inventory.uommaster",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true,"label" : "Facility Name", "name" : "facilityId", "model" : "item.FacilityId","placeholder" : "Facility Name", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "UOM Code", "name" : "code", "model" : "item.UomCode", "placeholder" : "UOM Code" },
                        { "text" : true, "label" : "UOM Name", "name" : "name", "model" : "item.UomName", "placeholder" : "UOM Name" },
                        { "text" : true, "label" : "UOM Description", "name" : "description", "model" : "item.UomDescription", "placeholder" : "UOM Description" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.ActiveFrom", "placeholder" : "" },
                        { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.ActiveTo", "placeholder" : "" }
                    ] 
                }
            ]
        }
	]
}    