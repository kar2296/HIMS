{
    "Title" : "Manage Item Sub Category(s)",
    "ControllerName" : "itemSubCategoryForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "pharmacy/itemsubcategory/GetItemSubCategoryById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "pharmacy/itemsubcategory/AddItemSubCategory",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "pharmacy/itemsubcategory/UpdateItemSubCategory",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.itemsubcategorys", "label" : "itemsubcategorys" },
    "Localization" : { "localizationmodule" : "inventory", "screenkey" : "itemsubcategory" },
	"Panels" : 
    [
        {
            "name" : "itemsubcategory",			
            "display" : "Item Sub Category",
            "localizationpath" : "inventory.itemsubcategory",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true,"label" : "Facility Name", "name" : "facilityId", "model" : "item.FacilityId","placeholder" : "Facility Name", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true,"label" : "Category Name", "name" : "categoryId", "model" : "item.CategoryId","placeholder" : "Category Name", "collection" : "lookup.ItemCategory", "valuefield" : "Id", "displayfield" : "Name" },
                        { "text" : true, "label" : "Sub Category Code", "name" : "code", "model" : "item.SubCategoryCode", "placeholder" : "Sub Category Code" },
                        { "text" : true, "label" : "Sub Category Name", "name" : "name", "model" : "item.SubCategoryName", "placeholder" : "Sub Category Name" },
                        { "text" : true, "label" : "Sub Category Description", "name" : "description", "model" : "item.SubCategoryDescription", "placeholder" : "Sub Category Description" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.ActiveFrom", "placeholder" : "" },
                        { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.ActiveTo", "placeholder" : "" }
                    ] 
                }
            ]
        }
	]
}