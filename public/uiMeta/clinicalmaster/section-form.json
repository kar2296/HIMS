{
    "Title" : "Section Form",
    "ControllerName" : "sectionForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "clinicalmaster/SectionMaster/GetSectionMasterById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/SectionMaster/AddSectionMaster",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/SectionMaster/UpdateSectionMaster",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.sections", "label" : "Sections" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "section-form" },
	"Panels" : 
    [
        {
            "name" : "section",			
            "display" : "Section",
            "localizationpath" : "clinicalmaster.section-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Name", "name" : "name", "model" : "item.Name", "placeholder" : "", "validations":{"required" : true } },
                        { "combo" : true, "label" : "Parent Section", "name" : "parentsection", "model" : "item.ParentSectionId", "placeholder" : "", "collection" : "lookup.SectionMaster", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Type", "name" : "type", "model" : "item.SectionTypeId", "placeholder" : "", "collection" : "lookup.SectionType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" },
                        { "text" : true, "label" : "SRef", "name" : "sref", "model" : "item.SRef", "placeholder" : "" },
                        { "combo" : true, "label" : "Dock Position", "name" : "dockposition", "model" : "item.DockPosition", "placeholder" : "", "collection" : "lookup.DockPosition", "valuefield" : "Id", "displayfield" : "Text" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [] 
                }
            ]
        }
	]
}