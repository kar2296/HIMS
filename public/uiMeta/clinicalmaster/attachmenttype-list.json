{
    "Title" : "Attachment Types",
    "ControllerName" : "attachmentTypeList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "Department"}]
    },
    "FilterConfig" :[ {
        "localizationpath" : "clinicalmaster.attachmenttype-list",
        "controls" :[
               { "combo" : true, "label" : "Department", "name" : "filter_department", "model" : "currentfilter.DepartmentId", "placeholder" : "", "collection" : "lookup.Department", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
