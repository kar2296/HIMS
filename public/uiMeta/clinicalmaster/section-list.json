{
    "Title" : "Sections List",
    "ControllerName" : "sectionList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FilterConfig" :[ {
        "localizationpath" : "clinicalmaster.section-list"
        }
    ],
    "FetchAction" : {
        "url" : "clinicalmaster/SectionMaster/GetSectionMasters",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.section",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.section",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "clinicalmaster/SectionMaster/DeleteSectionMaster",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "section-list" },
    "GridConfig" :[ {
        "localizationpath" : "clinicalmaster.section-list",
        "columnDefs": [ { "field": "Name", "displayName": "Name", "name" : "name" } ,
                        { "field": "ParentSection.Name", "displayName": "Parent Section", "name" : "parentsection" },
                        { "field": "SectionType.Description", "displayName": "Description", "name" : "description" },
                        { "field": "DockPosition.Description", "displayName": "Dock Position", "name" : "dockposition" }
                    ]
        }
    ]
}