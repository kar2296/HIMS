{
    "Title" : "Manage Allergy Reaction",
    "ControllerName" : "allergyReactionForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "clinicalmaster/AllergyReaction/GetAllergyReactionById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/AllergyReaction/AddAllergyReaction",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/AllergyReaction/UpdateAllergyReaction",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.allergyreactions", "label" : "Allergy Reaction" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "allergyreaction-form" },
	"Panels" : 
    [
        {
            "name" : "allergyreaction",			
            "display" : "Manage Allergy Reaction",
            "localizationpath" : "clinicalmaster.allergyreaction-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Display ID", "name" : "displayid", "model" : "item.DisplayId", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Reaction Name", "name" : "reactionname", "model" : "item.AllergyReactionName", "placeholder" : "", "validations":{"required" : true } },
                        { "combo" : true, "label" : "Type", "name" : "type", "model" : "item.AllergyReactionTypeId", "placeholder" : "", "collection" : "lookup.AllergyType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Referrence Link", "name" : "referrencelink", "model" : "item.ReferrenceLink", "placeholder" : "" },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Active", "name" : "isactive", "model" : "item.IsActive", "placeholder" : "", "truevalue": 1, "falsevalue" : 0 }                        
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [] 
                }
            ]
        }
	]
}