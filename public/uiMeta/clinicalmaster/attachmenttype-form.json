{
    "Title" : "Attachment Type",
    "ControllerName" : "attachmentTypeForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "Department"}]
    },
    "FetchAction" : {
        "url" : "clinicalmaster/AttachmentType/GetAttachmentTypeById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/AttachmentType/AddAttachmentType",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/AttachmentType/UpdateAttachmentType",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.attachmenttypes", "label" : "Attachment Types" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "attachmenttype-form" },
	"Panels" : 
    [
        {
            "name" : "attachmenttype",			
            "display" : "Attachment Type",
            "localizationpath" : "clinicalmaster.attachmenttype-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Name", "name" : "name", "model" : "item.Name", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" },                        
                        { "combo" : true, "label" : "Department", "name" : "department", "model" : "item.DepartmentId", "placeholder" : "", "collection" : "lookup.Department", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Referrence Link", "name" : "referrencelink", "model" : "item.ReferrenceLink", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Active", "name" : "isactive", "model" : "item.IsActive", "placeholder" : ""}                        
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [] 
                }
            ]
        }
	]
}