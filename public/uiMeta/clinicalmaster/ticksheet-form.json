{
    "Title" : "Tich Sheet Form",
    "ControllerName" : "tickSheetForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "TickSheetType"}, {"name" : "Department"}, {"name" : "SubDepartment"} ]
    },
    "FetchAction" : {
        "url" : "clinicalmaster/TickSheet/GetTickSheetById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/TickSheet/AddTickSheet",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/TickSheet/UpdateTickSheet",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.ticksheets", "label" : "Tick Sheets" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "ticksheet-form" },
	"Panels" : 
    [
        {
            "name" : "ticksheet",			
            "display" : "Manage Ticksheet",
            "localizationpath" : "clinicalmaster.ticksheet-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Type", "name" : "type", "model" : "item.TickSheetTypeId", "placeholder" : "", "collection" : "lookup.TickSheetTyp", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Department", "name" : "department", "model" : "item.DepartmentId", "placeholder" : "", "collection" : "lookup.Department", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Sub Department", "name" : "subdepartment", "model" : "item.SubDepartmentId", "placeholder" : "", "collection" : "lookup.SubDepartment", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Test ID", "name" : "testid", "model" : "item.TestId", "placeholder" : "" },
                        { "text" : true, "label" : "Tick Sheet Name", "name" : "name", "model" : "item.TickSheetName", "placeholder" : "" },
                        { "text" : true, "label" : "Display Order", "name" : "displayorder", "model" : "item.DisplayOrder", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Active", "name" : "isactive", "model" : "item.IsActive", "placeholder" : "" }                        
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [] 
                }
            ]
        }
	]
}