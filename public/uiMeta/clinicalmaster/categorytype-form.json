{
    "Title" : "Category Type Form",
    "ControllerName" : "categoryTypeForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "clinicalmaster/CategoryType/GetCategoryTypeById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/CategoryType/AddCategoryType",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/CategoryType/UpdateCategoryType",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.categorytypes", "label" : "Category Type" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "categorytype-form" },
	"Panels" : 
    [
        {
            "name" : "categorytype",			
            "display" : "Category Type",
            "localizationpath" : "clinicalmaster.categorytype-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Name", "name" : "name", "model" : "item.Name", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" },
                        { "combo" : true, "label" : "Type", "name" : "type", "model" : "item.CategoryTypeRefId", "placeholder" : "", "collection" : "lookup.CategoryTypeRef", "valuefield" : "Id", "displayfield" : "Text" },
                        { "checkbox" : true, "label" : "Associated With CC", "name" : "associatedwithcc", "model" : "item.IsAssociatedWithCC", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Active", "name" : "active", "model" : "item.IsActive", "placeholder" : "" }                   
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [] 
                }
            ]
        }
	]
}