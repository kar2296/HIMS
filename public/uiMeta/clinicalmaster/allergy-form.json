{
    "Title" : "Allergy Form",
    "ControllerName" : "allergyForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "clinicalmaster/AllergyMaster/GetAllergyMasterById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/AllergyMaster/AddAllergyMaster",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/AllergyMaster/UpdateAllergyMaster",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.allergies", "label" : "Allergies" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "allergy-form" },
	"Panels" : 
    [
        {
            "name" : "allergy",			
            "display" : "Allergy",
            "localizationpath" : "clinicalmaster.allergy-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Display ID", "name" : "displayid", "model" : "item.DisplayId", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Allergy Name", "name" : "allergyname", "model" : "item.AllergyName", "placeholder" : "", "validations":{"required" : true } },
                        { "combo" : true, "label" : "Type", "name" : "type", "model" : "item.AllergyTypeId", "placeholder" : "", "collection" : "lookup.AllergyType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Event Type", "name" : "eventtype", "model" : "item.AllergyEventTypeId", "placeholder" : "", "collection" : "lookup.EventType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Referrence Link", "name" : "referrencelink", "model" : "item.ReferrenceLink", "placeholder" : "" },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Active", "name" : "isactive", "model" : "item.IsActive", "placeholder" : "" }                        
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [] 
                }
            ]
        }
	]
}