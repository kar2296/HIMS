{
    "Title" : "Profile List",
    "ControllerName" : "profileList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FilterConfig" :[ {
        "localizationpath" : "clinicalmaster.profile-list"
        }
    ],
    "FetchAction" : {
        "url" : "clinicalmaster/ProfileMaster/GetProfileMasters",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.profile",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.profile",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "clinicalmaster/ProfileMaster/DeleteProfileMaster",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "profile-list" },
    "GridConfig" :[ {
        "localizationpath" : "clinicalmaster.profile-list",
        "columnDefs": [ { "field": "Name", "displayName": "Name", "name" : "name" } ,
                        { "field": "Description", "displayName": "Description", "name" : "description" }
                    ]
        }
