{
    "Title" : "Manange Item Group",
    "ControllerName" : "serviceGroupList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "Facility"},{"name" : "SourceType"}, {"name" : "OrderMasterStatus"} ]
    },
    "FilterConfig" :[ {
        "localizationpath" : "clinicalmaster.servicegroup-list",
        "controls" :[
               { "combo" : true, "label" : "Facility", "name" : "filter_facility", "model" : "currentfilter.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Source Type", "name" : "filter_sourcetype", "model" : "currentfilter.SourceTypeId", "placeholder" : "", "collection" : "lookup.SourceType", "valuefield" : "Id", "displayfield" : "Text" },
               { "text" : true, "label" : "Name/Code", "name" : "filter_name", "model" : "currentfilter.Name", "placeholder" : "" },
               { "combo" : true, "label" : "Status", "name" : "filter_status", "model" : "currentfilter.StatusId", "placeholder" : "", "collection" : "lookup.OrderMasterStatus", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
        "url" : "clinicalmaster/servicegroup/GetServiceGroups",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "clinicalmaster/servicegroup/DeleteServiceGroup",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "servicegroup-list" },
    "GridConfig" :[ {
        "localizationpath" : "clinicalmaster.servicegroup-list",
        "columnDefs": [ { "field": "FacilityId", "displayName": "Facility", "name" : "facility" } ,
                        { "field": "SourceTypeId", "displayName": "SourceType", "name" : "sourcetype" } , 
                        { "field": "ServiceGroupCode", "displayName": "Code", "name" : "code" },
                        { "field": "ServiceGroupName", "displayName": "Item Group Name", "name" : "itemgroupname" },
                        { "field": "DisplayOrder", "displayName": "Display Order", "name" : "displayorder" },
                        { "field": "StatusId", "displayName": "Status", "name" : "status" }
                    ]
        }
    ]
}