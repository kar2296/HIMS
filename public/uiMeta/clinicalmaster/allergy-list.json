{
    "Title" : "Allergies List",
    "ControllerName" : "allergyList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FilterConfig" :[ {
        "localizationpath" : "clinicalmaster.allergy-list",
        "controls" :[
               { "combo" : true, "label" : "Type", "name" : "filter_allergytype", "model" : "currentfilter.AllergyTypeId", "placeholder" : "", "collection" : "lookup.AllergyType", "valuefield" : "Id", "displayfield" : "Text" },
               { "text" : true, "label" : "Name/Code", "name" : "filter_allergyname", "model" : "currentfilter.AllergyName", "placeholder" : "" },
               { "combo" : true, "label" : "Status", "name" : "filter_status", "model" : "currentfilter.StatusId", "placeholder" : "", "collection" : "lookup.Status", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
        "url" : "clinicalmaster/AllergyMaster/GetAllergyMasters",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.allergy",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.allergy",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "clinicalmaster/AllergyMaster/DeleteAllergyMaster",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "allergy-list" },
    "GridConfig" :[ {
        "localizationpath" : "clinicalmaster.allergy-list",
        "columnDefs": [ { "field": "DisplayId", "displayName": "Display Id", "name" : "displayid" } ,
                        { "field": "AllergyName", "displayName": "Name", "name" : "allergyname" } ,
                        { "field": "AllergyType.Description", "displayName": "Type", "name" : "type" },
                        { "field": "Description", "displayName": "Description", "name" : "description" },
                        { "field": "ReferrenceLink", "displayName": "Referrence Link", "name" : "referrencelink" },
                        { "field": "StatusTODO", "displayName": "Status", "name" : "status" }
                    ]
        }
    ]
}