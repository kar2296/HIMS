{
    "Title" : "Frequency Form",
    "ControllerName" : "frequencyMasterForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "FrequencyType"}, {"name" : "FrequencySIGCode"} ]
    },
    "FetchAction" : {
        "url" : "clinicalmaster/FrequencyMaster/GetFrequencyMasterById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/FrequencyMaster/AddFrequencyMaster",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/FrequencyMaster/UpdateFrequencyMaster",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.frequencies", "label" : "Frequencies" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "frequency-form" },
	"Panels" : 
    [
        {
            "name" : "frequencymaster",			
            "display" : "Manage Frequency",
            "localizationpath" : "clinicalmaster.frequency-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Frequency Type", "name" : "type", "model" : "item.FrequencyTypeId", "placeholder" : "", "collection" : "lookup.FrequencyType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Code", "name" : "code", "model" : "item.Code", "placeholder" : "" },
                        { "text" : true, "label" : "Name", "name" : "name", "model" : "item.Name", "placeholder" : "" },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" },
                        { "text" : true, "label" : "No Of Times", "name" : "nooftimes", "model" : "item.NoOfTimes", "placeholder" : "" },
                        { "combo" : true, "label" : "SIG Code", "name" : "sigcode", "model" : "item.FrequencySIGCodeId", "placeholder" : "", "collection" : "lookup.FrequencySIGCode", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Start Duration", "name" : "startduration", "model" : "item.StartDuration", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Active", "name" : "isactive", "model" : "item.IsActive", "placeholder" : "" }                        
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [] 
                }
            ]
        }
	]
}