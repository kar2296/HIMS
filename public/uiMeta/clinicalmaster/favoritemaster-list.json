{
    "Title" : "FavoriteMaster List",
    "ControllerName" : "favoriteMasterList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [  {"name" : "Facility"} , {"name" : "FavoriteType"}, {"name" : "ActiveStatus"} ]
    },
    "FilterConfig" :[ {
        "localizationpath" : "clinicalmaster.favoritemaster-list",
        "controls" :[
               { "combo" : true, "label" : "Facility", "name" : "filter_facility", "model" : "currentfilter.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Type", "name" : "filter_favoritetype", "model" : "currentfilter.FavoriteTypeId", "placeholder" : "", "collection" : "lookup.FavoriteType", "valuefield" : "Id", "displayfield" : "Text" },
               { "text" : true, "label" : "Name", "name" : "filter_name", "model" : "currentfilter.Name", "placeholder" : "" },
               { "combo" : true, "label" : "Status", "name" : "filter_status", "model" : "currentfilter.StatusId", "placeholder" : "", "collection" : "lookup.Status", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
        "url" : "clinicalmaster/FavoriteMaster/GetFavoriteMasters",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.favoritemaster",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.favoritemaster",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "clinicalmaster/FavoriteMaster/DeleteFavoriteMaster",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "favoritemaster-list" },
    "GridConfig" :[ {
        "localizationpath" : "clinicalmaster.favoritemaster-list",
        "columnDefs": [ { "field": "Facility.FacilityName", "displayName": "Facility", "name" : "facility" } ,
                        { "field": "Name", "displayName": "Name", "name" : "name" } ,
                        { "field": "FavoriteType.Description", "displayName": "Type", "name" : "type" },
                        { "field": "ActiveStatus.Description", "displayName": "Status", "name" : "status" },
                        { "field": "Department.DepartmentName", "displayName": "Department", "name" : "department" },
                        { "field": "User.FirstName", "displayName": "User", "name" : "user" }
                    ]
        }
    ]
}