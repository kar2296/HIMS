{
    "Title" : "Drugs",
    "ControllerName" : "drugList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "DrugType"}]
    },
    "FilterConfig" :[ {
        "localizationpath" : "clinicalmaster.drug-list",
        "controls" :[
               { "combo" : true, "label" : "Type", "name" : "filter_type", "model" : "currentfilter.DrugTypeId", "placeholder" : "", "collection" : "lookup.DrugType", "valuefield" : "Id", "displayfield" : "Text" },
               { "text" : true, "label" : "Name/Code", "name" : "filter_drugname", "model" : "currentfilter.DrugName", "placeholder" : "" },
               { "combo" : true, "label" : "Status", "name" : "filter_status", "model" : "currentfilter.StatusId", "placeholder" : "", "collection" : "lookup.Status", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
        "url" : "clinicalmaster/DrugMaster/GetDrugMasters",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.drug",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.drug",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "clinicalmaster/DrugMaster/DeleteDrugMaster",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "drug-list" },
    "GridConfig" :[ {
        "localizationpath" : "clinicalmaster.drug-list",
        "columnDefs": [ { "field": "DrugType.Description", "displayName": "Drug Type", "name" : "drugtype" } ,
                        { "field": "DrugCode", "displayName": "Drug Code", "name" : "drugcode" } ,
                        { "field": "DrugName", "displayName": "DrugName", "name" : "drugname" },
                        { "field": "Description", "displayName": "Description", "name" : "description" },
                        { "field": "GenericMaster.GenericName", "displayName": "Generic", "name" : "generic" },
                        { "field": "StatusTODO", "displayName": "Status", "name" : "status" }
                    ]
        }
    ]
}