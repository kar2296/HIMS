{
    "Title" : "Generic Drugs",
    "ControllerName" : "genericForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "clinicalmaster/GenericMaster/GetGenericMasterById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/GenericMaster/AddGenericMaster",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/GenericMaster/UpdateGenericMaster",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.generics", "label" : "Generic Master" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "generic-form" },
	"Panels" : 
    [
        {
            "name" : "details",			
            "display" : "Details",
            "localizationpath" : "clinicalmaster.generic-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Code", "name" : "code", "model" : "item.Code", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Generic Name", "name" : "genericname", "model" : "item.GenericName", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" },                        
                        { "combo" : true, "label" : "Allergen Type", "name" : "allergentype", "model" : "item.AllergenTypeId", "placeholder" : "", "collection" : "lookup.AllergenType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "checkbox" : true, "label" : "Is Active", "name" : "isactive", "model" : "item.IsActive", "placeholder" : ""}                        
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [] 
                }
            ]
        }
	]
}