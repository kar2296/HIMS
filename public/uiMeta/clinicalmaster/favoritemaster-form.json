{
    "Title" : "FavoriteMaster Form",
    "ControllerName" : "favoriteMasterForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "FavoriteType"}, {"name" : "Department"} ,  {"name" : "User"} ]
    },
    "FetchAction" : {
        "url" : "clinicalmaster/FavoriteMaster/GetFavoriteMasterById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/FavoriteMaster/AddFavoriteMaster",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/FavoriteMaster/UpdateFavoriteMaster",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.favoritemasters", "label" : "Favorites" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "favoritemaster-form" },
	"Panels" : 
    [
        {
            "name" : "favoritemaster",			
            "display" : "Favorite",
            "localizationpath" : "clinicalmaster.favoritemaster-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Name", "name" : "name", "model" : "item.Name", "placeholder" : "", "validations":{"required" : true } },
                        { "combo" : true, "label" : "Type", "name" : "type", "model" : "item.FavoriteTypeId", "placeholder" : "", "collection" : "lookup.FavoriteType", "valuefield" : "Id", "displayfield" : "Text", "validations":{"required" : true } },
                        { "checkbox" : true, "label" : "Active", "name" : "isactive", "model" : "item.IsActive", "placeholder" : "" },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" },
                        { "combo" : true, "label" : "Department", "name" : "department", "model" : "item.DepartmentId", "placeholder" : "", "collection" : "lookup.Department", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "User", "name" : "user", "model" : "item.UserId", "placeholder" : "", "collection" : "lookup.User", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Search Items", "name" : "searchitems", "model" : "item.", "placeholder" : "", "collection" : "lookup.", "valuefield" : "Id", "displayfield" : "Text" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [] 
                }
            ]
        }
	]
}