{
    "Title" : "Drug Frequency Form",
    "ControllerName" : "drugFrequencyForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "DrugFrequencyType"}, {"name" : "DrugFrequencySIGCode"} ]
    },
    "FetchAction" : {
        "url" : "clinicalmaster/DrugFrequency/GetDrugFrequencyById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/DrugFrequency/AddDrugFrequency",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/DrugFrequency/UpdateDrugFrequency",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.drugfrequencies", "label" : "Drug Frequency" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "drugfrequency-form" },
	"Panels" : 
    [
        {
            "name" : "drugfrequency",			
            "display" : "Manage Drug Frequency",
            "localizationpath" : "clinicalmaster.drugfrequency-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Frequency Type", "name" : "type", "model" : "item.DrugFrequencyTypeId", "placeholder" : "", "collection" : "lookup.DrugFrequencyType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Code", "name" : "code", "model" : "item.Code", "placeholder" : "" },
                        { "text" : true, "label" : "Name", "name" : "name", "model" : "item.Name", "placeholder" : "" },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" },
                        { "text" : true, "label" : "No Of Times", "name" : "nooftimes", "model" : "item.NoOfTimes", "placeholder" : "" },
                        { "combo" : true, "label" : "SIG Code", "name" : "sigcode", "model" : "item.DrugFrequencySIGCodeId", "placeholder" : "", "collection" : "lookup.DrugFrequencySIGCode", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Start Duration", "name" : "startduration", "model" : "item.StartDuration", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Active", "name" : "isactive", "model" : "item.IsActive", "placeholder" : "" }                        
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [] 
                }
            ]
        }
	]
}