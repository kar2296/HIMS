{
    "Title" : "Procedure",
    "ControllerName" : "procedureList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "ProcedureCodeScheme"},{"name" : "ProcedureType"} ]
    },
    "FilterConfig" :[ {
        "localizationpath" : "clinicalmaster.procedure-list",
        "controls" :[
               { "combo" : true, "label" : "Code Scheme", "name" : "filter_codescheme", "model" : "currentfilter.ProcedureCodeSchemeId", "placeholder" : "", "collection" : "lookup.ProcedureCodeScheme", "valuefield" : "Id", "displayfield" : "Text" },
               { "text" : true, "label" : "Code", "name" : "filter_code", "model" : "currentfilter.Code", "placeholder" : "" },
               { "text" : true, "label" : "Name", "name" : "filter_name", "model" : "currentfilter.ProcedureName", "placeholder" : "" },
               { "combo" : true, "label" : "Procedure Type", "name" : "filter_proceduretype", "model" : "currentfilter.ProcedureTypeId", "placeholder" : "", "collection" : "lookup.ProcedureType", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Status", "name" : "filter_status", "model" : "currentfilter.StatusId", "placeholder" : "", "collection" : "lookup.Status", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
        "url" : "clinicalmaster/procedure/GetProcedures",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.proceduretab.details",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.proceduretab.details",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "clinicalmaster/procedure/DeleteProcedure",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "procedure-list" },
    "GridConfig" :[ {
        "localizationpath" : "clinicalmaster.procedure-list",
        "columnDefs": [ { "field": "Code", "displayName": "Code", "name" : "code" } ,
                        { "field": "ProcedureName", "displayName": "Name", "name" : "name" } , 
                        { "field": "ProcedureVersion.Description", "displayName": "Version", "name" : "version" },
                        { "field": "ProcedureType.Description", "displayName": "Procedure Type", "name" : "proceduretype" },
                        { "field": "ProcedureOperationType.Description", "displayName": "Operation Type", "name" : "operationtype" },
                        { "field": "StatusTODO", "displayName": "Status", "name" : "status" }
                    ]
        }
    ]
}