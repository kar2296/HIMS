{
    "Title" : "Procedure Template",
    "ControllerName" : "procedureTemplateForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "ProcedureTemplateType"}, {"name" : "ProcedureTemplateGroup"},{"name" : "ProcedureTemplateCategory"}]
    },
    "FetchAction" : {
        "url" : "clinicalmaster/ProcedureTemplate/GetProcedureTemplateById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/ProcedureTemplate/AddProcedureTemplate",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/ProcedureTemplate/UpdateProcedureTemplate",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.proceduretab.proceduretemplates", "label" : "Procedure Templates" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "proceduretemplate-form" },
	"Panels" : 
    [
        {
            "name" : "details",			
            "display" : "Details",
            "localizationpath" : "clinicalmaster.proceduretemplate-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Template Type", "name" : "templatetype", "model" : "item.ProcedureTemplateTypeId", "placeholder" : "", "collection" : "lookup.ProcedureTemplateType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Category", "name" : "category", "model" : "item.ProcedureTemplateCategoryId", "placeholder" : "", "collection" : "lookup.ProcedureTemplateCategory", "valuefield" : "Id", "displayfield" : "Text" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Group Name", "name" : "groupname", "model" : "item.ProcedureTemplateGroupId", "placeholder" : "", "collection" : "lookup.ProcedureTemplateGroup", "valuefield" : "Id", "displayfield" : "Text" },                        
                        { "text" : true, "label" : "Display Order", "name" : "displayorder", "model" : "item.DisplayOrder", "placeholder" : ""}
                    ] 
                }
            ]
        }
	]
}