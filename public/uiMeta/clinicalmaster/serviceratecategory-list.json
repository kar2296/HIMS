{
    "Title" : "Service Rate Category List",
    "ControllerName" : "serviceRateCategoryList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [  {"name" : "Facility"} , {"name" : "SourceType"}, {"name" : "ActiveStatus"} ]
    },
    "FilterConfig" :[ {
        "localizationpath" : "clinicalmaster.serviceratecategory-list",
        "controls" :[
               { "combo" : true, "label" : "Facility", "name" : "filter_facility", "model" : "currentfilter.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Source Type", "name" : "filter_sourcetype", "model" : "currentfilter.SourceTypeId", "placeholder" : "", "collection" : "lookup.SourceType", "valuefield" : "Id", "displayfield" : "Text" },
               { "text" : true, "label" : "Name", "name" : "filter_allergyname", "model" : "currentfilter.Name", "placeholder" : "" },
               { "combo" : true, "label" : "Status", "name" : "filter_status", "model" : "currentfilter.StatusId", "placeholder" : "", "collection" : "lookup.Status", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
        "url" : "clinicalmaster/ServiceRateCategory/GetServiceRateCategorys",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.serviceratecategory",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.serviceratecategory",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "clinicalmaster/ServiceRateCategory/DeleteServiceRateCategory",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "serviceratecategory-list" },
    "GridConfig" :[ {
        "localizationpath" : "clinicalmaster.serviceratecategory-list",
        "columnDefs": [ { "field": "Facility.Description", "displayName": "Facility", "name" : "facility" },
                        { "field": "ServiceRateCategory", "displayName": "Service Rate Category", "name" : "serviceratecategory" },
                        { "field": "Percentage", "displayName": "Percentage", "name" : "percentage" },
                        { "field": "IsBasic", "displayName": "Basic Tariff", "name" : "isbasic" },
                        { "field": "IsDefault", "displayName": "Is Default", "name" : "isdefault" },
                        { "field": "EncounterTypeId.Description", "displayName": "Encounter Type", "name" : "encountertype" },
                        { "field": "StatusId.Description", "displayName": "Status", "name" : "status" }
                    ]
        }
    ]
}