{
    "Title" : "Profile User/Department Mapping",
    "ControllerName" : "profileUserList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "Department"},{"name" : "Facility"},{"name" : "User"} ]
    },
    "FilterConfig" :[ {
        "localizationpath" : "clinicalmaster.profileuser-list",
        "controls" :[
                { "combo" : true, "label" : "Facility", "name" : "filter_facility", "model" : "currentfilter.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
                { "combo" : true, "label" : "Department", "name" : "filter_department", "model" : "currentfilter.DepartmentId", "placeholder" : "", "collection" : "lookup.Department", "valuefield" : "Id", "displayfield" : "Text" },
                { "combo" : true, "label" : "User Name", "name" : "filter_user", "model" : "currentfilter.UserId", "placeholder" : "", "collection" : "lookup.User", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
        "url" : "clinicalmaster/ProfileUser/GetProfileUsers",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.profileuser",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.profileuser",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "clinicalmaster/ProfileUser/DeleteProfileUser",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "profileuser-list" },
    "GridConfig" :[ {
        "localizationpath" : "clinicalmaster.profileuser-list",
        "columnDefs": [ { "field": "Facility.FacilityName", "displayName": "Facility", "name" : "facility" },
                        { "field": "Department.DepartmentName", "displayName": "Department", "name" : "department" },
                        { "field": "User.FirstName", "displayName": "User Name", "name" : "user" },
                        { "field": "VisitType.Description", "displayName": "Visit Type", "name" : "visittype" }
                    ]
        }
    ]
}