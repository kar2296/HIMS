{
    "Title" : "Diagnosis Form",
    "ControllerName" : "diagnosisForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "DiagnosisCodeScheme"},{"name" : "DiagnosisVersion"},{"name" : "CodeRegion"},{"name" : "Speciality"},{"name" : "BodySite"}]
    },
    "FetchAction" : {
        "url" : "clinicalmaster/diagnosis/GetDiagnosisById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/diagnosis/AddDiagnosis",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/diagnosis/UpdateDiagnosis",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.diagnosis", "label" : "Diagnosis" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "diagnosis-form" },
	"Panels" : 
    [
        {
            "name" : "diagnosis",			
            "display" : "Diagnosis",
            "localizationpath" : "clinicalmaster.diagnosis-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Code Scheme", "name" : "codescheme", "model" : "item.DiagnosisCodeSchemeId", "placeholder" : "", "collection" : "lookup.DiagnosisCodeScheme", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Code", "name" : "code", "model" : "item.Code", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Name", "name" : "name", "model" : "item.DiagnosisName", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" },
                        { "combo" : true, "label" : "Version", "name" : "version", "model" : "item.DiagnosisVersionId", "placeholder" : "", "collection" : "lookup.DiagnosisVersion", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Code Region", "name" : "coderegion", "model" : "item.CodeRegionId", "placeholder" : "", "collection" : "lookup.CodeRegion", "valuefield" : "Id", "displayfield" : "Text" },
                        { "multitag" : true, "label" : "Speciality", "name" : "speciality", "model" : "item.Speciality", "placeholder" : "", "collection" : "lookup.Speciality", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Synonym", "name" : "synonym", "model" : "item.Synonym", "placeholder" : ""}
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "text" : true, "label" : "Referrence Link", "name" : "referrencelink", "model" : "item.ReferrenceLink", "placeholder" : "" },
                        { "text" : true, "label" : "Length Of Stay", "name" : "lengthofstay", "model" : "item.LengthOfStay", "placeholder" : "" },
                        { "multitag" : true, "label" : "Body Site", "name" : "bodysite", "model" : "item.BodySite", "placeholder" : "", "collection" : "lookup.BodySite", "valuefield" : "Id", "displayfield" : "Text" },
                        { "checkbox" : true, "label" : "Is Active", "name" : "isactive", "model" : "item.IsActive", "placeholder" : ""},
                        { "checkbox" : true, "label" : "Is Notifibale", "name" : "isnotifibale", "model" : "item.IsNotifibale", "placeholder" : ""},
                        { "checkbox" : true, "label" : "Is Sensitive", "name" : "issensitive", "model" : "item.IsSensitive", "placeholder" : ""},
                        { "checkbox" : true, "label" : "Is Billable", "name" : "isbillable", "model" : "item.IsBillable", "placeholder" : ""}                   
                    ]
                }
            ]
        }
	]
}