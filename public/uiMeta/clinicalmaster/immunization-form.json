{
    "Title" : "Immunization",
    "ControllerName" : "immunizationForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
         "optionkeys" : [ {"name" : "Frequency"},{"name" : "Period"},{"name" : "Condition"}]
    },
    "FetchAction" : {
        "url" : "clinicalmaster/Immunization/GetImmunizationById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/Immunization/AddImmunization",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/Immunization/UpdateImmunization",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.immunizations", "label" : "Immunizations" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "immunization-form" },
	"Panels" : 
    [
        {
            "name" : "details",			
            "display" : "Details",
            "localizationpath" : "clinicalmaster.immunization-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Immunization Name", "name" : "immunizationname", "model" : "item.ImmunizationName", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "", "validations":{"required" : true } },                        
                        { "combo" : true, "label" : "Frequency", "name" : "frequency", "model" : "item.FrequencyId", "placeholder" : "", "collection" : "lookup.Frequency", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Duration", "name" : "duration", "model" : "item.Duration", "placeholder" : ""},
                        { "combo" : true, "label" : "Period", "name" : "period", "model" : "item.PeriodId", "placeholder" : "", "collection" : "lookup.Period", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Condition", "name" : "condition", "model" : "item.ConditionId", "placeholder" : "", "collection" : "lookup.Condition", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Referrence Link", "name" : "referrencelink", "model" : "item.ReferrenceLink", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Active", "name" : "isactive", "model" : "item.IsActive", "placeholder" : ""}                        
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [] 
                }
            ]
        }
	]
}