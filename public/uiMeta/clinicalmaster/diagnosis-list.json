{
    "Title" : "Diagnosis",
    "ControllerName" : "diagnosisList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "DiagnosisCodeScheme"},{"name" : "DiagnosisVersion"}]
    },
    "FilterConfig" :[ {
        "localizationpath" : "clinicalmaster.diagnosis-list",
        "controls" :[
               { "combo" : true, "label" : "Code Scheme", "name" : "filter_codescheme", "model" : "currentfilter.DiagnosisCodeSchemeId", "placeholder" : "", "collection" : "lookup.DiagnosisCodeScheme", "valuefield" : "Id", "displayfield" : "Text" },
               { "text" : true, "label" : "Code", "name" : "filter_code", "model" : "currentfilter.Code", "placeholder" : "" },
               { "text" : true, "label" : "Name", "name" : "filter_name", "model" : "currentfilter.DiagnosisName", "placeholder" : "" },
               { "combo" : true, "label" : "Version", "name" : "filter_version", "model" : "currentfilter.DiagnosisVersionId", "placeholder" : "", "collection" : "lookup.DiagnosisVersion", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Status", "name" : "filter_status", "model" : "currentfilter.StatusId", "placeholder" : "", "collection" : "lookup.Status", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
        "url" : "clinicalmaster/diagnosis/GetDiagnosiss",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.diagnosisform",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.diagnosisform",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "clinicalmaster/diagnosis/DeleteDiagnosis",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "diagnosis-list" },
    "GridConfig" :[ {
        "localizationpath" : "clinicalmaster.diagnosis-list",
        "columnDefs": [ { "field": "Code", "displayName": "Code", "name" : "code" } ,
                        { "field": "DiagnosisName", "displayName": "Name", "name" : "name" } ,           
                        { "field": "DiagnosisVersion.Description", "displayName": "Version", "name" : "version" },
                        { "field": "LengthOfStay", "displayName": "Length Of Stay", "name" : "lengthofstay" },
                        { "field": "Speciality", "displayName": "Speciality", "name" : "speciality" },
                        { "field": "StatusTODO", "displayName": "Status", "name" : "status" }
                    ]
        }
    ]
}