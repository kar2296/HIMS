{
    "Title" : "Procedure Form",
    "ControllerName" : "procedureForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "ProcedureCodeScheme"}, {"name" : "ProcedureVersion"},{"name" : "CodeRegion"},{"name" : "Speciality"},{"name" : "Equipment"},{"name" : "BodySite"},
                        {"name" : "ProcedureType"},{"name" : "ProcedureOperationType"},{"name" : "ProcedureCategory"},{"name" : "ProcedureSubCategory"},{"name" : "AnaesthesiaType"}]
    },
    "FetchAction" : {
        "url" : "clinicalmaster/procedure/GetProcedureById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/procedure/AddProcedure",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/procedure/UpdateProcedure",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.procedures", "label" : "Procedures" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "procedure-form" },
	"Panels" : 
    [
        {
            "name" : "details",			
            "display" : "Details",
            "localizationpath" : "clinicalmaster.procedure-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Code Scheme", "name" : "codescheme", "model" : "item.ProcedureCodeSchemeId", "placeholder" : "", "collection" : "lookup.ProcedureCodeScheme", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Code", "name" : "code", "model" : "item.Code", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Name", "name" : "name", "model" : "item.ProcedureName", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" },
                        { "combo" : true, "label" : "Version", "name" : "version", "model" : "item.ProcedureVersionId", "placeholder" : "", "collection" : "lookup.ProcedureVersion", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Code Region", "name" : "coderegion", "model" : "item.CodeRegionId", "placeholder" : "", "collection" : "lookup.CodeRegion", "valuefield" : "Id", "displayfield" : "Text" },
                        { "multitag" : true, "label" : "Speciality", "name" : "speciality", "model" : "item.Speciality", "placeholder" : "", "collection" : "lookup.Speciality", "valuefield" : "Id", "displayfield" : "Text" },
                        { "multitag" : true, "label" : "Equipments", "name" : "equipments", "model" : "item.Equipments", "placeholder" : "", "collection" : "lookup.Equipment", "valuefield" : "Id", "displayfield" : "Text" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "text" : true, "label" : "Referrence Link", "name" : "referrencelink", "model" : "item.ReferrenceLink", "placeholder" : "" },
                        { "multitag" : true, "label" : "Body Site", "name" : "bodysite", "model" : "item.BodySite", "placeholder" : "", "collection" : "lookup.BodySite", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Procedure Type", "name" : "proceduretype", "model" : "item.ProcedureTypeId", "placeholder" : "", "collection" : "lookup.ProcedureType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Procedure Operation Type", "name" : "procedureoperationtype", "model" : "item.ProcedureOperationTypeId", "placeholder" : "", "collection" : "lookup.ProcedureOperationType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Duration (In Hours)", "name" : "duration", "model" : "item.Duration", "placeholder" : "" },
                        { "combo" : true, "label" : "Category", "name" : "category", "model" : "item.ProcedureCategoryId", "placeholder" : "", "collection" : "lookup.ProcedureCategory", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Sub Category", "name" : "subcategory", "model" : "item.ProcedureSubCategoryId", "placeholder" : "", "collection" : "lookup.ProcedureSubCategory", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Anaesthesia Type", "name" : "anaesthesiatype", "model" : "item.AnaesthesiaTypeId", "placeholder" : "", "collection" : "lookup.AnaesthesiaType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "checkbox" : true, "label" : "Is Active", "name" : "isactive", "model" : "item.IsActive", "placeholder" : ""},
                        { "checkbox" : true, "label" : "Is Billable", "name" : "isbillable", "model" : "item.IsBillable", "placeholder" : ""}                   
                    ]
                }
            ]
        }
	]
}