{
    "Title" : "Tick Sheets List",
    "ControllerName" : "tickSheetList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "clinicalmaster/TickSheet/GetTickSheets",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.ticksheet",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.ticksheet",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "clinicalmaster/TickSheet/DeleteTickSheet",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "ticksheet-list" },
    "GridConfig" :[ {
        "localizationpath" : "clinicalmaster.ticksheet-list",
        "columnDefs": [ { "field": "TickSheetType.Description", "displayName": "Type", "name" : "type" },
                        { "field": "TickSheetName", "displayName": "Tick Sheet Name", "name" : "name" } ,
                        { "field": "Department", "displayName": "Department", "name" : "department" } ,
                        { "field": "SubDepartment", "displayName": "Sub Department", "name" : "subdepartment" },
                        { "field": "TestId", "displayName": "Test ID", "name" : "testid" },
                        { "field": "StatusTODO", "displayName": "Status", "name" : "status" }
                    ]
        }
    ]
}