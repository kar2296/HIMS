{
    "Title" : "Dosage Limit",
    "ControllerName" : "dosageLimitForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "Gender"}, {"name" : "DrugAgeGroup"}]
    },
    "FetchAction" : {
        "url" : "clinicalmaster/DosageLimit/GetAllergyMasterById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/DosageLimit/AddDosageLimit",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/DosageLimit/UpdateDosageLimit",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.drugtab.dosagelimits", "label" : "Dosage Limits" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "dosagelimit-form" },
	"Panels" : 
    [
        {
            "name" : "dosagelimit",			
            "display" : "Dosage Limit",
            "localizationpath" : "clinicalmaster.dosagelimit-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Gender", "name" : "gender", "model" : "item.GenderId", "placeholder" : "", "collection" : "lookup.Gender", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Upper Limit", "name" : "upperlimit", "model" : "item.UpperLimit", "placeholder" : ""},                        
                        { "text" : true, "label" : "Maximum Dosage Per Day", "name" : "maxdosageperday", "model" : "item.MaximumDosagePerDay", "placeholder" : ""}
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Age Group", "name" : "agegroup", "model" : "item.DrugAgeGroupId", "placeholder" : "", "collection" : "lookup.DrugAgeGroup", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Lower Limit", "name" : "lowerlimit", "model" : "item.LowerLimit", "placeholder" : ""},                        
                        { "text" : true, "label" : "Body Weight", "name" : "bodyweight", "model" : "item.BodyWeight", "placeholder" : ""}
                    ] 
                }
            ]
        }
	]
}