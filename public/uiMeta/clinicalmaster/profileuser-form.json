{
    "Title" : "Profile User/Department Mapping",
    "ControllerName" : "profileUserForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "Department"}, {"name" : "Facility"} ,  {"name" : "User"} ]
    },
    "FetchAction" : {
        "url" : "clinicalmaster/ProfileUser/GetProfileUserById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/ProfileUser/AddProfileUser",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/ProfileUser/UpdateProfileUser",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.profileusers", "label" : "Profile Users" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "profileuser-form" },
	"Panels" : 
    [
        {
            "name" : "details",			
            "display" : "Details",
            "localizationpath" : "clinicalmaster.profileuser-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Facility", "name" : "facility", "model" : "item.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Department", "name" : "department", "model" : "item.DepartmentId", "placeholder" : "", "collection" : "lookup.Department", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "User Name", "name" : "username", "model" : "item.UserId", "placeholder" : "", "collection" : "lookup.User", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Visit Type", "name" : "visittype", "model" : "item.VisitTypeId", "placeholder" : "", "collection" : "lookup.VisitType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "checkbox" : true, "label" : "Is Default", "name" : "isdefault", "model" : "item.IsDefault", "placeholder" : "" }                        
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [] 
                }
            ]
        }
	]
}