{
    "Title" : "Immunization Master",
    "ControllerName" : "immunizationList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FilterConfig" :[ {
        "localizationpath" : "clinicalmaster.immunization-list",
        "controls" :[
               { "text" : true, "label" : "Name", "name" : "filter_name", "model" : "currentfilter.ImmunizationName", "placeholder" : "" },
               { "combo" : true, "label" : "Status", "name" : "filter_status", "model" : "currentfilter.StatusId", "placeholder" : "", "collection" : "lookup.Status", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
        "url" : "clinicalmaster/Immunization/GetImmunizations",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.immunization",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.immunization",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "clinicalmaster/Immunization/DeleteImmunization",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "immunization-list" },
