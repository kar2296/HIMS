        "localizationpath" : "clinicalmaster.immunization-list",
        "columnDefs": [ { "field": "ImmunizationName", "displayName": "Immunization Name", "name" : "immunizationname" } ,
                        { "field": "Description", "displayName": "Description", "name" : "description" },
                        { "field": "Frequency.Description", "displayName": "Frequency", "name" : "frequency" },
                        { "field": "ReferrenceLink", "displayName": "Referrence Link", "name" : "referrencelink" },
                        { "field": "StatusTODO", "displayName": "Status", "name" : "status" }
                    ]
        }
    ]
}