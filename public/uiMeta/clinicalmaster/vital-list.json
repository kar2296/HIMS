{
    "Title" : "Vital Master",
    "ControllerName" : "vitalList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "VitalValueType"} ]
    },
    "FilterConfig" :[ {
        "localizationpath" : "clinicalmaster.vital-list",
        "controls" :[
               { "text" : true, "label" : "Name", "name" : "filter_name", "model" : "currentfilter.VitalName", "placeholder" : "" },
               { "combo" : true, "label" : "Vital Type", "name" : "filter_vitaltype", "model" : "currentfilter.VitalValueTypeId", "placeholder" : "", "collection" : "lookup.VitalValueType", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Status", "name" : "filter_status", "model" : "currentfilter.StatusId", "placeholder" : "", "collection" : "lookup.Status", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
        "url" : "clinicalmaster/VitalMaster/GetVitalMasters",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.vital",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.vital",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "clinicalmaster/VitalMaster/DeleteVitalMaster",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "vital-list" },
    "GridConfig" :[ {
        "localizationpath" : "clinicalmaster.vital-list",
        "columnDefs": [ { "field": "VitalName", "displayName": "Vital Name", "name" : "vitalname" } ,
                        { "field": "Description", "displayName": "Description", "name" : "description" },
                        { "field": "GraphType.Description", "displayName": "Graph Type", "name" : "graphtype" },
                        { "field": "UOM", "displayName": "UOM", "name" : "uom" },
                        { "field": "LoincCode", "displayName": "LOINC", "name" : "loinc" },
                        { "field": "VitalValueType.Description", "displayName": "Value Type", "name" : "valuetype" },
                        { "field": "ReferenceRangeFrom", "displayName": "Range", "name" : "range" },
                        { "field": "StatusTODO", "displayName": "Status", "name" : "status" }
                    ]
        }
    ]
}