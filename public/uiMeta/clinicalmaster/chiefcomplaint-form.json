{
    "Title" : "Chief Complaint",
    "ControllerName" : "chiefComplaintForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "ChiefComplaintCategory"}, {"name" : "BodySite"}]
    },
    "FetchAction" : {
        "url" : "clinicalmaster/chiefcomplaint/GetChiefComplaintById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/chiefcomplaint/AddChiefComplaint",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/chiefcomplaint/UpdateChiefComplaint",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.chiefcomplaints", "label" : "Chief Complaints" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "chiefcomplaint-form" },
	"Panels" : 
    [
        {
            "name" : "chiefcomplaint",			
            "display" : "Chief Complaint",
            "localizationpath" : "clinicalmaster.chiefcomplaint-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Code", "name" : "code", "model" : "item.Code", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Chief Complaint", "name" : "chiefcomplaint", "model" : "item.ChiefComplaint", "placeholder" : "", "validations":{"required" : true } },
                        { "combo" : true, "label" : "Category Name", "name" : "categoryname", "model" : "item.ChiefComplaintCategoryId", "placeholder" : "", "collection" : "lookup.ChiefComplaintCategory", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "text" : true, "label" : "Referrence Link", "name" : "referrencelink", "model" : "item.ReferrenceLink", "placeholder" : "" },
                        { "multitag" : true, "label" : "Body Site", "name" : "bodysite", "model" : "item.BodySite", "placeholder" : "", "collection" : "lookup.BodySite", "valuefield" : "Id", "displayfield" : "Text" },
                        { "checkbox" : true, "label" : "Is Active", "name" : "isactive", "model" : "item.IsActive", "placeholder" : "", "truevalue": 1, "falsevalue" : 0 }                        
                    ]
                }
            ]
        }
	]
}