{
    "Title" : "Service Item",
    "ControllerName" : "serviceItemForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "Department"}, {"name" : "SubDepartment"} ,  {"name" : "Facility"} ]
    },
    "FetchAction" : {
        "url" : "clinicalmaster/ServiceItem/GetServiceItemById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/ServiceItem/AddServiceItem",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/ServiceItem/UpdateServiceItem",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.serviceitems", "label" : "Service Items" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "serviceitem-form" },
	"Panels" : 
    [
        {
            "name" : "serviceitem",			
            "display" : "Service Item",
            "localizationpath" : "clinicalmaster.serviceitem-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Item Code", "name" : "itemcode", "model" : "item.ItemCode", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Short Code", "name" : "shortcode", "model" : "item.ShortCode", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Item Name", "name" : "itemname", "model" : "item.Name", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" },
                        { "combo" : true, "label" : "Category", "name" : "category", "model" : "item.CategoryId", "placeholder" : "", "collection" : "lookup.ServiceCategory", "valuefield" : "Id", "displayfield" : "Text", "validations":{"required" : true } },
                        { "combo" : true, "label" : "Sub Category", "name" : "subcategory", "model" : "item.SubCategoryId", "placeholder" : "", "collection" : "lookup.ServiceSubCategory", "valuefield" : "Id", "displayfield" : "Text", "validations":{"required" : true } },
                        { "combo" : true, "label" : "Department", "name" : "department", "model" : "item.DepartmentId", "placeholder" : "", "collection" : "lookup.Department", "valuefield" : "Id", "displayfield" : "Text", "validations":{"required" : true } },
                        { "combo" : true, "label" : "Sub Department", "name" : "subdepartment", "model" : "item.SubDepartmentId", "placeholder" : "", "collection" : "lookup.SubDepartment", "valuefield" : "Id", "displayfield" : "Text", "validations":{"required" : true } },
                        { "combo" : true, "label" : "Master Type", "name" : "masterype", "model" : "item.MasterTypeId", "placeholder" : "", "collection" : "lookup.MasterType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Master Item", "name" : "masteritem", "model" : "item.MasterItemId", "placeholder" : "", "collection" : "lookup.MasteItem", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Item Cost", "name" : "itemcost", "model" : "item.ItemCost", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.ActiveFrom", "placeholder" : "", "validations":{"required" : true } },
                        { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.ActiveTo", "placeholder" : "" },
                        { "combo" : true, "label" : "Billing Group", "name" : "billinggroup", "model" : "item.BillingGroupId", "placeholder" : "", "collection" : "lookup.BillingGroup", "valuefield" : "Id", "displayfield" : "Text", "validations":{"required" : true } },
                        { "text" : true, "label" : "Account Code (Credit)", "name" : "acccodecredit", "model" : "item.AccountCodeCredit", "placeholder" : "" },
                        { "text" : true, "label" : "Account Code (Debit)", "name" : "acccodedebit", "model" : "item.AccountCodeDebit", "placeholder" : "" },
                        { "combo" : true, "label" : "Facility", "name" : "facility", "model" : "item.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text", "validations":{"required" : true } },                        
                        { "checkbox" : true, "label" : "Is Orderable", "name" : "isorderable", "model" : "item.IsOrderable", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Rate Editable", "name" : "israteeditable", "model" : "item.IsRateEditable", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Outsourced", "name" : "outsourced", "model" : "item.Outsourced", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Zero Bill", "name" : "iszerobill", "model" : "item.IsZeroBill", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Doctor Mandatory", "name" : "isdoctormandatory", "model" : "item.IsDoctorMandatory", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Surgical Procedure", "name" : "issurgicalprocedure", "model" : "item.IsSurgicalProcedure", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Equipment", "name" : "isequipment", "model" : "item.IsEquipment", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Hour", "name" : "equipmenthour", "model" : "item.IsEquipmentHour", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Daily", "name" : "equipmentdaily", "model" : "item.IsEquipmentDaily", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is BedCharges", "name" : "isbedCharges", "model" : "item.IsBedCharge", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Hour", "name" : "bedchargehour", "model" : "item.IsBedChargeHour", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Daily", "name" : "bedchargedaily", "model" : "item.IsBedChargeDaily", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Calculate GST", "name" : "IsCalculateGST", "model" : "item.IsCalculateGST", "placeholder" : "" }                                                                                            
                    ] 
                }
            ]
        }
	]
}