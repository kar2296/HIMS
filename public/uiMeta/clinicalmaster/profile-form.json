{
    "Title" : "Profile Form",
    "ControllerName" : "profileForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "clinicalmaster/ProfileMaster/GetProfileMasterById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/ProfileMaster/AddProfileMaster",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/ProfileMaster/UpdateProfileMaster",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.profiles", "label" : "Profiles" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "profile-form" },
	"Panels" : 
    [
        {
            "name" : "profile",			
            "display" : "Profile",
            "localizationpath" : "clinicalmaster.profile-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Name", "name" : "name", "model" : "item.Name", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" }                   
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [] 
                }
            ]
        }
	]
}