{
    "Title" : "Manage Drugs",
    "ControllerName" : "drugForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "DrugType"}, {"name" : "Generic"}, {"name" : "DrugTrade"}, {"name" : "DrugForm"},
                         {"name" : "DrugFrequency"}, {"name" : "DrugRoute"}, {"name" : "DrugGroup"}, {"name" : "DrugSubGroup"},
                         {"name" : "AuthenticationLevel"}
                        ]
    },
    "FetchAction" : {
        "url" : "clinicalmaster/DrugMaster/GetDrugMasterById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/DrugMaster/AddDrugMaster",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/DrugMaster/UpdateDrugMaster",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.drugs", "label" : "Drugs" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "drug-form" },
	"Panels" : 
    [
        {
            "name" : "details",			
            "display" : "Details",
            "localizationpath" : "clinicalmaster.drug-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Type", "name" : "type", "model" : "item.DrugTypeId", "placeholder" : "", "collection" : "lookup.DrugType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Code", "name" : "code", "model" : "item.Code", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Name", "name" : "name", "model" : "item.DrugName", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" },
                        { "combo" : true, "label" : "Generic Name", "name" : "genericname", "model" : "item.GenericId", "placeholder" : "", "collection" : "lookup.Generic", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Trade Name", "name" : "tradename", "model" : "item.DrugTradeId", "placeholder" : "", "collection" : "lookup.DrugTrade", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Forms", "name" : "forms", "model" : "item.DrugFormId", "placeholder" : "", "collection" : "lookup.DrugForm", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Frequency", "name" : "frequency", "model" : "item.DrugFrequencyId", "placeholder" : "", "collection" : "lookup.DrugFrequency", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Drug Route", "name" : "drugroute", "model" : "item.DrugRouteId", "placeholder" : "", "collection" : "lookup.DrugRoute", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Max Dosage Per Day", "name" : "maxdosageperday", "model" : "item.MaxDosagePerDay", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Essential Drug", "name" : "essentialdrug", "model" : "item.IsEssentialDrug", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Formulary", "name" : "formulary", "model" : "item.IsFormulary", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                         { "combo" : true, "label" : "Drug Group", "name" : "druggroup", "model" : "item.DrugGroupId", "placeholder" : "", "collection" : "lookup.DrugGroup", "valuefield" : "Id", "displayfield" : "Text" },
                         { "combo" : true, "label" : "Sub Group", "name" : "drugsubgroup", "model" : "item.DrugSubGroupId", "placeholder" : "", "collection" : "lookup.DrugSubGroupId", "valuefield" : "Id", "displayfield" : "Text" },
                         { "checkbox" : true, "label" : "Dosage is not applicable", "name" : "dosagenotapplicable", "model" : "item.IsDosageNotApplicable", "placeholder" : "" },
                         { "checkbox" : true, "label" : "Is Crushable", "name" : "iscrushable", "model" : "item.IsCrushable", "placeholder" : "" },
                         { "checkbox" : true, "label" : "Special Approval required", "name" : "specialapprovalrequired", "model" : "item.IsSpecialApprovalRequired", "placeholder" : "" },
                         { "checkbox" : true, "label" : "Not Use for IP", "name" : "notuserforip", "model" : "item.IsNotUseForIP", "placeholder" : "" },
                         { "checkbox" : true, "label" : "Drug Database Alert", "name" : "drugdatabasealert", "model" : "item.IsDrugDatabaseAlert", "placeholder" : "" },
                         { "checkbox" : true, "label" : "Allow to Order", "name" : "allowtoorder", "model" : "item.IsAllowToOrder", "placeholder" : "" },
                         { "checkbox" : true, "label" : "Order Without Prescription", "name" : "orderwithoutprescription", "model" : "item.IsOrderWithoutPrescription", "placeholder" : "" },
                         { "combo" : true, "label" : "Authentication Level", "name" : "authenticationlevel", "model" : "item.AuthenticationLevelId", "placeholder" : "", "collection" : "lookup.AuthenticationLevel", "valuefield" : "Id", "displayfield" : "Text" },
                         { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.ActiveFrom", "placeholder" : "" },
                         { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.ActiveTo", "placeholder" : "" }
                    ] 
                }
            ]
        }
	]
}