{
    "Title" : "Vital",
    "ControllerName" : "vitalForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
         "optionkeys" : [ {"name" : "GraphType"},{"name" : "VitalValueType"}]
    },
    "FetchAction" : {
        "url" : "clinicalmaster/VitalMaster/GetVitalMasterById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/VitalMaster/AddVitalMaster",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/VitalMaster/UpdateVitalMaster",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.vitals", "label" : "Vital" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "vital-form" },
	"Panels" : 
    [
        {
            "name" : "details",			
            "display" : "Details",
            "localizationpath" : "clinicalmaster.vital-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "text" : true, "label" : "Vital Name", "name" : "vitalname", "model" : "item.VitalName", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "UOM", "name" : "uom", "model" : "item.UOM", "placeholder" : "", "validations":{"required" : true } },                        
                        { "combo" : true, "label" : "Graph Type", "name" : "graphtype", "model" : "item.GraphTypeId", "placeholder" : "", "collection" : "lookup.GraphType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Vital Value Type", "name" : "vitalvaluetype", "model" : "item.VitalValueTypeId", "placeholder" : "", "collection" : "lookup.VitalValueType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "LOINC Code", "name" : "loinccode", "model" : "item.LoincCode", "placeholder" : ""},
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" },
                        { "text" : true, "label" : "Referrence Link", "name" : "referrencelink", "model" : "item.ReferrenceLink", "placeholder" : "" },
                        { "text" : true, "label" : "Value Format", "name" : "valueformat", "model" : "item.ValueFormat", "placeholder" : "" },
                        { "text" : true, "label" : "ReferenceRangeFrom", "name" : "referencerangefrom", "model" : "item.ReferenceRangeFrom", "placeholder" : "" },
                        { "text" : true, "label" : "ReferenceRangeTo", "name" : "referencerangeto", "model" : "item.ReferenceRangeTo", "placeholder" : "" },
                        { "text" : true, "label" : "Mnemonic", "name" : "mnemonic", "model" : "item.Mnemonic", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Active", "name" : "isactive", "model" : "item.IsActive", "placeholder" : ""}                        
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [] 
                }
            ]
        }
	]
}