{
    "Title" : "Frequency Category Form",
    "ControllerName" : "frequencyCategoryForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "FrequencyCategory"} ]
    },
    "FetchAction" : {
        "url" : "clinicalmaster/FrequencyCategory/GetFrequencyCategoryById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/FrequencyCategory/AddFrequencyCategory",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/FrequencyCategory/UpdateFrequencyCategory",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.frequencycategories", "label" : "Frequency Category" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "frequencycategory-form" },
	"Panels" : 
    [
        {
            "name" : "frequencycategory",			
            "display" : "Manage Frequency Category",
            "localizationpath" : "clinicalmaster.frequencycategory-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Category", "name" : "category", "model" : "item.ClinicalFrequencyCategoryId", "placeholder" : "", "collection" : "lookup.ClinicalFrequencyCategory", "valuefield" : "Id", "displayfield" : "Text" },
                        { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.ActiveFrom", "placeholder" : "" },
                        { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.ActiveTo", "placeholder" : "" }                        
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [] 
                }
            ]
        }
	]
}