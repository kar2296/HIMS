{
    "Title" : "Drug Alert",
    "ControllerName" : "drugAlertForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "DrugAlertType"}, {"name" : "DrugAgeGroup"}]
    },
    "FetchAction" : {
        "url" : "clinicalmaster/DrugAlert/GetDrugAlertById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/DrugAlert/AddDrugAlert",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/DrugAlert/UpdateDrugAlert",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.drugtab.drugalerts", "label" : "Drug Alerts" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "drugalert-form" },
	"Panels" : 
    [
        {
            "name" : "drugalert",			
            "display" : "Drug Alert",
            "localizationpath" : "clinicalmaster.drugalert-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Alert Type", "name" : "alerttype", "model" : "item.DrugAlertTypeId", "placeholder" : "", "collection" : "lookup.DrugAlertType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Min Value", "name" : "minvalue", "model" : "item.AlertMinValue", "placeholder" : ""},                        
                        { "text" : true, "label" : "Max Value", "name" : "maxvalue", "model" : "item.AlertMaxValue", "placeholder" : ""},
                        { "combo" : true, "label" : "Age Group", "name" : "agegroup", "model" : "item.DrugAgeGroupId", "placeholder" : "", "collection" : "lookup.DrugAgeGroup", "valuefield" : "Id", "displayfield" : "Text" }                     
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "text" : true, "label" : "Alerts", "name" : "alerts", "model" : "item.Alerts", "placeholder" : ""}                    
                    ] 
                }
            ]
        }
	]
}