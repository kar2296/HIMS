{
    "Title" : "Service Items",
    "ControllerName" : "serviceItemList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "Department"},{"name" : "SubDepartment"} ]
    },
    "FilterConfig" :[ {
        "localizationpath" : "clinicalmaster.serviceitem-list",
        "controls" :[               
               { "text" : true, "label" : "Code", "name" : "filter_code", "model" : "currentfilter.Code", "placeholder" : "" },
               { "text" : true, "label" : "Name", "name" : "filter_name", "model" : "currentfilter.ProcedureName", "placeholder" : "" },
               { "combo" : true, "label" : "Department", "name" : "filter_department", "model" : "currentfilter.DepartmentId", "placeholder" : "", "collection" : "lookup.Department", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Sub Department", "name" : "filter_subdepartment", "model" : "currentfilter.SubDepartmentId", "placeholder" : "", "collection" : "lookup.SubDepartment", "valuefield" : "Id", "displayfield" : "Text" },
               { "combo" : true, "label" : "Status", "name" : "filter_status", "model" : "currentfilter.StatusId", "placeholder" : "", "collection" : "lookup.Status", "valuefield" : "Id", "displayfield" : "Text" }
         ]
        }
    ],
    "FetchAction" : {
        "url" : "clinicalmaster/serviceitem/GetServiceItems",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.serviceitem",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.serviceitem",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "clinicalmaster/serviceitem/DeleteServiceItem",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "serviceitem-list" },
    "GridConfig" :[ {
        "localizationpath" : "clinicalmaster.serviceitem-list",
        "columnDefs": [ { "field": "ItemCode", "displayName": "Item Code", "name" : "itemcode" } ,
                        { "field": "Name", "displayName": "Item Name", "name" : "itemname" } , 
                        { "field": "Department.Description", "displayName": "Department", "name" : "department" },
                        { "field": "SubDepartment.Description", "displayName": "Sub Department", "name" : "subdepartment" },                        
                        { "field": "StatusTODO", "displayName": "Status", "name" : "status" }
                    ]
        }
    ]
}