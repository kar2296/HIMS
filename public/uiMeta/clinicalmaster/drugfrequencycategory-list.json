{
    "Title" : "Drug Frequency Category List",
    "ControllerName" : "drugFrequencyCategoryList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [  {"name" : "Facility"} , {"name" : "DrugFrequencyType"}, {"name" : "ActiveStatus"} ]
    },
    "FetchAction" : {
        "url" : "clinicalmaster/DrugFrequencyCategory/GetDrugFrequencyCategorys",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.drugfrequencycategory",
                "params": ["id:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.drugfrequencycategory",
        "params": ["id:0"]
        },
    "DeleteAction" : {
        "url": "clinicalmaster/DrugFrequencyCategory/DeleteDrugFrequencyCategory",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "drugfrequencycategory-list" },
    "GridConfig" :[ {
        "localizationpath" : "clinicalmaster.drugfrequencycategory-list",
        "columnDefs": [ { "field": "FrequencyCategory.Description", "displayName": "Category", "name" : "category" },
                        { "field": "ActiveFrom", "displayName": "Active From", "name" : "activefrom" },
                        { "field": "ActiveTo", "displayName": "Active To", "name" : "activeto" },
                        { "field": "StatusTODO", "displayName": "Status", "name" : "status" }
                    ]
        }
    ]
}