{
    "Title" : "Service Rate Category Form",
    "ControllerName" : "serviceRateCategoryForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "EncounterType"}, {"name" : "PrimaryCategory"}, {"name" : "Facility"} ]
    },
    "FetchAction" : {
        "url" : "clinicalmaster/ServiceRateCategory/GetServiceRateCategoryById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "clinicalmaster/ServiceRateCategory/AddServiceRateCategory",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "clinicalmaster/ServiceRateCategory/UpdateServiceRateCategory",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.serviceratecategories", "label" : "Service Rate Categories" },
    "Localization" : { "localizationmodule" : "clinicalmaster", "screenkey" : "serviceratecategory-form" },
	"Panels" : 
    [
        {
            "name" : "serviceratecategory",			
            "display" : "",
            "localizationpath" : "clinicalmaster.serviceratecategory-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Facility", "name" : "facility", "model" : "item.FacilityId", "placeholder" : "", "collection" : "lookup.Facility", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Service Rate Category", "name" : "serviceratecategory", "model" : "item.ServiceRateCategory", "placeholder" : "" },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" },
                        { "combo" : true, "label" : "Encounter Type", "name" : "encountertype", "model" : "item.EncounterTypeId", "placeholder" : "", "collection" : "lookup.FrequencyType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Primary Category", "name" : "primarycategory", "model" : "item.PrimaryCategoryId", "placeholder" : "", "collection" : "lookup.FrequencyType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Percentage", "name" : "percentage", "model" : "item.Percentage", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is Basic", "name" : "isbasic", "model" : "item.IsBasic", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Is default", "name" : "isdefault", "model" : "item.IsDefault", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Status", "name" : "status", "model" : "item.StatusId", "placeholder" : "" }                        
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [] 
                }
            ]
        }
	]
}