{
    "Title" : "Record Death",
    "ControllerName" : "patientDeathForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "DeathType"}, {"name" : "DeathPlace"},{"name" : "Doctor"}]
    },
    "FetchAction" : {
        "url" : "registration/patient/GetPatientById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "registration/patient/UpdatePatient",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "registration/patient/UpdatePatient",
        "behaviour" : "default"
    },
    "ParentScreen" : {},
    "Localization" : { "localizationmodule" : "registration", "screenkey" : "patientdeathrecord-form" },
	"Panels" : 
    [
        {
            "name" : "details",			
            "display" : "Details",
            "localizationpath" : "registration.patientdeathrecord-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "date" : true, "label" : "Date Of Death", "name" : "dateofdeath", "model" : "item.DeathDate", "placeholder" : "", "validations":{"required" : true } },
                        { "combo" : true, "label" : "Decease Type", "name" : "deceasetype", "model" : "item.DeathTypeId", "placeholder" : "", "collection" : "lookup.DeathType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Place Of Death", "name" : "placeofdeath", "model" : "item.DeathPlaceId", "placeholder" : "", "collection" : "lookup.DeathPlace", "valuefield" : "Id", "displayfield" : "Text" },
                        { "checkbox" : true, "label" : "Is Confirmed", "name" : "isconfirmed", "model" : "item.IsDeathConfirmed", "placeholder" : "", "validations":{"required" : true }},
                        { "combo" : true, "label" : "Confirmed By", "name" : "confirmedby", "model" : "item.DeathConfirmedBy", "placeholder" : "", "collection" : "lookup.Doctor", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Comments", "name" : "deathcomments", "model" : "item.DeathComents", "placeholder" : "" },
                        { "text" : true, "label" : "Description", "name" : "description", "model" : "item.Description", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" : [] }
            ]
        }
	]
}