{
    "Title" : "Patient ID List",
    "ControllerName" : "patientidentityList",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "PatientIdentityType"} ]
    },
    "FilterConfig" :null,
    "FetchAction" : {
        "url" : "registration/PatientIdentity/GetPatientIdentitys",
        "behaviour" : "default"
    },
    "EditAction" : {
                "url": "",
                "state": "app.fullregistrationtab.patientidentity",
                "params": ["patientidentityid:row.entity.Id"]
                },
    "AddAction" : {
        "url": "",
        "state": "app.fullregistrationtab.patientidentity",
        "params": ["patientidentityid:0"]
        },
    "DeleteAction" : {
        "url": "registration/PatientIdentity/DeletePatientIdentity",
        "behaviour" : "default"
    },
    "Localization" : { "localizationmodule" : "registration", "screenkey" : "patientidentity-list" },
    "GridConfig" :[ {
        "localizationpath" : "registration.patientidentity-list",
        "columnDefs": [ { "field": "PatientIdentityType.Description", "displayName": "Type", "name" : "type" } ,
                        { "field": "IDNumber", "displayName": "ID Number", "name" : "idnumber" } , 
                        { "field": "Comments", "displayName": "Comments", "name" : "comments" }
                    ]
        }
    ]
}