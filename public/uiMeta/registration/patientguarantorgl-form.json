{
    "Title" : "GL Details Form",
    "ControllerName" : "patientGuarantorGLForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : []
    },
    "FetchAction" : {
        "url" : "registration/patientguarantorgl/GetPatientGuarantorGLById",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "registration/patientguarantorgl/AddPatientGuarantorGL",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "registration/patientguarantorgl/UpdatePatientGuarantorGL",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.registration.details", "label" : "Patient Guarantor" },
    "Localization" : { "localizationmodule" : "registration", "screenkey" : "patientguarantorgl-form" },
	"Panels" : 
    [
        {
            "name" : "details",			
            "display" : "Details",
            "localizationpath" : "registration.patientguarantorgl-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [                        
                        { "text" : true, "label" : "GL Ref No", "name" : "glrefno", "model" : "item.GLReferenceNumber", "placeholder" : "", "validations":{"required" : true } },
                        { "date" : true, "label" : "GL Date", "name" : "gldate", "model" : "item.GLDate", "placeholder" : "", "validations":{"required" : true } },
                        { "text" : true, "label" : "Max No Of Days", "name" : "maxnoofdays", "model" : "item.MaxNoOfdays", "placeholder" : "" },
                        { "text" : true, "label" : "Current Visit No", "name" : "currentvisitno", "model" : "item.CurrentVisitNumber", "placeholder" : "" },
                        { "text" : true, "label" : "Maximum Visit No", "name" : "maximumvisitno", "model" : "item.MaximumVisitNumber", "placeholder" : "" },
                        { "text" : true, "label" : "Duration Of Medicine Covered", "name" : "durationofmedicinecovered", "model" : "item.DurationMedicine", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" :
                    [
                        { "text" : true, "label" : "Limit", "name" : "limit", "model" : "item.GLLimit", "placeholder" : "" },
                        { "text" : true, "label" : "Consumed", "name" : "consumed", "model" : "item.ConsumedLimit", "placeholder" : "" },
                        { "text" : true, "label" : "Balance", "name" : "balance", "model" : "item.BalanceLimit", "placeholder" : "" },
                        { "text" : true, "label" : "R & B", "name" : "randb", "model" : "item.RandB", "placeholder" : "" },
                        { "date" : true, "label" : "Active From", "name" : "activefrom", "model" : "item.ActiveFrom", "placeholder" : "", "validations":{"required" : true } },
                        { "date" : true, "label" : "Active To", "name" : "activeto", "model" : "item.ActiveTo", "placeholder" : "", "validations":{"required" : true } }
                    ]
                }
            ]
        }
	]
}