{
    "Title" : "Next Of Kin",
    "ControllerName" : "patientkinForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default",
        "optionkeys" : [ {"name" : "Relationship"}, {"name" : "Title"}, {"name" : "Gender"},
                        {"name" : "BloodGroup"}, {"name" : "Relationship"}, {"name" : "Relationship"} ]
    },
    "FetchAction" : {
        "url" : "registration/patientkin/GetPatientKins",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "registration/patientkin/AddPatientKin",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "registration/patientkin/UpdatePatient",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "app.fullregistrationtab.patientkins", "label" : "Patient Kins" },
    "Localization" : { "localizationmodule" : "registration", "screenkey" : "patientkin-form" },
	"Panels" : 
    [
        {
            "name" : "patientkin",			
            "display" : "Next Of Kin",
            "localizationpath" : "registration.patientkin-form",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Relationship", "name" : "relationship", "model" : "item.RelationshipId", "placeholder" : "", "collection" : "lookup.Relationship", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Title", "name" : "title", "model" : "item.TitleId", "placeholder" : "", "collection" : "lookup.Title", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Gender", "name" : "gender", "model" : "item.GenderId", "placeholder" : "", "collection" : "lookup.Gender", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Name", "name" : "name", "model" : "item.Name", "placeholder" : "" },
                        { "text" : true, "label" : "Age", "name" : "age", "model" : "item.Age", "placeholder" : "" },
                        { "date" : true, "label" : "DOB", "name" : "dob", "model" : "item.DOB", "placeholder" : "" },
                        { "text" : true, "label" : "Land Line", "name" : "landline", "model" : "item.LandLine", "placeholder" : "" },
                        { "text" : true, "label" : "Mobile", "name" : "mobile", "model" : "item.Mobile", "placeholder" : "" },
                        { "combo" : true, "label" : "Blood Group", "name" : "bloodgroup", "model" : "item.BloodGroupId", "placeholder" : "", "collection" : "lookup.BloodGroup", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Comments", "name" : "comments", "model" : "item.Comments", "placeholder" : "" }
                    ]
                },
                { "name" : "rightpanel", "controls" : 
                    [
                        { "checkbox" : true, "label" : "Same Address", "name" : "sameaddress", "model" : "item.SameAddress", "placeholder" : "" },
                        { "text" : true, "label" : "Address Line 1", "name" : "addressline1", "model" : "item.AddressLine1", "placeholder" : "" },
                        { "text" : true, "label" : "Address Line 2", "name" : "addressline2", "model" : "item.AddressLine2", "placeholder" : "" },
                        { "combo" : true, "label" : "Pincode", "name" : "pincode", "model" : "item.PinCodeId", "placeholder" : "", "collection" : "lookup.Pincode", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Area", "name" : "area", "model" : "item.Area", "placeholder" : "" },
                        { "combo" : true, "label" : "City", "name" : "city", "model" : "item.CityId", "placeholder" : "", "collection" : "lookup.City", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "State", "name" : "state", "model" : "item.StateId", "placeholder" : "", "collection" : "lookup.State", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Country", "name" : "country", "model" : "item.CountryId", "placeholder" : "", "collection" : "lookup.Country", "valuefield" : "Id", "displayfield" : "Text" }
                    ] 
                }
            ]
        }
	]
}