{
    "Title" : "My Home Page",
    "ControllerName" : "quickRegistrationForm",
    "InitAction" : {
        "url" : "General/Options/getoptions",
        "behaviour" : "default"
    },
    "FetchAction" : {
        "url" : "registration/patient/GetPatients",
        "behaviour" : "default"
    },
    "AddAction" : {
        "url" : "registration/patient/AddPatient",
        "behaviour" : "default"
    },
    "UpdateAction" : {
        "url" : "registration/module/UpdatePatient",
        "behaviour" : "default"
    },
    "ParentScreen" : { "state" : "base.patientsearch", "label" : "Patient Search" },
    "Localization" : { "localizationmodule" : "i18n.registration", "screenkey" : "quickregistration" },
	"Panels" : 
    [
        {
            "name" : "quickregistration",			
            "display" : "Quick Registration",
            "localizationpath" : "i18n.registration.quickregistration",
            "layouts" : 
            [
                { "name" : "leftpanel", "controls" :
                    [
                        { "combo" : true, "label" : "Tittle", "name" : "tittle", "model" : "item.TitleId", "placeholder" : "", "collection" : "lookup.Title", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Patient Name", "name" : "patientname", "model" : "item.FirstName", "placeholder" : "" },
                        { "text" : true, "label" : "Age", "name" : "age", "model" : "item.Age", "placeholder" : "" },
                        { "date" : true, "label" : "DOB", "name" : "dob", "model" : "item.DOB", "placeholder" : "" },
                        { "combo" : true, "label" : "Marital Status", "name" : "maritalstatus", "model" : "item.MaritalStatusId", "placeholder" : "", "collection" : "lookup.MaritalStatus", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Religion", "name" : "religion", "model" : "item.ReligionId", "placeholder" : "", "collection" : "lookup.Religion", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Nationality", "name" : "nationality", "model" : "item.NationalityId", "placeholder" : "", "collection" : "lookup.Nationality", "valuefield" : "Id", "displayfield" : "Text" },
                        { "text" : true, "label" : "Nationality ID", "name" : "nationalityid", "model" : "item.NationalityIdentifier", "placeholder" : "" },
                        { "combo" : true, "label" : "Preferred Language", "name" : "preferredlanguage", "model" : "item.PreferredLanguageId", "placeholder" : "", "collection" : "lookup.Language", "valuefield" : "Id", "displayfield" : "Text" },
                        { "checkbox" : true, "label" : "Is Vip", "name" : "isvip", "model" : "item.IsVip", "placeholder" : "" },
                        { "combo" : true, "label" : "VIP Type", "name" : "viptype", "model" : "item.VipTypeId", "placeholder" : "", "collection" : "lookup.VipType", "valuefield" : "Id", "displayfield" : "Text" },
                        { "combo" : true, "label" : "Patient Type", "name" : "patienttype", "model" : "item.PatientTypeId", "placeholder" : "", "collection" : "lookup.PatientType", "valuefield" : "Id", "displayfield" : "Text" }
                    ]
                },
                { "name" : "rightpanel", "controls" : 
                    [
                        { "text" : true, "label" : "Address Line 1", "name" : "addressline1", "model" : "item.AddressLine1", "placeholder" : "" },
                        { "text" : true, "label" : "Address Line 2", "name" : "addressline2", "model" : "item.AddressLine2", "placeholder" : "" },
                        { "text" : true, "label" : "Pin Code", "name" : "pincode", "model" : "item.PinCode", "placeholder" : "" },
                        { "text" : true, "label" : "Area", "name" : "area", "model" : "item.Area", "placeholder" : "" },
                        { "text" : true, "label" : "City/Town", "name" : "citytown", "model" : "item.City", "placeholder" : "" },
                        { "text" : true, "label" : "State", "name" : "state", "model" : "item.State", "placeholder" : "" },
                        { "text" : true, "label" : "Country", "name" : "country", "model" : "item.Country", "placeholder" : "" },
                        { "text" : true, "label" : "Land Line", "name" : "landline", "model" : "item.LandLine", "placeholder" : "" },
                        { "text" : true, "label" : "Mobile", "name" : "mobile", "model" : "item.Mobile", "placeholder" : "" },
                        { "text" : true, "label" : "Email", "name" : "email", "model" : "item.Email", "placeholder" : "" },
                        { "checkbox" : true, "label" : "SMS", "name" : "sms", "model" : "item.IsSmsCommunicationPreference", "placeholder" : "" },
                        { "checkbox" : true, "label" : "Email", "name" : "comnemail", "model" : "item.IsEmailCommunicationPreference", "placeholder" : "" },
                        { "checkbox" : true, "label" : "MRD Request", "name" : "mrdrequest", "model" : "item.IsMRDRequest", "placeholder" : "" }

                    ] 
                }
            ]
        }
	]
}